<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="3">

  <Content>
    <Paragraph Number="1" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>CRACKED REARVIEW MIRROR</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">reflects</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">upside</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">-</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">down</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">speedway</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">A</Text>
      <Text>sphalt sky</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> sucks in smoke. 
A BLACK INDYCAR lies crushed against a barrier.</Text>
    </Paragraph>
    <Paragraph Number="2" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>REVERSE ON</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">the</Text>
      <Text> eyes of RAY SPEAR visible through smashed helmet.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>A gash above right eye sucks in pulses of blood.</Text>
    </Paragraph>
    <Paragraph Number="3" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="1" Title="">
        <Summary>
          <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
            <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">The racecar catches fire.</Text>
          </Paragraph>
        </Summary>
        <SceneArcBeats/>
      </SceneProperties>
      <Text>REARVIEW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A SAFETY TEAM push</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">es</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">BURNT </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">RACING DRIVER </Text>
      <Text>into the cockpit. A </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">NOZZLEMAN</Text>
      <Text> sucks lashes of water from the car</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Driver</Text>
      <Text> catches fire. The water is cut off, and the Safety Team </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">run</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Underline">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline"> backwards</Text>
      <Text> from the scene, abandoning </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">m</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Number="4" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">hanging</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">by his</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">seatbelt</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">B</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">lood</Text>
      <Text> float</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text> up to his forehead. Glass </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">stirs...</Text>
      <Text> gain</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text> momentum. </Text>
    </Paragraph>
    <Paragraph Number="5" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>REARVIEW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Flames implode into the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Black Indycar's engine. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">T</Text>
      <Text>he fire </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">clears and t</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">he Driver</Text>
      <Text> struggles with his </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">seatbelt</Text>
      <Text>. Atomized fragments fly into the crumpled front-wing, which </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">self-</Text>
      <Text>reassembles</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> as-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Cracks in our mirror-view heal</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. T</Text>
      <Text>he scene rotates.</Text>
    </Paragraph>
    <Paragraph Number="6" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Head smashing off </Text>
      <Text>cockpit</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> rim</Text>
      <Text>, mending his visor. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">The</Text>
      <Text> world rotates RIGHT WAY </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">UP</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Tires</Text>
      <Text> mak</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">e</Text>
      <Text> contact with asphalt</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Wheel rims </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">un</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">-</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">explode</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> and reassemble</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray SWERVES away from the Black Indycar... </Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Number="8" Type="Scene Heading">
      <SceneProperties Length="4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="NEWSCASTER"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. MUSTANG -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">RAY wakes with a start.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">sits in</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> the driver's seat of a Mustang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> that is </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Underline">violently shaking</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A hand touches his - his </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">punkish</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> daughter LORY (17) sits in the passenger seat.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">It's OK - just an aftershock.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The shaking begins to ease... and stop. Car alarms sound. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Out the windshield, Ray can see f</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">our lanes of bumper-to-bumper </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">freeway </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">gridlock.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> He tweaks the radio volume.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">NEWSCASTER (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">...disruption</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic"> on the 101, the 405, the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">I-10</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">, with reports of cracks and structural damage and a collapsed bridge in Eagle Rock. The massive 7.4 shaker has also caused power cuts in San Bernardino...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">A CHIHUAHUA stares out the back window of the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Subaru</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> Forester in front. Trapped just like Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray opens the door and steps out.</Text>
    </Paragraph>
    <Paragraph Number="9" Type="Scene Heading">
      <SceneProperties Length="1 7/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEB"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
          <CharacterArcBeat Name="TRUCKER"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold+AllCaps">EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">As soon as Ray's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">right </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">foot finds the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">asphalt</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">shot of pain run</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> up his knee</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> - h</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">e gasps</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, bends to knead</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">it out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">straightens up and locks eyes</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> with the driver of the BLACK DODGE RAM behind the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">m</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. A SKINNY GUY behind wheel. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">They exchange a nod. Ray turns away and takes out his cell.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Both </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">vehicles</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> are in outer lane of a </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">flyover</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">hugging a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> barrier. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">An</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">18-WHEELER</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> TRACTOR TRAILER </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">shadows them from the adjacent lane.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ray dials and moves towards a distant smoke-stack from a crash ahead. No </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">turn-offs</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, no </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">drive-thrus</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, no gas stations. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Asphalt and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Underline">HEAT</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">The call is answered.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">I've been trying to reach you-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">-and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic"> I was trying to reach you. The network must be down. You guys OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">In one piece. What about the hearing? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">Everyone else is here. No reason we can't still go ahead if-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">If I make it? No chance. Freeway's a parking lot. And we're on a </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">flyover</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ray glances over the barrier; a hundred-foot drop. Beyond, the downtown skyline is so far away it could be a matte painting. Fires in the distance.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <ScriptNote Author="" Color="#000000000000" DateModified="20260725T174904" DateTime="20260725T174846" Name="note for AI" Type="">
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">This is where I made something dual-dialoge.</Text>
        </Paragraph>
      </ScriptNote>
      <DualDialogue>
        <Paragraph Type="Character">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">DEB (O.S.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">I'</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">ll</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic"> try for a delay-</Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> (cont'd</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">What about the settlement offer?</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">DEB (O.S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">They turned it down.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The latest one?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">The latest one.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">A man walks past </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">from the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">crash direction</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">. </Text>
      <Text>Ten-gallon hat, shades, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">black gloves. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">H</Text>
      <Text>eavy toolbox</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> in one hand</Text>
      <Text>, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">phone in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">the other</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> We'll come to know him as NED BOOLES.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">DEB (O.S.)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">I think the family are open but Eva wants her day in court.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Delay. Buys us more time to settle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">I'll do my best.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The call ends. Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">wades back</Text>
      <Text> to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> sees Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> come around the back of the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">18-wheeler</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> and get in the back passenger seat of the Dodge Ram behind them.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The Skinny Guy </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">cranes his head to interact with Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> as if surprised.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">TRUCKER (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Looks like we'll be here a while.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray looks up</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">:</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">TRUCKER (</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">60s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> - </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">tough-looking older woman</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> LOCAL 630 cap</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> reading a paperback.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">TRUCKER</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Shame we get paid by the mile, not the hour. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray makes conversation</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, angling to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">observe the Dodge.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Hard to see through </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">the tint</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ed</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">glass and shade.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Least you got something to read. Any good?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Crime novel. Jim Thompson. Depends on how dark you like your coffee.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Pitch black.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Trucker tilts the cover: "POP. 1280". Ray raises a hand </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">- </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">appreciation, and adieu. He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">heads back</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> Mustang.</Text>
    </Paragraph>
    <Paragraph Number="39" Type="Scene Heading">
      <SceneProperties Length="4 6/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALICE"></CharacterArcBeat>
          <CharacterArcBeat Name="EMERGENCY OPERATOR"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="POLICE OPERATOR"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
          <CharacterArcBeat Name="SINGER"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray slinks back inside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Deb is trying to reschedule the arbitration.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">They can't run it without you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> - I mean, it was a goddamn earthquake.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">I don't know how these things work.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Why are they pushing this?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">His wife Eva feels she has a grievance. And it's her right to pursue.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW: Skinny Man </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">watches </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">him. Ned is a silhouette in the back seat. An uncanny stillness.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">You didn't mean to hit him, right? That's what they're saying.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">No. Of course not. He was like a kid brother to me. Six years on the same team, until he changed suits.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sirens and blue lights appear behind them.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> Ray observes Lory tense up and sink into her seat. Looks in the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">:</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> as LAPD motorcycle </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">officer</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> CARRIS (30s) filters through traffic on her LAPD-issue Harley</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">eyes</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> drift to the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> Skinny Guy</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">tock still, neck straight, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">watch</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> the cop </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">pass. He doesn't seek her attention. Ned a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">silhouett</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">e in the back.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray observe</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">monitoring</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> the motorcycle </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">as it </Text>
      <Text>pass</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">es</Text>
      <Text> by </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">her</Text>
      <Text> window... and keep</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text> on going. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">She breathes out in relief... </Text>
      <Text>until she realizes Ray is staring at her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You've been made. Give it up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Give up what?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> yanks her bag from her and searches</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">C</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">heap </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">phone, cigarettes, condoms</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... a</Text>
      <Text> rose-embroidered SWITCHBLADE</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Push-button - t</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">he blade slices open.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray</Text>
      <Text> folds </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">it and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
      <Text>puts it in the glove box.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You've seen the crew I roll with.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Spend time with boys you trust.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where'd be the fun in that?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">He</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> checks her jacket pockets. Finds something. Lory's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">demeanor</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> shifts</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> baggie of white powde</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">r comes out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">It's not mine-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Don't give me that bullshit.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">pockets the baggie.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">OK. I know you use.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">You don't know that.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">One time I heard you downstairs at a party, and someone offered you weed.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <DualDialogue>
        <Paragraph Type="Character">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I said n</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">o... OK don't give me this bullshit. Total sanctimony. I said NO.</Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> (cont'd</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">-you said weed stayed in the system for weeks, but coke would be gone in two days max.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He says nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Were you high when you raced Lucky?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">My bloods were clean.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Bloods weren't taken for three days.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">He says nothing in response. </Text>
      <Text>Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">gets out and </Text>
      <Text>leaves the door open and marches towards the crash. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray leans to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">close the door.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">As he does so, he</Text>
      <Text> hears raised voices in the Dodge behind.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> Sitting up, he looks in the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">REARVIEW: </Text>
      <Text>Skinny </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Guy</Text>
      <Text> argu</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">es</Text>
      <Text> with </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">F</Text>
      <Text>ace taut</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">,</Text>
      <Text> stressed.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> A serious disagreement. Skinny Guy makes eye contact with Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray tweaks the mirror away. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Doesn't want to get involved.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He turns on the radio, tweaks to music. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">An EERIE 50s POP SONG begins to play on the radio...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">SINGER (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">My baby left so long ago... 
my baby left so long ago... 
I look for her everywhere I go...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He kills the radio</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. T</Text>
      <Text>ilts the</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">bringing Dodge </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">back </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">into view</Text>
      <Text>. Skinny </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Guy</Text>
      <Text>'s face is slicked with sweat</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned is a silhouette in the back seat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">'s</Text>
      <Text> CELL </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">RINGS</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">E</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">yes fixed on the rearview</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">he answers. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">husky </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">voice of ALICE </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">(late 30s) comes through.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">Tell me you're ok-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">We're both totally fine. Don't worry. The epicenter was way east. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">Where are you now?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Stuck in a jam on the freeway but they'll get us moving soon enough. I'd put her on but she's stepped out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I guess this is one way for you guys to spend time together.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, I have some </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">co-parental</Text>
      <Text> bad news to deliver. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I found a baggie on her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Oh that's just </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">fucking </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">great-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW: Skinny Guy now appears to be in the climax of the heated argument. Angry? Begging?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Therapy. She needs therapy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sure. Rehab worked wonders, why not? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">.</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Oh screw you</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I think she wants to stay with you. Maybe this is all acting out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Y</Text>
      <Text>ou get weekdays, I get weekends. That was the agreement. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Weekends when you're not busy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I got race days, training</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, and it pays her tuition.</Text>
      <Text> Cheap shot</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">,</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Al</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">You earned it. She needs a strong man in her life</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">, a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">nd if you won't be that she'll find someone who will...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Skinny Guy dives forward, trying to reach for his leg. Ned's arms reach around to grab Skinny Guy. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Call you back.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray</Text>
      <Text> hang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text> up. Transfixed by the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">: </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Elbows and hands </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">struggling</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Wipers</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">kick</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> on</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">fluid </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">smearing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> the windshield</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> obscuring </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">our</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> view. Skinny Guy gets a leg up, heel </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">CRACKS the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> windshield.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray looks around </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">for other witnesses</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. The Trucker is a shadow in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">her</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> cab. The Forester do</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">es</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">n't have line of sight.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">REARVIEW: between smearing wipers</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Skinny Guy's head SNAP</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> forward and back. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">All</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> struggle abates in an instant.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">hell</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW: Skinny Guy's head </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">lolls</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, almost floppy... </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">then black gloved hands from the back prop it on the headrest.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray looks away from the mirror. Has no idea what to do. Has no idea what he just saw. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Underline">If</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> he saw anything. Looks into his phone. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">Call the cops?</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> He tweaks the mirror again.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray</Text>
      <Text> returns gaze to the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">No Skinny </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Underline">Guy</Text>
      <Text>. He’s gone. Just the silhouette of Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>behind </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">spidered windshield</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Wipers still going. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The back door opens</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray locks the doors. Cranks up the window. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: </Text>
      <Text>Ned getting out of the car. Stretching</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. S</Text>
      <Text>urveying </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">the</Text>
      <Text> environment. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Like nothing happened.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray takes the phone from the rack. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">D</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">ials 9-1-1.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">climbing</Text>
      <Text> in</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">to</Text>
      <Text> the driver's seat of the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. E</Text>
      <Text>ncumbered by something.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray listens to the ringing tone. Answered.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">EMERGENCY OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">(filtered)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">What is your emergency?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Police.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: A FOIL SUNSHADE is placed across the entirety of the windshield, obscuring his view.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> The wipers stop.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">POLICE OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">Police, what is your emergency?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I'd like to report a crime.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">POLICE OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">Are you in danger or do you require immediate emergency assistance?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I don't think I'm in danger.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He remembers </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">the baggie</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Pulls it out for a moment</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I'll call you back.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">POLICE OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">Sir, if I can just take your-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray hangs up and reaches for the door. Hesitates.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">T</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">he </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">No movement. All is calm.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray takes the switchblade from the glove box and pockets it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> U</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">nlocks the door</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> and opens it.</Text>
    </Paragraph>
    <Paragraph Number="42" Type="Scene Heading">
      <SceneProperties Length="1" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEB"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ray stands outside.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> He ambles </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">towards</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the Forester</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> scanning for a drain. Nothing doing.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray bends to massage his leg. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">teals a glance </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">at</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the Dodge. Sunshade up. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">drain</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> - one </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">car behind </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ray leans back towards the Forester's side-mirror.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">ngles himself to see if </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">they had an </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">eyeline</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> to</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> inside the Dodge. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Negative; the windshield is just out of view.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> The Chihuahua in the Forester looks down at him with curiosity.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray's cellphone RINGS</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> loudly</Text>
      <Text>. He taps it, hair-trigger</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> fast</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I got the hearing rescheduled. It's reset, two weeks.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(...)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">You hearing me Ray?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">rounds</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the cab of the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">18-wheeler</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. The Dodge is </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">now </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">blocked from view by the engine block.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...Yeah. That’s great. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Is the lawyer still there?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">DEB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Marco? </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">He</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">'s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> buttonholing Lucky's wife and her </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">rep</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> in a conference room.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic"> See if we can reach a settlement before the rematch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Get </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Marco</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> to call me when he's out</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray walks down the driver-side of the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">18-wheeler</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">'s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> box trailer. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">A</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> vista here: all </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">other </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">lanes are visible</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Simmering engines; hum of AC</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">C</Text>
      <Text>ommuters swelter. T</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">WO WOMEN</Text>
      <Text> roar at each other </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">en </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">español</Text>
      <Text>. A barbecue </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">smokes beside </Text>
      <Text>an RV. A HOMELESS MAN </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">works </Text>
      <Text>ca</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">r</Text>
      <Text>-to-car</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, cap in hand.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>At the trailer</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">'s rear</Text>
      <Text>, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">TWO GUYS </Text>
      <Text>play cards on the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> hood of a Honda Civic</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray passes them</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">mov</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> towards the drain. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">A TOYOTA PRIUS </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">- </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">the car directly behind the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> - sits in front of the drain.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray walks behind it and crouches</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> re-ties his shoelace</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">drops the baggie of coke into the drain. Steals a glance</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> at</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the Dodge.</Text>
    </Paragraph>
    <Paragraph Number="43" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW: Ray crouched at the drain, looking at us.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The interior is</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> dark</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> sepulchral</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Heavy breathing. </Text>
    </Paragraph>
    <Paragraph Number="44" Type="Scene Heading">
      <SceneProperties Length="6/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NEWSCASTER"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
          <CharacterArcBeat Name="WALT"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">INT. / </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">EXT. TOYOTA PRIUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">approaches</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> t</Text>
      <Text>he sole occupan</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">t;</Text>
      <Text> WALT, middle-aged, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">sweat-stained </Text>
      <Text>shirt and tie. The trailer</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">'s shade</Text>
      <Text> falls short of his </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">windshield</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> leaving him to bake in the sun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">T</Text>
      <Text>hink we'll be here long?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>WALT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Radio says they're hoping to get her moving in an hour.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray leans in, keeping the smile, but lowering his voice. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think I saw something in th</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">at </Text>
      <Text>Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>WALT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Saw something?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A commotion. Hard to miss.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How about you, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">compadre</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Walt finally makes eye contact. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Barely</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>WALT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look here, OK? </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">
</Text>      <Text>I don't know </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">what</Text>
      <Text> I saw.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Walt jacks up the radio to terminate the conversation.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">NEWSCASTER</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">-</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">further casualties from the earthquake were reported on t</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">he I-11</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> Drivers are being advised to re-route around the crash site...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray backs away from the Prius</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 3/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">EXT. MUSTANG &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">walks towards </Text>
      <Text>the Mustang, mak</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">ing</Text>
      <Text> his way </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">in the tight squeeze between </Text>
      <Text>box trailer and Dodge.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> His hand </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">touches</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the switchblade </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">his pocket</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> for comfort.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray</Text>
      <Text> steals a glance inside the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> as he passes</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> Tinted windows. </Text>
      <Text>Something shifting in the dark</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray's phone rings. He answers it quickly - </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">maybe </Text>
      <Text>too quickly - and walks to the shoulder. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">-you there Ray? You hear me?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I hear you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">moves</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> out of earshot</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Listen, I just finished with </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">Eva</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">'s </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">rep</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> and got a bite on the deal. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">She</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> says they'll get back today.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray watches Lory return to the Mustang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> and get in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fantastic, Marco. But listen, that wasn't why I wanted to speak... </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">glances</Text>
      <Text> at the Trucker's cab</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">I</Text>
      <Text>mprovises.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...I was sitting in this jam and I had this idea for a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> </Text>
      <Text>crime novel. Kinda in the style of Jim Thompson.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Planning a career change Ray? I hope that isn't a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">judgement</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> on my skills-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-quite the opposite. A little bird</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ie</Text>
      <Text> told me that you do some courthouse criminal work. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">I do some pro</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic"> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">bono, sure.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I wanted some legal advice on the situation my hero finds himself in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">For research purposes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For research purposes, exactly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">So tell me your story Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It's about a guy who's witness to a crime in the middle of a traffic jam. Car-jacking, turn</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">ed</Text>
      <Text> murder. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">Is he sure of what he's seen?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Pretty sure. </Text>
      <Text>And</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> for all practical purposes, he's the only witness.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">So</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> m</Text>
      <Text>y question is... now what? What's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">his</Text>
      <Text> responsibility?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">You mean, e</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">thically or legally?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Legally, I guess.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Legally, there's no direct jeopardy. I'd argue he doesn't have a proactive responsibility to do anything.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>OK</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text>o </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">w</Text>
      <Text>hat about ethically?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">More of a Rabbi question. Above my pay grade.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let's say he calls it in. Like you're supposed to. Police arrest the killer. What next?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Well, if the perp doesn't plead guilty, then there'd be a trial. Your hero would be asked to testify. Defense would get his name as part of discovery. But if the case hinges on a witness, and the perp makes bail-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-no way </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">the perp</Text>
      <Text> makes bail, we're talking Murder One here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Setting's contemporary LA right? Most D.A.s were elected on ending cash bail. Now it's catch and release. And even if the perp doesn't make the streets, he might have associates</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray stares at Lory</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> in the Mustang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. Imagining outcomes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But if </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">my hero</Text>
      <Text> never calls it in</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...</Text>
      <Text> the killer never gets his name.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Correct. I once did pre-trial for a button-man charged with multiple homicide. Burnt to death a family of six because the grandmother ratted his crew pushing on the sidewalk. The thing I remember about him, was he had smooth hands. </Text>
    </Paragraph>
    <Paragraph Number="45" Type="Scene Heading">
      <SceneProperties Length="5 3/8" Page="13" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps"> </Text>
      <Text>MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">locks the doors</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> and keeps his eye on the rearview. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Lory fiddles with the AC.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I think a car crashed off the overpass. Pontiac Sedan, classic. Then it was hit by a fuel truck, the fuel truck rolled over... t</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">his AC is trash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">It was state of the art.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Once upon a time.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: the sunshade is being taken down. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">It reveals</Text>
      <Text> Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">sitting </Text>
      <Text>in the driver's seat. Alone. Staring at Ray?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">What you staring at?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">She tries to look in the mirror but Ray tilts it away, landing on... a STRINGER walking up the inside lane, hauling a shoulder-mount camcorder. Ray has found a cover story.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Underline">Paparazzi</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. Six o'clock.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">She scans the side mirror and makes the guy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Keep your face turned. Don't want you snapped.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Then why were you taking me to the arbitration? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I was taking you for moral support. It looks good with the adjudicators.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">And for the photos, right?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The STRINGER passes them, not giving a second glance to Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">And that's not a celeb pap. He's a stringer, hunting roadkill for the evening news. And based on what I saw, he's gonna get some... I saw like three dead bodies.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray finally turns attention away from the mirror to Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">You OK? Seeing that?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">It was SO COOL. Like something off a gore site. Totally liveleak dot com.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">(a beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Actually</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">...</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> it was pretty gross.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">looks</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> at </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">Ned's</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> silhouette</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style=""> again. Then he pulls</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text>the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">switchblade</Text>
      <Text> out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">. F</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">licks it open</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. This gets Lory's attention.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> even</Text>
      <Text> know how to use </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">this</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">And you do?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Get your index under the hook so</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> as</Text>
      <Text> you don't slice your fingers. Stab. Don't slash. Center of mass. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Under the ribs. If he's close-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">-how do you know it'd be a he?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Because it's always a he, Lory. And what they got on you in body strength, you gotta make up in viciousness. So if he's too </Text>
      <Text>close,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> or fat,</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">you </Text>
      <Text>go high, somewhere you can get an arc. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">His face. His neck.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So one moment I'm an idiot for carrying it and the next you're showing me how to use it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No contradiction. You are an idiot for carrying it. But if you're going to be an idiot and carry it-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-I'm just a fuck up, aren't I?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She becomes upset. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He puts the knife in the glove box.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No you ain't.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Compared to what, you? Winning championships at eighteen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I wasn't so perfect. How do you think I know how to use this thing?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Lory</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> doesn't know what to do with Ray's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">uncharacteristic candor. S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">he turns attention to her cell. Ray checks the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Ned is standing outside the Dodge</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory, you do your old man a favor?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned stretches his arms out, like he’s woken from a long nap. He lights a cigarette and surveys</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> his environ</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Why don't you mosey on up to the police tape </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">again </Text>
      <Text>and ask the uniforms how long we're gonna be</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory remains glued to her </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">cell</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned begins to amble towards </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Could you do that for me? </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Please</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory rolls her eyes and gets out. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">She marches towards the crash. Ray turns eyes towards Ned's approach, now entering the mirror blindspot.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray can hear Ned is singing a song... the same from earlier.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">Baby left me so so long ago... 
Baby left me so so long ago... 
Baby left me so so long ago... 
I look for her in my rearview.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's waist ends up at the passenger window</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. He </Text>
      <Text>leans in and meets eyes with Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Six dead.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned nods in the direction of the crash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>S’what the radio says anyhow. There will be more, you can bet on it. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray says nothing and </Text>
      <Text>Ned puts on </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">his</Text>
      <Text> peculiar smile. There’s something childish about him</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
      <Text> His speech is a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> constant,</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">flat southwestern</Text>
      <Text> drawl. Everything about his presence suggests the threat of sudden violence</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My AC’s gone an’ expired hisself and I’m just cooking in this heat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned extends a hand</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray stares at his g</Text>
      <Text>rimy fingers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ned Booles.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray gives in and shakes the hand. Ned has a strong grip, fingers in the wrong place, like a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">secret</Text>
      <Text> handshake.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You sure we never met?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think I'd remember.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ned lets go.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yep. I think you would. But you look familiar. Where you headed?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Downtown. </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How about you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, I'm just passing through, headed down the Cali coastline, then home through the mother road, back to the valley of the spun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm guessing Phoenix.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nobody from Phoenix. Phoenix-native is as rare as a scoophead shark. Naw, I get out of there drought season. Rivers and the wells dry up. One day there'll be nothing left of Phoenix. And I guess one day there'll be nothing left of all here this. Once the oil goes, anyway. And it will.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned looks around the inside of the car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I ain't seen no two-seat Mustang. </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This a model car or something?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sure is.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hot damn. What year?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sixty-three.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Man driving a sixty-three model-car Mustang. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You m</Text>
      <Text>ust be some sort of celebrity, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">am I </Text>
      <Text>right?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You're mistaken.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You sure like lookin'</Text>
      <Text> at yourself in the mirror... hell, s’what you been doing all day! </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">What you see</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned slaps the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">hood</Text>
      <Text>, startling Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now I remember. You're that speed racer. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Ray Spear</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray says nothing. </Text>
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">traces </Text>
      <Text>a finger </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">over</Text>
      <Text> his </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">right </Text>
      <Text>eye</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, mirroring Ray's scar.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, that from the crash? Nasty.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> I'm m</Text>
      <Text>ore a NASCAR guy myself, which is why it took me so long. But you lied, Ray. You </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">lied</Text>
      <Text> when you said I was mistaken.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was being polite.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where I come from</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>ain't</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> so </Text>
      <Text>polite to fib.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">,</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic"> -</Text>
      <Text> where I come from, it's more polite than telling someone to fuck off. But, saying as we're being all candid, like</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's grin broadens.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I can tell you and me... we're gonna have a lot of fun </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">killer.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned double-taps the hood and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">steps away from the Mustang.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> Ray watches as Ned smiles in the direction of someone...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Lory is returning </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">from the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> direction of the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> crash site</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. She</Text>
      <Text> gets in and hands Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">a</Text>
      <Text> water bottle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Said maybe an hour. Who was that guy?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray drinks thirstily and hands </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">the bottle</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">back</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're leaving. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How you planning on doing that?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He tucks the ignition keys behind the sun visor.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>On foot. Grab your shit.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray pulls the phone from the holder and gets out.</Text>
    </Paragraph>
    <Paragraph Number="50" Type="Scene Heading">
      <SceneProperties Length="1" Page="18" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEB"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG -- CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray walks around the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> engine block of the</Text>
      <Text> 18-wheeler</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> to avoid </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">passing </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He walks down the side of the box trailer and the inner lanes. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Lory struggles to keep up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">You can't just leave your car on the freeway-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-send Jay-Dee to pick up the car. The keys are behind the visor. You got GPS for the car-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">-Ray, just wait until he gets there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned appear</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s</Text>
      <Text> at the rear of the box trailer</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, blocking their path.</Text>
      <Text> He hold</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
      <Text>toolbox awa</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">y in a gunfighter stance. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Gotta go.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hangs up. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He </Text>
      <Text>walks sideways into the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">inner lanes</Text>
      <Text>. Ned mirrors him in parallel. When Ray stops, Ned stops. When Ray moves, Ned moves. Like a reflection in a mirror. A shadow.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What's with this creep?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>More trouble than he's worth.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks across t</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">he barrier to the other carriageway</Text>
      <Text>. Fast moving</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> traffic</Text>
      <Text>, but freedom in the street</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> beyond</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray</Text>
      <Text> moves towards the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">barrier</Text>
      <Text> - but a CAR buzzes past, and he recoils. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Are you FUCKING CRAZY?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray turns and walks towards the crash, grabbing her arm.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We go the other way.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They won't let us through-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">-I'll convince them</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray glances back. Ned isn't following. Just standing there, grinning, watching them go.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">CUT TO:</Text>
    </Paragraph>
    <Paragraph Number="55" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="19" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. FREEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory move through stalled lanes of traffic. He looks</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> over the barrier; a hundred</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">-foot</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> drop below.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory notices </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">is limping</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Keep going</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="57" Type="Scene Heading">
      <SceneProperties Length="1 7/8" Page="19" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="LENNOX"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. CRASH SITE -- FREEWAY -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">A </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ROTATOR CRANE</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> begins to lift the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">mashed </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">fuel tank</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, supervised by a haulage crew and police.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>RAY and LORY arrive at the police tape, looking for a way through. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">OFFICER LENNOX (30s)</Text>
      <Text> stops them.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Return To Your Vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Listen, we gotta get through, OK?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Officer </Text>
      <Text>Carris joins Lennox for backup.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, we are not ASKING you to return to your vehicle. We are TELLING you-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're in trouble. We got serious issues, and I just need to get the hell off from this goddamn freeway-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A deep rumble cuts him off and t</Text>
      <Text>he</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> freeway begins to shake. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A large AFTERSHOCK begins shaking the bridge and the cars. The rotator begins to sway, drawing everyone's attention. The metal pneumatics strain like the sinews of overworked muscle and the oil tank begins to sway. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A winch cable snaps loose from the axle, and the fuel tank sways back and forth. The rest of the axle groans.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The aftershock stops. Leaving just the sway of the fuel tank under the rotator. Nobody moves.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">The axle</Text>
      <Text> snaps from </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the winch.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The fuel tank </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">sags</Text>
      <Text> to the ground</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, and </Text>
      <Text>the leaf</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> spring</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">rips and</Text>
      <Text> gouges a hole in the tank plating.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">A river of DIESEL slurps across the asphalt. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray grabs Lory and pulls her away from the scene.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> 
</Text>      <Text>Cops and paramedics and firefighters clear the area.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory tries to look back at the scene but Ray is insistent, pulling her away. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Proximate</Text>
      <Text> drivers </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">flee</Text>
      <Text> their cars</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The rotator winch cable begins to smoke with friction, going haywire without the load it was calibrated for. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">A</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> SAFETY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> OPERATOR </Text>
      <Text>gets back in the rotator cab</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> of Hercules and</Text>
      <Text> pulls a switch.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>A clamp chomps on the winch cable.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">..</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...which</Text>
      <Text> sparks, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">and the sparks </Text>
      <Text>drift to the diesel, and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the diesel</Text>
      <Text> ignites. Flames race towards the hemorrhaging tank</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">er</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>GET DOWN! EVERYONE GET DOWN!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Italic+Underline">KRA-BOOOOMMMMMM</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Italic">!!!!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>-AN ORANGE EXPLOSION </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">BURSTING</Text>
      <Text> UP INTO THE AIR.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray pulls Lory behind a car, covering her body with his own.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+Italic">A flash of the racetrack explosion... orange flames sucking into the crashed black Indycar.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>SHRAPNEL RAINS down around</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> Ray and Lory </Text>
      <Text>- pieces of metal THUMPING against car </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">hoods</Text>
      <Text>, CRACKING windshields. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+Italic">Atomi</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+Italic">z</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+Italic">ed fragments of the Indycar rac</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+Italic">e</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+Italic"> towards</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+Italic"> it and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+Italic"> congeal</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+Italic"> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+Italic">as it uncrumples from the barrier.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">patter </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">of debris </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">subsides</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Thundering silence as the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> mushroom cloud widens in the sky.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+Italic">A smoke-stack is sucked into the burning Indycar.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">lifts himself off Lory</Text>
      <Text>. Bits of glass falling off his back. He pats her down. Checking for cuts or wounds.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">LORY, ARE YOU OK</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dad, I'm fine. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Smoke and debris. The blast smoke clears. Police Officer </Text>
      <Text>Carris moving car to car, looking for injured. Finding them.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ARE YOU INJURED?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We don't think so.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">THEN GET BACK IN YOUR VEHICLE AND </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Underline">STAY THERE</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray pulls Lory into motion, away from the crash site.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> They walk amidst a chorus of car alarms.</Text>
    </Paragraph>
    <Paragraph Number="59" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="21" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. EYE IN THE SKY -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>CNN helicopter THUNDERS above the RAGING FIRE below. SIRENS SCREAM as more emergency service vehicles race to the scene.</Text>
    </Paragraph>
    <Paragraph Number="60" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="21" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. FREEWAY -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory trudge wearily back towards the Mustang. The punishing sun soaking them through with sweat. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Wait a sec. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She turns as he puts his hand to his bad knee. He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">pauses a moment,</Text>
      <Text> looking at the hellish scene behind him.</Text>
    </Paragraph>
    <Paragraph Number="62" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="21" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory arrive</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> at the Mustang. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">They find</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">standing behind it, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">sweating and panting, like he's had a work out. </Text>
      <Text>He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">pours</Text>
      <Text> water from a bottle onto the hot asphalt</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> in front of the Dodge, almost </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">like a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">ritual.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Out of the frying pan, Ray?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Get in the car</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Lory.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She gets in. Ray stares </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">at Ned.</Text>
    </Paragraph>
    <Paragraph Number="63" Type="Scene Heading">
      <SceneProperties Length="3 7/8" Page="22" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEB"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text>locks the doors. He holsters his phone</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> and dials.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know that guy?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He's just some asshole.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I saw </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">you</Text>
      <Text> talking to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">him</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">-You've reached Deb, leave me something special after the jingle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(after the jingle)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Deb, change of plan. I don't need to pickup anymore, cancel Jay-Dee. I'm handling this myself.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned's silhouette in the front seat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory looks in the mirror as well and Ray tweaks it away.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's not just some asshole. Is this guy your bookie or something?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray rubs his face with his hands.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He wants to blank everything out for a second. </Text>
      <Text>Then he hears the sound of a lighter being sparked. Opens eyes to see Lory smoking</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. Her cigarette hand is shaking. She's worried.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just tell me the truth. For once. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Any other time Ray would snatch </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">cigarette</Text>
      <Text> out of her hand. But her hand has a tremble, so she gets a pass.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Gimme </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">some of that.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She's surprised at the request. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">She passes it to him. He smokes long and hard, and thinks how to say it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You're gonna think I'm crazy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Already do. Who is he?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Don't look back when I tell you this.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ned. That's the name he told me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">She cranes her head to look in the rearview.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">I said </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Underline">don't look back</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. He might have eyes on us and I want the content of our conversation to be discre</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">et</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Do you know him?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Not until today. I seen him walking from the direction of the crash, he gets in the Dodge Ram behind us. I'm guessing now he was </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">un</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">invited.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah... wait. I saw someone else in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the driver's seat</Text>
      <Text>. A skinny guy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was alone in the car when it happened.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">... </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned and the Skinny Guy</Text>
      <Text> get into </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">some sort of</Text>
      <Text> struggle. And then... I think I saw the skinny guy get popped.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like, shot?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Didn't hear a shot. I saw </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text>kinny </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">g</Text>
      <Text>uy's head pump forward and back and go loose.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Ragdoll.</Text>
      <Text> Jack in the box.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Like the life was gone.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I think the b</Text>
      <Text>ody must still be in there.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">You're joking, right?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Wish I was. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">His stare tells her he's dead serious.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Tell the police what you saw. They'll arrest him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">I got advice. He might make bail. Then I'm the prime witness.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Maybe a body's all they need-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">You want to take that chance?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">OK, then. Just drive away.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He knows I'm the only witness. And he knows who I am. That makes me a loose end. I wouldn't be hard to track down.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Make </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">an</Text>
      <Text> anonymous</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> call</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And say what?</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> I saw a murder?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Say you saw a gun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">But I didn't see a gun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">What if you did?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray stares at her.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> He taps his phone.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>CALL MARCO.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(it rings)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory, you have a devious mind.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Hey Ray - </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">the rep likes the offer, he's pushing hard with Lucky's wife.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I await updates with bated breath. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Listen, I</Text>
      <Text> just wanted to ask your advice about this novel again.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">..</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray nods to Lory so she gets his cover story.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I feel I got the hot hand creatively trapped in th</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">is</Text>
      <Text> jam, and if I don't crack it right now, I never will.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Billable hours?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Whatever it takes to keep you talking, Marco.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Fire away.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What if my hero makes an anonymous tip-off to the police. Says he saw th</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">e perp</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">had a gun</Text>
      <Text>. So they investigate</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> looking for a weapon</Text>
      <Text>, find the body</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">, lock the perp up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic">I</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">f the call is anonymous, they can't search the passenger compartment. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what can they do?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Look through windows or open doors. Run the plates. Ask </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">the perp</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">step</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> out of the vehicle </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">while they</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> check </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> license-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If they run the plates, they'll find out the car isn't his.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Correct. And once the vehicle is impounded, they can do a search.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>OK, all clear. Thanks Marco.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hangs up and looks to Lory.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> She fishes out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> a BURNER PHONE from her bag.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">This is a burner.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What you got a burner for?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Same reason you d</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">o</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> To hide numbers from mom.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Off his look, </Text>
      <Text>Lory dials 9</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">-</Text>
      <Text>1</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">-</Text>
      <Text>1, tilting the- </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">bringing </Text>
      <Text>the plates on the Dodge into view.</Text>
    </Paragraph>
    <Paragraph Number="64" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="26" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned's face is lit by the glow of his phone screen. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Gloved</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> finger scroll</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> YouTube clips of the Ray Spear crash. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> point of impact</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> with the black Indycar</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned scrubs it back and forth</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">O</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">bsessive.</Text>
    </Paragraph>
    <Paragraph Number="65" Type="Scene Heading">
      <SceneProperties Length="1" Page="26" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory and Ray sit waiting. 
REARVIEW: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ned's </Text>
      <Text>silhouette</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. Ever watchful.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I could really use a joint right now.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Not a good habit.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like you never had a tote.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">As a kid, maybe. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">E</Text>
      <Text>nough to know it wasn't for me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what did you do for kicks?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Boost cars.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">(off her look)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'd hotwire 'em. Take 'em out for a spin. Treat 'em real nice. Wipe 'em down for prints and leave 'em in a well</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">-</Text>
      <Text>lit parking lot.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Shit. That's gangster.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fights too. I put guys in the hospital.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You never told me this.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Because I didn't want you to repeat my mistakes. But it turns out you're holding yourself to an image of me you can't possibly compare to. So now you know. And maybe you'll give yourself a bit more of a break.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray catches sight of </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Officer </Text>
      <Text>Carris's Harle</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">y approaching.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> Officer </Text>
      <Text>L</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ennox</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> riding</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">pillion</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">She kickstands the bike. They</Text>
      <Text> dismount</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> and take helmets off</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A passing look </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">into the Mustang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> - they clock </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray and Lory. Then the focus</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> shifts to the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Carris circles the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">unclipping</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> her holster.</Text>
      <Text> She taps the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> driver's</Text>
      <Text> window and backs away.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="27" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Lennox </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">covers from</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> the engine block. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">ngled to ambush Ned if required, the box trailer taking stray shots.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">winds</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">down</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> the window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">mind stepping</Text>
      <Text> out of the vehicle with </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">your </Text>
      <Text>license and registration?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sure.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned reaches for glove box. Her hand </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">finds her</Text>
      <Text> gun grip.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Slow now</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">, slow...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">s</Text>
      <Text> molasses</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> in January.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He slowly </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">takes out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> the registration. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris observes the mess inside. A NAVAJO BLANKET over the backseat. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">Something</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> heavy</Text>
      <Text> beneath.</Text>
    </Paragraph>
    <Paragraph Number="71" Type="Scene Heading">
      <SceneProperties Length="1 5/8" Page="27" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="LENNOX"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps">INTERCUT -- </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">DODGE </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps">&amp;</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps"> MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory watching the scene.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Cop should have seen it by now.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">must</Text>
      <Text> be </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">hidden</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned takes his</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> driving</Text>
      <Text> license </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">and a pack of cigarette</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>from </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">his </Text>
      <Text>shirt pocket</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Hands license</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> to Carris</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. C</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">igarette</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">he keeps</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. </Text>
      <Text>Carris steps back and taps her radio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">I need a 10-27, over.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox notes Ned listening to the dispatch chatter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, do you have a firearm on your person or in this vehicle?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No, I don't. Not on me. Not in the car. And as I understand it, it's an offense in this state to carry a concealed weapon without a license. And I'm a law abiding citizen.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">signals</Text>
      <Text> Lennox </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">- a word aside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">K</Text>
      <Text>eep your hands where we can see them and remain outside the vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned sparks a cigarette</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> Hands visible, technically.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>C</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">arris</Text>
      <Text> and L</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">ennox</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">step away</Text>
      <Text>. Out of earshot from Ned, but close enough for Lory and Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">No outstanding warrants. Arrests for larceny, GTA... no convictions. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory listening.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What about the vehicle?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Confirmed with Hertz. Registered to Ned Booles and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">a </Text>
      <Text>Clyde Burkman.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory whispers</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> to Ray</Text>
      <Text>, who is </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">locked in</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">I don't understand. The car is his?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">The situation is more complex than that which it first appear</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ed</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">If they don't search the car-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">-he gets away with it. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Underline">I know, OK</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris and Lennox return to the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Dodge</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, we'd like to have look inside your vehicle. Is that OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm not obliged to, am I? Fact you're asking means you don't have probable cause. So, no, you cannot.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A glance between the cops.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">catches Ray's eye. A</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">grin says h</Text>
      <Text>e's winning. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">A door opens. Lory is getting out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory, get the hell back-</Text>
    </Paragraph>
    <Paragraph Number="71E" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="29" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY (O.S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">.</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Officer! Can I have a word?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris and Lennox turn to observe Lory standing outside the Mustang. They glance at each other</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="71F" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="29" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Lory led to the shoulder. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Talking to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the cops. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Carris</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> taking notes</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">REARVIEW: Ned is watching too</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">Not good</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The</Text>
      <Text> pow-wow break</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text> up</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Lory slams back into the car. Silence.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I told you not to get involved-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-they needed a name</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> on the call</Text>
      <Text> to search the vehicle, OK? My name.</Text>
    </Paragraph>
    <Paragraph Number="72" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="29" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LENNOX"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris and Lennox return, cock of the walk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Guess that little girlie just gave you probable cause. Does that mean you gonna give me the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">reach-around</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He lifts his arms. Sweat</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">-dark </Text>
      <Text>armpits.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'll do it.</Text>
    </Paragraph>
    <Paragraph Number="73" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="30" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned looks towards Ray as he is frisked by Lennox.</Text>
    </Paragraph>
    <Paragraph Number="74" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="30" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Bold+AllCaps">INT. / </Text>
      <Text>EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">searches </Text>
      <Text>the interior. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">G</Text>
      <Text>love box. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Seat</Text>
      <Text> pockets. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">U</Text>
      <Text>nder the seats. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Running fingers along the</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">upholstery.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Something big and chunky under the Navajo blanket. We're waiting for Carris to investigate it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris's nose twitches at a strange smell. She looks towards the blanket. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Pulls it</Text>
      <Text> back, revealing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...</Text>
      <Text> the toolbox. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">No body</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="75" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="30" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ray watches Carris get out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">He put the body in the trunk. I saw the seats down... the son of a bitch was putting it in the trunk.</Text>
    </Paragraph>
    <Paragraph Number="76" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="30" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris sets the toolbox down</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. O</Text>
      <Text>pen</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text> it up. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">L</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ifts out a</Text>
      <Text> MODIFIED IMPACT WRENCH. She holds it </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">out </Text>
      <Text>like a gun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Impact wrench</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="77" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="30" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory watching.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look in the goddamn trunk.</Text>
    </Paragraph>
    <Paragraph Number="78" Type="Scene Heading">
      <SceneProperties Length="1 6/8" Page="30" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="LENNOX"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">It's been modified.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Oh, you know your tools girl. Weekends spent with daddy under a crankshaft?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lennox </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">bristles</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> but Carris raises a hand. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Easy</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">What have you done</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> with it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Weren't me. Was my</Text>
      <Text> partner Clyde. Redirect</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">s</Text>
      <Text> the rotational energy</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> along the horizontal axis</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> with the same force. More like a hammer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Why?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Why not? Ain't illegal, is it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Carris</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">signals to Lennox.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're gonna take a look in your trunk</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> now, OK</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">s</Text>
      <Text>ir?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">There you go again, phrasing that real</Text>
      <Text> careful</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. Means</Text>
      <Text> you need my permission, right?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We have probable cause to search-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-what I can reach. And in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">a Terry stop</Text>
      <Text>, that's the passenger compartment. Not the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You seem p</Text>
      <Text>retty keen </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">on</Text>
      <Text> us not look</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ing</Text>
      <Text> in there.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">R</Text>
      <Text>efusal to agree to a search is not in itself probable cause. Florida Versus Bostick. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox looks to Carris. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Both</Text>
      <Text> pissed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh I can tell what you're thinking. Let's make some shit up. Now this was some roadside stop, I'd let you, because you could always make up some goddamn probable cause, which could put me in a lot more trouble, like a cell, or a hole in the ground. But in the right here, right now, I got witnesses, like my man over here, and my people here, and my Jimmy Hoffa girl up there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The cops see everyone named is paying attention.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">We'll get a warrant.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Go get it, ma'am. C</Text>
      <Text>ome back with a warrant</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, </Text>
      <Text>you'll open her up and find a spare tire, crank</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">,</Text>
      <Text> dirty oil cloth. And I'll get a big ole giggle out of that. Shall we dance? I could use the entertainment out here in this heat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris looks to Lennox. She gives the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">smallest</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">head</Text>
      <Text>shake. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Leave it</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">H</Text>
      <Text>ands Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> his</Text>
      <Text> documents.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Next turn-off, you go get the windshield fixed. Because I would take a great deal of pleasure in arresting you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, I know </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">it</Text>
      <Text>, ma'am. You can give me the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">reach-around</Text>
      <Text> anytime. One on one.</Text>
    </Paragraph>
    <Paragraph Number="84" Type="Scene Heading">
      <SceneProperties Length="1" Page="32" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Watching the stop wrapping up. Ned gets back in the Dodge. Ray looks at Lory. Worried he's going mad.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory... I know what I saw.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>C</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">arris</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">taps Ray's window. He</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">lowers it</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> She</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">leans</Text>
      <Text> in. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think the caller was mistaken. I think that tool I lifted up could have been what they </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">seen</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look in the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Working on it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris is about to leave. Ray stops her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Meantime o</Text>
      <Text>fficer</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, </Text>
      <Text>you mind </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lory stays </Text>
      <Text>up </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">with you </Text>
      <Text>near the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">police </Text>
      <Text>tape?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We need to keep the site clear for first responders.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I just want to prevent a situation.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">eyes</Text>
      <Text> Ned. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Sees</Text>
      <Text> the potential flare-up. Her radio squawks. She taps to respond.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(into mic)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thirty-four Mary nine, to dispatch, on my way.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">(to Lennox)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You mind checking tail-lights and taking the slow way back? I might have another rider.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory looks at Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, worried for him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'll be fine.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Underline">Go</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="85" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="33" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. -- MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray watches </Text>
      <Text>Lory approach the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Harley</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Takes a helmet.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I thought LAPD </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">rode</Text>
      <Text> Beemers now.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They got the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">new </Text>
      <Text>contrac</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">t</Text>
      <Text>. But </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">inventory let me hang</Text>
      <Text> onto </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the Harley.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">H</Text>
      <Text>eavier, lower to the ground, easier</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>to maneuver. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">mounts up,</Text>
      <Text> puts arms around Carris. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">One</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">l</Text>
      <Text>ook back at Ray as the Harley takes off.</Text>
    </Paragraph>
    <Paragraph Number="86" Type="Scene Heading">
      <SceneProperties Length="6/8" Page="33" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>rais</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">es</Text>
      <Text> a hand</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> to her</Text>
      <Text>. Next he turns </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">eyes to</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW:</Text>
      <Text> Ned. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Staring at him</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> from the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray's phone rings and he answers it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">We got terms but there's one snag.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">Lucky's wife wants to speak to you before she signs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Eva? Why does Eva want to talk to me?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">To</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic"> hear your side of the crash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">She's read the deposition-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">-she </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">needs</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic"> to hear it </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">from you </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">directly</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic"> Ray. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">I</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">f</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic"> you can close her... she'll sign, and you'll be racing again.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic"> Guaranteed.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> rubs his brow.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">OK</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">F</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ine. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Tell </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Eva</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> to call me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">I'll give her your number-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">She's got my number. Listen, I got another angle on my story I wanted to run past you...</Text>
    </Paragraph>
    <Paragraph Number="87B" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="34" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">threads</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> fishwire through a fish-hook. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Loops a strip of</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> double-sided electrical tape </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">around the hook. L</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">ets it dangle </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">around</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the rearview mirror and pulls on his black gloves.</Text>
    </Paragraph>
    <Paragraph Number="88" Type="Scene Heading">
      <SceneProperties Length="4/8" Page="34" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">So y</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">ou're writing a locked room mystery.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You'll need to e</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">xplain to me what that is.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: Ned step</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> out of the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> holding something. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">An impossible crime has taken place in a confined space. Like a murder where the only door has been locked from the inside. Kind of a parlor game with your audience, so they can work out the solution.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: Ned makes his way behind the Prius. He crouches at the drain, his body blocking Ray's vantage.</Text>
    </Paragraph>
    <Paragraph Number="89" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="35" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">EXT. DRAIN</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned threads the sticky-tape hook between drain bars, careful</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> not</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">touch</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the sides.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">He clocks Walt watching him in his side-mirror. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned raises a finger to lips; shhhh....</Text>
    </Paragraph>
    <Paragraph Number="90" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="35" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. DRAIN</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The sticky-tape hook is lowered down the shaft.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> We can see Ned looking down through the bars at us.</Text>
    </Paragraph>
    <Paragraph Number="90A" Type="Scene Heading">
      <SceneProperties Length="3 3/8" Page="35" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW:</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned is hunkered at the drain. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray doesn't like it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>OK. So I've written myself into a corner. Indulge me with solutions.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: Ned stands and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">passes </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">the Prius. His hands coil</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> something that Ray cannot clearly see.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray opens the glove box, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">searching</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> for the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">switchblade</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">The</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> body has to be hidden in the trunk. Or he's moved it elsewhere. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray's pushes aside the glove box contents. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Underline">Finds nothing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Or it was never in the car in the first place...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray becomes </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">frantic</Text>
      <Text>. He looks in the footwell.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Call you back-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray</Text>
      <Text> puts his hand down the passenger seat, checking underneath</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> - when a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> shadow </Text>
      <Text>falls upon </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">him</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Stone cold mystery, ain't it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">at</Text>
      <Text> the passenger </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">door</Text>
      <Text>. Hips and menace.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">F</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">ish-hook and fishwire </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">coiled</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> in one hand. Like a garotte.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Fingerprints are a juicy thing. Now, wet ain't ideal, but all they need is a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">smidgen</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> and they can nail you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">dangles</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the baggie </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">from</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> the end of the fish-wire. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">limed with sewer-gun</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">k, stuck to the sticky-tape.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Because being caught on possession with this would lose your racing license, wouldn't it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned reaches for the door handle. Ray blocks it.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know my AC ain't working Ray. And you don't strike me as the sort of guy who'd let a seat go to waste. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned just goes ahead and peels Ray's hand off </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">his, and opens the door. He </Text>
      <Text>sits inside</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> and makes himself comfortable. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray discretely glances up to the cab of the 18-wheeler. Truck not paying attention. Then the Forester. No one is paying attention there either - </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">just</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> the Chihuahua. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned hands the baggie over. Ra</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">y</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">shoves</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> it under the dash.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> sparks </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">a cigarette with </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray's car lighter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Who you saw, his</Text>
      <Text> name was Clyde.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks at Ned carefully. Is he confessing?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He was an associate.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>More silence. Inviting questions. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">I t</Text>
      <Text>ake it you had a falling out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">D</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">idn't plan on things getting so heated out here in the open. I was gonna get Clyde to drive </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">us </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">some place private. But he was keen to get right to it. And you can't deny a man his showdown, can you Ray?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">What was you and Clyde into? Drugs?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">You worried my </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">cartel associates</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> gonna come gunning if you pop me? </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned takes a drag of his cigarette.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Nah, me and Clyde were into B and Es. Home invasions in prosecutor parlance. High-end joints, high yield returns.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">So y</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">ou're a thief</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Oh, I've had many lives. Haven't you?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned continues opening up to Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">This one time we was doing a house out in Pasadena. Cased it, thought it was unoccupied, but after we frosted the lock we busts in and finds two women. In bed together. I don't know who was more shocked! Real lookers Ray. Had to immobilize them, so Clyde hog-tied them with electric cable...once you see a woman hogtied, it gives you ideas, Ray. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray says nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Then it became less about the breakin' and enterin', and more just about the enterin', you know what I mean? And once you go down that path, only a matter of time before one of yous</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">e</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> turns on the other. Even just to squeeze a bit more juice out of the situation. I guess Clyde figured it that way too, but he didn't want to try and shoot the devil in the back case he missed. So he ran.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned fondles the Dodge keys to reveal a GPS device.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I t</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">racked him all the way from Eagle Rock. Once I figured the route I managed to get ahead of him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lucky break with the jam. Else Clyde would have made </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">clean </Text>
      <Text>his departure</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, that weren't no lucky break.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A moment</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> as Ray realizes...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The Sedan was your doing?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Got the job done, didn't it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Six dead</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Seven. Another just went in the hospital.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">stubs his cigarette. </Text>
      <Text>Looks at Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">then </Text>
      <Text>you know what that's like, don't you Ray? Causing a pile-up with fatalities. I read it took a day for the burns to kill </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lucky</Text>
      <Text>. Hell, looked from the video you was toast as well.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It was an accident-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-it weren't no accident. I know it's a little phone screen but I can tell </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">intent</Text>
      <Text> when I see it. You got an anger in you boy. I can smell it. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned smiles. Opens the car door and gets out. A curling finger appears at the window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Come hither. Got something to show you.</Text>
    </Paragraph>
    <Paragraph Number="91" Type="Scene Heading">
      <SceneProperties Length="1" Page="38" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">walks parallel to Ned </Text>
      <Text>the other side of the Mustang, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">tracking him </Text>
      <Text>as he begins to walk </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">back </Text>
      <Text>to the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Warmer. Getting </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">warmer</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray breaks from the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Colder. Colder. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray moves back towards the trunk of the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Red hot Ray. And looks like we got company. You best grab it fast.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray follows Ned's eyeline towards the crash. A COP PARTY on their way. A K9 HANDLER and K9, snout against the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">asphalt</Text>
      <Text>. Behind is Lennox, followed by Carris escorting Lory.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> looks down and</Text>
      <Text> s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">omething dark on the trunk handle.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">A smudge of blood. </Text>
      <Text>Heart racing... </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray </Text>
      <Text>opens it a crack... then all the way...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>In the trunk: THE SKINNY </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">GUY</Text>
      <Text>. FOLDED UP AND </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Underline">VERY </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">DEAD</Text>
      <Text>. LORY'S SWITCHBLADE IS</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> STABBED </Text>
      <Text>DEEP IN</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">TO</Text>
      <Text> HIS RIBCAGE.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks at Ned, backing away to the Dodge. Ned raises his gloved hands like OJ to the jury. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Bet her</Text>
      <Text> juicy paw</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>prints </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">is</Text>
      <Text> all over it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned sits back in the Dodge. Master of chaos. Table set. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray alternates looks between the body, the switchblade, Lory, the cop, back to the switchblade - </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">fuck, fuck, FUCK!</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He SLAMS the trunk shut </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">- </Text>
      <Text>just as</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> Carris arrives beside him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray, mind coming over here please?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches as the K9 HANDLER and K9 approach Ned's car, trailed by Lennox. The dog </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">goes wild at the array of scents</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="92" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="39" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HANDLER"></CharacterArcBeat>
          <CharacterArcBeat Name="LENNOX"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned moves the window down halfway, and watches as Handler and Lennox do a routine for his benefit.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Officer Lennox, my K9 is agitated and wants to explore this vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is it trained to detect firearms, drugs, cadavers?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Why yes </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">she</Text>
      <Text> is.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox taps the glass, hard, right by Ned's face.</Text>
    </Paragraph>
    <Paragraph Number="93" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="39" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Ned get frisked</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> roughly</Text>
      <Text> by Lennox. The K9 bares its teeth. Bitch has good instincts.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I understand you mightn't feel you can speak freely here</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-here's fine. Let's get </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">right to it</Text>
      <Text>. What'd you tell her Lory?</Text>
    </Paragraph>
    <Paragraph Number="94" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="40" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. DODGE -- IN THE TRUNK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">The </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">trunk is opened</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> to reveal Lennox</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">inspecting it. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">We don't see what is inside</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, but can see Ned's gloating smile over his shoulder.</Text>
    </Paragraph>
    <Paragraph Number="95" Type="Scene Heading">
      <SceneProperties Length="2 3/8" Page="40" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="HANDLER"></CharacterArcBeat>
          <CharacterArcBeat Name="LENNOX"></CharacterArcBeat>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps"> &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray keeps his</Text>
      <Text> focus to the questioning with Carris. He bursts out laughing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">, confusing Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I never said any such thing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You can trust her-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Enough</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> of all the bullshit Lory. Enough now.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Lory is silenced and confused.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Officer, </Text>
      <Text>I </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">think I </Text>
      <Text>see what's happened here. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">My girl here's</Text>
      <Text> got bored sitting in this temporary parking lot</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">,</Text>
      <Text> and she called you guys to give</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> herself</Text>
      <Text> a hoot with this little fantasy of hers</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Stop fucking lying.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Underline">Hey</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Pack it down</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory restrains herself, mute and furious. Ray looks at Lory as he speaks. Making it more direct and personal.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lory Ann Spear. Juvenile delinquent.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Look her up. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Seventeen years of age and already </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">got </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">a rap sheet.</Text>
      <Text> I just </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">lifted</Text>
      <Text> her after she bailed rehab. She's a compulsive attention seeker</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-YOU LYING PIECE OF SHIT.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory SHOVES Ray. He staggers back, hits the car </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">hood</Text>
      <Text>. Carris intervenes and separates her.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned savors the chaos</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Lory, g</Text>
      <Text>et inside the vehicle or you're under arrest.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">She doesn't move. Ray intervenes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You go to County I'</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ll</Text>
      <Text> leave it to your mother to bail you out. And I don't know when she's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">getting </Text>
      <Text>back from Vermont.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory makes a decision. Scales into the passenger seat.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Alone, </Text>
      <Text>Ray speaks </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">softly</Text>
      <Text> to Carris.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm sure there's an offense in the statute books. But she's trying to go clean and I don't think a spell inside would do her good.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox and the Handler approach. Ray observes the K9 tug at the leash, trying to get to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">What'd you find?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Spare ti</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">r</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">e. </Text>
      <Text>Dirty oil cloth. Crank</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Son of a bitch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Terry is going cray-cray over there</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. Would love to strip the car down</Text>
      <Text> but I got nothing solid.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox and Carris both observe Ned's grin. Handler observes the K9's interest in the trunk of the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mighty interested in what's in there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray saunters from Carris towards the trunk</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, puts his hand on the handl</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">e</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> and covers the blood mark.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Supplies for a cookout, but we been stuck in this jam so long I think it's going off. I give </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">her </Text>
      <Text>a treat?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Handler raises a hand to stop him opening it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No thank you! Only the handler can. For discipline.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">T</Text>
      <Text>hink I read that somewhere.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Handler leads the feverish K9 away from the trunk. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">As he</Text>
      <Text> clears </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">eyeline, Ray meets</Text>
      <Text> the watchful </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">gaze </Text>
      <Text>of Ned.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">surveys</Text>
      <Text> the whole scene. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lory, convincing. </Text>
      <Text>Ray, cool as a cucumber. Ned, grinning like a Cheshire cat. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tell her no more tall tales</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... else </Text>
      <Text>you'll be dialing for a bondsman</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Appreciated, officer.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The cops depart in the direction of the crash site. K9 snarls at Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">, tugging</Text>
      <Text> at his leash as he's pulled a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">way</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A slow clap breaks out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> from Ned.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray Spear... you are one cool customer. I can see how you got the bones for the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">speedway</Text>
      <Text>. Pure instinct, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">killer.</Text>
    </Paragraph>
    <Paragraph Number="102" Type="Scene Heading">
      <SceneProperties Length="2 5/8" Page="42" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">l</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ocks the door.</Text>
      <Text> Lory</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">'s</Text>
      <Text> rage is silent and electric.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Don't fucking talk to me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm afraid we</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">'re</Text>
      <Text> go</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ing to</Text>
      <Text> have to.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You made me look like a crazy person. You're a selfish, narcissistic prick.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He gives it a moment.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You done?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. I'm not done. I'm glad Mom left you. I'm glad I didn't have to grow up with you.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I fucking hate and despise you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He just </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">t</Text>
      <Text>akes it. Soaks it up.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> Waits.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Why'd you make me look like a liar?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So they would think the whole thing </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">was</Text>
      <Text> bullshit and move along.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is it, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">dad</Text>
      <Text>? Is it all bullshit? Is there no fucking body in that creep's trunk because you made it up?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I didn't make it up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Then </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Underline">why</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I'll tel</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">l</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> you. But w</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">hen I do, I don't want you looking back</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Underline">What is it</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">re's no body in that creep's trunk...</Text>
      <Text> because the son of a bitch stuck it in ours.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory controls herself and doesn't look.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You've seen it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I've seen it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is he dead?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Very much so. And I got more bad news. He's got your knife stuck in his ribs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Wait... you don't think I-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It's a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">setup</Text>
      <Text> Lory. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">It's w</Text>
      <Text>hy I had to lie to the police.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">We</Text>
      <Text> got nothing to do with it, it's been planted, we don't even know-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-but it's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">my</Text>
      <Text> Mustang. And it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">'</Text>
      <Text>s </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">your</Text>
      <Text> knife. And the whole thing is a fucking mess.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He reaches to hold her hand</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">s</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Things I said, I didn't mean. I had to hurt you, for real, to sell it.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> Bait </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">them</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> with emotion so she wouldn't get the scent.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. I get it. I didn't mean what I said, either.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah, you did. Long called for.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She grows more resolute. Looks at him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I need to know this is </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">for </Text>
      <Text>real. I need to see it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No way. You're not opening that fucking trunk. He's </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">gonna</Text>
      <Text> be right there, watching you, he'll know-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">-he</Text>
      <Text> knows we're in it together. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I mean, w</Text>
      <Text>e are, aren't we?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">suspects</Text>
      <Text>. Suspecting ain't knowing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Think he'll take that chance?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray's phone rings. MARCO.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> It rings and rings. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Lory opens the door, defiant.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">(whispers)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">And I want my fucking knife back</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray... lets her go.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> He answers the call and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">watches her in the mirrors, keeping his eye on </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned's car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Hey Ray, you spoken to Eva yet?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">She ain't called. Not sure she will.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">I'm worried this deal's </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">gonna</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> slip away if we don't close today.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Soon as she rings, I'll let you know. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">But saying as I got you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> on the blower...</Text>
    </Paragraph>
    <Paragraph Number="103" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="45" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">stares at</Text>
      <Text> Lory as she approaches the trunk. Places a hand on handle. Tentative.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> She looks at Ned for a moment.</Text>
    </Paragraph>
    <Paragraph Number="108" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="45" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG -- INSIDE TRUNK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Light cracks open an inch and Lory opens the trunk. She catches a glimpse of Clyde and slams it shut.</Text>
    </Paragraph>
    <Paragraph Number="108A" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="45" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Watching Lory carefully, visible now the trunk is closed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">I mean it's convoluted-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">But you follow.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">Body in the trunk, daughter's knife with her DNA in the body...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray can see Ned watching. He slips his hand to the door handle, ready to spring out if required.</Text>
    </Paragraph>
    <Paragraph Number="109" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="45" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- THRU WINDSHIELD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned watches Lory back away from the trunk. She makes eye contact with Ned, disgusted. His breath is heavy watching her. She turns away. Steels herself. Opens the trunk again.</Text>
    </Paragraph>
    <Paragraph Number="110" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="46" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG -- INSIDE TRUNK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory reaches </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">for </Text>
      <Text>the rose-embroidered </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">knife </Text>
      <Text>handle. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">She pulls at it. It won't come easy - w</Text>
      <Text>edged</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> too</Text>
      <Text> deep</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Finally it loosens, slick with </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ribcage</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> gore.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">She folds it shut, and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">closes the trunk with her clean hand.</Text>
    </Paragraph>
    <Paragraph Number="111" Type="Scene Heading">
      <SceneProperties Length="2 6/8" Page="46" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="MARCO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- LATER</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">uses wipes to </Text>
      <Text>clean blood</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> from her hands and the switchblade. Ray continues his conversation with Marco.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I don't love</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic"> your hero</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> lying to cops.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He was trying to retain optionality.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">.</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">It's conspiracy after the fact.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can he back out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> now</Text>
      <Text>, say he panicked. Claim his life was under threat?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">He can't really c</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">laim his life was under threat in the presence of police officers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what's he looking at?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Depends on his profile. Would you describe your hero as privileged? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Very privileged. Privileged in a way he never realized.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">OK, so in today's prosecuting environment, that's a charging enhancement, not a plus. If I was a D.A. on the make, looking to make a high profile conviction... I would push a story to a jury that our guy is a co-conspirator.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic"> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">You've got the daughter for leverage. And you got the psychopath angling for a plea deal as well. If I was on defense, and we were offered twenty years and the daughter walks... I'd take it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Why the</Text>
      <Text> hell would he take twenty years</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> for something he didn't do</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Because Murder One is the death penalty, Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray opens his mouth to speak. It hits him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Appreciate the advice, Marco.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hangs up. He looks into-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned's smiling face. Ray snaps the mirror away</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">They sit in silence.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">You could beat it at trial.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Maybe. Maybe not. I'd be finished either way.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Not if you beat it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">There are stages of ruin Lory. There's the ruin of the investigation. Then the charge. Then the acquittal. I'd be done.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">So no cops.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Underline">No cops</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">She decides to play her hand.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Way I see it, this is a game of pass the parcel. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">The parcel is in our trunk. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">And we just need to work out what to do with the parcel.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You mean... dispose of it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">It solves the problem-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">-it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> make</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> me an accessory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">And not a witness</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, right. No reason to come after you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">gets the logic.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I know a guy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know a guy. Great.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Mateo</Text>
      <Text>. Works at a scrap</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
      <Text>yard. I mean, he's really a mechanic and he'd love to work pit but-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-how can "Mateo" help us?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Pay him cash, and this car is just another cube in a junkyard. And so is whatever is in the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You haven't thought this through. "Mateo" could put the squeeze on </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">me</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He won't.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You can't be sure.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Trust me. He's not going to the cops.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks at her, and her gaze tells him everything.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How old is this creep?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Twenty. And he's not a creep, it was me doing the chasing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">G</Text>
      <Text>ive me his </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">fucking </Text>
      <Text>number.</Text>
    </Paragraph>
    <Paragraph Number="112" Type="Scene Heading">
      <SceneProperties Length="1 6/8" Page="48" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MATEO"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps"> </Text>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">walks to the shoulder</Text>
      <Text>, phone to ear.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Am I speaking to Mateo?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Who is this?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray Spear here.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm Lory's father.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Oh - </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Mr</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> Spear - I know you - it's like an honor-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-Lory tells me you work at a scrap</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
      <Text>yard.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Yeah, like, I manage here but I'm really a mechanic, looking to hustle-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-I need a car scrapped Mateo. And the hustle I need is that it's done tonight, and it's off the books.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I mean, Mr. Spear, sir, I'd like to help but we need to book you in. I gotta follow the law, you know-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Follow the law Mateo? Seriously? Let</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">'</Text>
      <Text>s cut to the chase. Lory told me about you guys.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">What? Jesus-fuck, look - listen - I don't know, I don't know what-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm not interested in explanations. I'm interested in discretion. Is discretion something you're interested in?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(silence)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Answer me Mateo.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(a whisper)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Yes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can you do the thing that I'm asking you to do?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Yeah, I can do it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I imagine your yard got surveillance cameras and record-keeping.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I open her up for a night shift, I control the environment. It'll be on the down-low.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What happens to the blocks on the yard?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">We aggregate them and ship them to China. Container ships.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray begins moving back to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">gonna</Text>
      <Text> call you later to arrange. And we'll need to talk about the other thing. I won't hurt you or call the cops, but I am her father. You understand?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I do, sir.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Keep </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">your</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> phone charged</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, the line clear and wait on my call.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray eyeballs Ned in the Dodge.</Text>
    </Paragraph>
    <Paragraph Number="113" Type="Scene Heading">
      <SceneProperties Length="1" Page="50" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">gets in</Text>
      <Text> and </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">reholsters</Text>
      <Text> the phone. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mateo is on stand-by.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">How'd</Text>
      <Text> he take it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Shit his pants, how do you think?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's actually a nice guy.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Seriously. He doesn't like me drinking</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> or using</Text>
      <Text>. His family are Catholic and stuff. I've had dinner there.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Don't tell me you're looking for me to bless this thing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're only three years apart.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray's mind is on next steps. A decision.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I need to lay this out to Ned. So as there's no misunderstanding.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She looks at him</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> like he's crazy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">H</Text>
      <Text>e's been running a tight game. I don't see him getting sloppy in the last innings. Not with you to make some noise in the afterwards.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He turns to her, speaking closely.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But if </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I am</Text>
      <Text> wrong... make some noise. You honk. You scream. You holler. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">R</Text>
      <Text>un if you have to. And if he gets close</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">S</Text>
      <Text>tab</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">,</Text>
      <Text> don't slash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That's my girl.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He gets out.</Text>
    </Paragraph>
    <Paragraph Number="114" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="51" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="SINGER"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold+AllCaps">MUSTANG -- CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray struts towards the Dodge. The showdown. Ned is already winding down the passenger-side window. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">As he approaches we can hear the radio is playing </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">that strange </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">50s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> pop song.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">SINGER</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps"> (O.S.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">Want to tell her I'm her only man... want to tell her I'm her only man... I look for her every chan</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">c</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">e I can.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Big smile waiting for Ray; cat who's got the cream.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Been wondering when you'd come by.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Step into my office.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">opens the passenger door</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. </Text>
      <Text>Ray glances at Lory,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> then climbs in.</Text>
    </Paragraph>
    <Paragraph Number="115" Type="Scene Heading">
      <SceneProperties Length="1 5/8" Page="52" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">locks the doors</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> and winds up the window. It is dark and fetid inside; the seat feel</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> sticky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">My father used to like this song.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Maybe you get to see him soon.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Underline">Phone</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned kills the radio. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray hands over his phone</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">NED</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You ain't recording this</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, are you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Shit. Should have thought of that.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Wouldn't be admissible anyway.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">takes the sunshade from the bac</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">k and mounts it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So as we got some privacy.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray's eyeline with Lory is cutoff. </Text>
      <Text>Ned reaches into the back and gives Ray a good sniff of his perspiration. He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">pulls </Text>
      <Text>the impact wrench on</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">to</Text>
      <Text> his lap.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Clyde made this for delivering the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">coup de grace</Text>
      <Text> to a safe. By a twist of fate, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">it turned out he forged the tool of his own demise.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned squeezes the trigger</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... the head punches out like a xenomorph's mandible.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray doesn't react. Ned laughs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">NED</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You don't break a sweat, do you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How does this end, Ned?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I guess you thinking we could just go our separate ways</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Long as Clyde disappears, you'</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">d be</Text>
      <Text> in the clear. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">And I'd</Text>
      <Text> be an accessory. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Way I see it, we'd have </Text>
      <Text>the goods on each other</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How you planning on disappearing Clyde?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Scrap yard. A close contact. No paperwork, no cameras.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>In the Mustang? More of a sin than what I did to Clyde. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Best to be thorough. Forensics. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned bursts into a belly laugh.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You come up with that you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">r</Text>
      <Text>self?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm adapting.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No, you discovering who you really are, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">killer</Text>
      <Text>. When you woke up for breakfast, you ever imagined this here conversation was lying in store for you? Like that fuel tank driver, when he pulled on his pants this morning, he had no conception he was gonna be driving down this freeway... </Text>
    </Paragraph>
    <Paragraph Number="118" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="53" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. FUEL TANKER -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Through </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">the</Text>
      <Text> windshield</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> of the tanker</Text>
      <Text>,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> we can see</Text>
      <Text> the Sedan levitate upwards.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">... and out of nowhere a fucking Sedan was going to drop down in front of him like a piano grand.</Text>
    </Paragraph>
    <Paragraph Number="119" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="53" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Got me thinking about </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">time's arrow </Text>
      <Text>Ray. I read it in a physics book once, by that</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> spastic</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> fella.</Text>
    </Paragraph>
    <Paragraph Number="120" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="53" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. SEDAN -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The eyes of the SEDAN DRIVER</Text>
      <Text> stare into space - he's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">already </Text>
      <Text>dead. His head bobs as </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the Sedan</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">floats up</Text>
      <Text> from the road.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">And what I learned is some things in the universe have properties, that you can flip, back to front.</Text>
    </Paragraph>
    <Paragraph Number="121" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="54" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. FREEWAY OVERPASS -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Sedan floats upwards through the air. An inverted swandive, arcing through towards the overpass.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Now you look in a mirror, left is right and right is left. Everything's reversed, but it ain't fundamentally different.</Text>
    </Paragraph>
    <Paragraph Number="122" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="54" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. OVERPASS -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Sedan lands on the overpass, reverses away from the precipice to the safety of solid asphalt.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">But time is different. Each direction of time has a specific flavor. Things running forwards ain't the same as things reversed, reversed again.</Text>
    </Paragraph>
    <Paragraph Number="123" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="54" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You ever see a newborn's eyes light up? Spark of life for the first time?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I seen it.</Text>
    </Paragraph>
    <Paragraph Number="124" Type="Scene Heading">
      <SceneProperties Length="4/8" Page="54" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. SEDAN -- THRU WINDSHIELD -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Sedan Driver's </Text>
      <Text>head is slumped forward. A puncture wound in his neck, blood rushing inside it. The Sedan loses momentum as the door opens</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> and</Text>
      <Text> Ned p</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">ulls </Text>
      <Text>the side pillar.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Now, I seen the lights go out in someone's eyes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Sedan slows and Ned yanks the handbrake. He puts handcuffs onto the dead </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Sedan Driver.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">And it ain't just the reverse of the lights coming on. You get a real sense that which is extinguished can never be lit again. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> lifts the impact wrench to the </Text>
      <Text>wound in the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Sedan Driver</Text>
      <Text>'s neck</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">. Blood rushes inside as he plugs the wound.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">His head snaps back, coming to life, turning to Ned.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Sedan Driver's eyes open and wide and pleading, tears inverting up into his eye sockets...</Text>
    </Paragraph>
    <Paragraph Number="125" Type="Scene Heading">
      <SceneProperties Length="1 7/8" Page="55" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned lets his thoughts sit there, simmering.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I guess what I'm saying is, I think we was always gonna meet Ray. </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're like two particles destined to collide. One going forwards in time. The other backwards. And only one of us is gonna exist afterwards.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">You know what? </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">It was a mistake trying to reason with you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">reaches to unlock</Text>
      <Text> his door and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">get out</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned rips Ray back into the car and shoves the impact wrench under his chin. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You move I </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">snap</Text>
      <Text> your neck like a barnyard chicken. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray becomes perfectly still.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Indicate you heard me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(choking)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I heard you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know this situation is beyond the law Ray. This is the you and me now. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned withdraws the impact wrench and Ray gasps.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let me tell you what's gonna happen.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Traffic's gonna be moving soon. And when it does, you and I are gonna take a drive someplace.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...and what happens there?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What happens there is we're gonna play a little game. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Winner takes all; </Text>
      <Text>loser ends up in a flood-drain, sort of thing. I'm still formulating it in my head. Now, the deck might be tilted in my favor, you can expect that, but you'll have a fair shot.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Or we can sunset this day of ours</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. But then, you won't see me coming. You</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> won't</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> know the when or the where...</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">but</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> I will be coming for you Ray.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> I can promise you that.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray says nothing. They sit in silence. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Besides, I know you want a pop at me Ray. I can smell it off of you. Take me out, and this whole nightmare will be a pocket universe, vanishing in a second. Like it never happened.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray's phone begins to buzz.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> Ray ignores it, but Ned is curious. He</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> inspects the caller</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> ID</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Eva</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. Who's Eva?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">The phone continues to buzz. Ray is unsure what to do with this information. Ned raises the phone.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">I can take it and find out-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">-Lucky's wife. Eva is Lucky's wife.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Guy you killed? Why's she wanna talk to you?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">The phone continues to buzz.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">It's about a settlement</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> for the crash. We settle, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I can race again.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">So you wanna take it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">The phone continues to buzz. Eventually, Ray nods. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">tosses the phone to Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> and unlocks the doors.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I like that. You still think you'll make it out of here. All to play for.</Text>
    </Paragraph>
    <Paragraph Number="126" Type="Scene Heading">
      <SceneProperties Length="2 1/8" Page="57" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="EVA"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
          <CharacterArcBeat Name="TRUCKER"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">gets out, unsteady on his feet. He</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> takes the call</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> and walks</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> towards the shoulder</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> of the road.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Hey you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">I thought you wouldn't pick up. You never pick up.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray raises a hand to Lory in the Mustang, indicating he's OK. He walks to the chain-link fence. Rests against it. Like a prisoner against the mesh of the prison yard.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">It's been a long time. Not since...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">...the funeral.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I wanted to call but my lawyers... I </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">know I </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">should have called</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">-I'll sign the fucking settlement OK? Whatever you tell me. But I just want the truth. That's all I want. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">takes a moment, summoning something inside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">I'd been holding onto that wheel for two hundred laps. No power steering in those boxes. My muscles were aching. They were numb, Eva. One twinge of nerves is all it took. Soon as the carts clipped... it was over. Listen, I'd never want to harm Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">EVA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">I just... I</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic"> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">can't get out my head this idea... that </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">the crash might have </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">had</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic"> something to do with me.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic"> With us.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">That's garbage. You</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> -</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Underline">we</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, we</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> had nothing to do with </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">You promise me that Ray? You swear it was an accident?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">He closes his eyes. Summons something inside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I swear to you. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">On my life</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Eva</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> breathes in to say something, then clicks off. Ray isn't sure he's convinced her.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> Hell, he's not sure he even cares.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He opens his eyes and sees the Trucker leaning by the Mustang. She emerges, lighting a cigarette she has bummed from Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Union rules. Hope you don't mind me bumming a smoke. We're not meant to keep them in the cab.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">The less she smokes, the better.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">There is a monster... at the periphery... who must be confronted.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">(stopping)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Say again?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Theme of my book, I think. But I guess that's the same with every story, isn't it? The Minotaur. The shark. The wolf at the edge of the flock. The shadow. You can only ignore them so long before-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">(sharpening)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">-you have to strike them dead.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Amen, brother.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> looks at the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, then Lory.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> M</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ak</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> a decision</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray walks up to</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Ned's window.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> Taps the glass. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">The glass winds down. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray leans </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">in close to Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. A hint of dominance.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I do this thing you're talking about... I parry with you...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">...you parry, and I keep it between the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">me</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">. But if I have to hunt you </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">down </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">to find my satisfaction....</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">He nods towards Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Let's</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> keep it to the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">me</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned spits in his hand and extends it for a handshake. Ray stares at the hand, not wanting to touch it.</Text>
    </Paragraph>
    <Paragraph Number="128" Type="Scene Heading">
      <SceneProperties Length="1" Page="59" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray cleans his deal-hand with wipes. Cars begin</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ning</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> to move</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">When?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Once the jam clears.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">The jam's clearing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> now</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I can see that.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> I can see it's clearing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He'll kill you-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He'll try. But I intend to intercede in that matter</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">We could just drive away-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">-and be looking over our shoulder the rest of our lives? No. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Underline">No</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. I got a chance to fix things. This ends, tonight.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I don't want to leave you. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where I'm going, you can't go.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'll call, later. It'll be over.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And if you don't?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That won't happen, OK? I'm gonna see you before the night </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">is done</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He thumps his heart. She thumps hers</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You're a good kid. Once this is all over we're gonna talk about </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">turning</Text>
      <Text> things around, OK?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She kisses his cheek and gets out, suppressing tears.</Text>
    </Paragraph>
    <Paragraph Number="131" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="60" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">slots a </Text>
      <Text>key in</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">to</Text>
      <Text> a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> carbon-steel </Text>
      <Text>handcuff. He glances up to see Lory exiting the Mustang. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned</Text>
      <Text> grunts in satisfaction. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Game on</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="132" Type="Scene Heading">
      <SceneProperties Length="1" Page="60" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEB"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Lory filter through traffic</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. H</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">is</Text>
      <Text> phone rings.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">
Finally, he answers it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">AMAZING NEWS</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">, Ray - amazing news.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> Eva just signed the deal.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She did, huh.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">The number is higher but it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Italic">'</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">s in our range - look, the most important part is you're in the clear. It's all over. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic+Underline">You can race again</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The news leaves him utterly </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">bereft</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That's terrific. I knew you could pull it off.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Marco</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">'s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> booked a table at Booty's, we should go </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">pop some champagne.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know, maybe not tonight.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">You working on that mystery novel? Marco told me the premise. It sounds really neat... if you wanna do it as a movie, I got a producer friend who is a wiz at putting together contained thrillers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm still figuring out the ending. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Knock 'em dead in the third act. That's all that matters.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Intend to. Have one on Marco for me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He hangs up. Observes </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">more </Text>
      <Text>traffic </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">beginning to move</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="133" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="61" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. CRASH SITE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">The rotators Odysseus and Hercules </Text>
      <Text>pull away </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">skeletal car</Text>
      <Text> remain</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text>, clearing another lane.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Water hoses away debris.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Number="134" Type="Scene Heading">
      <SceneProperties Length="1 1/8" Page="61" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALICE"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">'s phone is ringing someone. The call is answered.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Your shoot wrapped?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">Like twenty minutes ago. I'm exhausted. Is </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Lory with you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She's near. Not too far.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Still in this jam. All by myself.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>There's silence.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Listen Ray, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Italic">I gotta go sort a ride for the airport-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I wanted to say I'm sorry.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">For what.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For fucking it all up. We had something good going-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">-Ray, you don't need to-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-and I made sure I broke it so bad it couldn't be fixed. I'm sorry for that. You didn't do anything to deserve it... or what you did do doesn't compare to what I did.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Jesus Ray, you doing AA or something? Is this a confessional?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We did good with Lory though. I know she's on a rough stretch, but she was the one good thing to come out of the whole shitshow that was us.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He cries, suppressing his gasps. Tears run down his face.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Ray... are you OK? I'm getting worried</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Italic"> here.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: Ned is approaching the car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm good. It's all good. I gotta go.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">H</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">e</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> heels away the tears, </Text>
      <Text>hardens up.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Getting ready.</Text>
    </Paragraph>
    <Paragraph Number="136" Type="Scene Heading">
      <SceneProperties Length="7/8" Page="62" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. / EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned saunters </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">up </Text>
      <Text>to Ray's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">window</Text>
      <Text>. Peering in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Keys.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We can't leave the Mustang here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Not planning to. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Keys</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray reaches for the keys and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">hands</Text>
      <Text> them </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">over</Text>
      <Text>. Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">takes them... and </Text>
      <Text>slaps a handcuff on </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray's</Text>
      <Text> wrist and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">puts the other </Text>
      <Text>cuff </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">on</Text>
      <Text> the wheel</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey, what the fuck is this-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">M</Text>
      <Text>y game</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">...</Text>
      <Text> my rules. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Time comes I'll cut you loose. I said you'd have a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">fair </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">shot, didn't I? Now, open the hood for me</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray chafes at the cuffs. There's nothing he can do.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I said open the hood for me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hits the hood release and Ned walks around to inspect it. He pulls the cables out of the acid battery. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">He comes around the car window again.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Any</Text>
      <Text> tow cables?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">You're w</Text>
      <Text>elcome to dig around the trunk</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">, Ned.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned walks towards the crash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Don't go anywhere.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray</Text>
      <Text> watches Ned go car to car. He's got </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">his</Text>
      <Text> wallet out, offering cash</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> for tow rope</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s, looking for a seller.</Text>
    </Paragraph>
    <Paragraph Number="137" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="63" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. CRASH SITE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Traffic begins to move faster as a SECOND LANE opens. Police office</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">r</Text>
      <Text>s guide traffic through </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the underpass</Text>
      <Text> with flares.</Text>
    </Paragraph>
    <Paragraph Number="138" Type="Scene Heading">
      <SceneProperties Length="1 1/8" Page="63" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The 18-wheeler begins to move. Trucker waves at Ray as she departs. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He</Text>
      <Text> raises his free hand </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">to bid </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">adieu</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>when-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>-his passenger-side door opens. No one there... except LORY. Crouched low, scooping herself inside, closing door behind. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Get the hell out of here-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She sees Ray is cuffed to the wheel.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's going to do to you what he did to that guy in the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Sedan</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He's going to be back any second. </Text>
      <Text>I told you to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">leave</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Underline">I'm not leaving you</Text>
      <Text>. How do I get you out of the cuffs?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He can see Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">in the distance,</Text>
      <Text> still going car to car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's got the keys on him. But there's a toolbox. Look for a hacksaw. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Or </Text>
      <Text>anything I can stab with.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She pulls her switchblade from her pocket.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. You keep that. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Go</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She gets out. Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">keeps </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">eyes</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> on Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">, turns to:</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: Lory approaching the Dodge. She opens the backseat door and gets inside. The door closes behind her.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Ned hand over cash</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> to a DRIVER. The Driver gets out of his car,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> and opens the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: Lory is unseen behind the tint glass.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray sees the Driver ahead taking out TOWING CABLES from his trunk. Handing them to Ned. Exchanging civilities.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray p</Text>
      <Text>ush</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">es</Text>
      <Text> on the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">light indicators</Text>
      <Text> desperately.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">REARVIEW: Lory opens the door holding a hacksaw. She sees something and closes the door again, disappearing inside.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray looks forwards... NED IS RETURNING.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> He passes by the Mustang, not acknowledging Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW: </Text>
      <Text>Ray watches Ned get inside the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tell me you got out. Please tell me you got out...</Text>
    </Paragraph>
    <Paragraph Number="139" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="64" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned starts the engine. Indicates and eases the Dodge forward, overtaking the Mustang.</Text>
    </Paragraph>
    <Paragraph Number="147" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="64" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. FREEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned parks the Dodge in front of </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">the </Text>
      <Text>Mustang. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">The two vehicles an</Text>
      <Text> island of stillness </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">among</Text>
      <Text> slow-</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">moving</Text>
      <Text> traffic. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Next, </Text>
      <Text>Ned gets out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> and fixes</Text>
      <Text> the tow cables</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> to the Mustang</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="148" Type="Scene Heading">
      <SceneProperties Length="5/8" Page="64" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="Bold+AllCaps">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">As Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">bends, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Ray scans the Dodge for signs of Lory</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> in the rear window</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> of the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Lory raises her head above the back-window. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">Sees Ray</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned stands</Text>
      <Text> -- she ducks down</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. She was almost caught.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned saunters back to Ray's window. He mounts Ray's phone on the dash, then </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">holds </Text>
      <Text>out his own phone.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Type in your number.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(off Ray)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It ain't for dinner and a show.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray types the number in. Ned dials it. Ray's phone rings. Ned pings it to answer, sets it </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">on</Text>
      <Text> speaker. The voice echo</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">e</Text>
      <Text>s as Ned talks, filtered via phone</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> speaker</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So as we're in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">communicado.</Text>
      <Text> Make sure the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">call</Text>
      <Text> don't break, else I'll assume you</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">'re </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">using the line for something else.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray watches </Text>
      <Text>Ned walk </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">back </Text>
      <Text>to the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> and get in. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">The Prius overtakes and passes him. Ray peers into the driving seat, and makes eye contact with Walt.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Walt wipes sweat from his brow and accelerates past the Dodge, tires squealing. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Gone, leaving Ray alone.</Text>
    </Paragraph>
    <Paragraph Number="150" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="65" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Twisting </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">the </Text>
      <Text>ignition, easing the Dodge forward</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">
Hidden beneath a blanket, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Underline">Lory</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> feels the Dodge accelerate. </Text>
    </Paragraph>
    <Paragraph Number="150A" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="65" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. TIGHT ON TUG &amp; TOW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The tow cables grow tight and pull the Mustang forward.</Text>
    </Paragraph>
    <Paragraph Number="150B" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="65" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned tilts his rearview, bringing Ray into view.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You in my rearview now, boy.</Text>
    </Paragraph>
    <Paragraph Number="150C" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="65" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. MUSTANG &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray watches the crash site </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">draw</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> near.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Carris eyeball</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> them with suspicion</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. She begins to pad towards them.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">NED (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Italic">Best make sure she don't see them cuffs, killer. Else the whole jig gets a lot more complicated.</Text>
    </Paragraph>
    <Paragraph Number="151" Type="Scene Heading">
      <SceneProperties Length="1" Page="65" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CAPTAIN"></CharacterArcBeat>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. CRASH SITE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris moves towards th</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">e </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">tug-tow </Text>
      <Text>procession. Traffic's slow enough that she </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">can pace </Text>
      <Text>alongside Ned's window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Kind of you to show some charity.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can't let a misunderstanding get in the way of a good deed.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Was he</Text>
      <Text>ading to a service station </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">anyway</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, to fix the windshield.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris slows and walks alongside the Mustang's window. Ray covers his cuffed hand and acts relaxed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Lory</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Bailed </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">and hitched a ride</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> when the engine went</Text>
      <Text>. Don't think she fancied </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">the company of </Text>
      <Text>our towing partner</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CAPTAIN (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(thru radio)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Carris! I want lane three opened immediately...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Surprised the engine crept up on you. She looks taken care of.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Happens all the time with model cars. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">The p</Text>
      <Text>rice of singular beauty is it's a boondoggle finding spare parts.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CAPTAIN (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Carris, lane three, right now!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Carris</Text>
      <Text> slows and lets the Mustang and Dodge </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">outpace her</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">In the side-mirror, Ray watches Carris pick up a piece of guardrail</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">. She </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">inspect the holes in it. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">L</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">ooks up to</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> gap in the overpass above, into the shadow of which Ray passes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray observes a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Santa Muerte</Text>
      <Text> doll, charred and tinged with blood</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">, flicker</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">ing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">under</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> the shadows of passing traffic.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray watches Ned indicate right. Turning onto the OFF-RAMP.</Text>
    </Paragraph>
    <Paragraph Number="156" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="66" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. DODGE &amp; MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">...leaving the freeway and entering the veins of L.A.</Text>
    </Paragraph>
    <Paragraph Number="157" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="66" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. LOS ANGELES -- BACK STREETS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dodge </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">tows</Text>
      <Text> Mustang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
      <Text>down an empty side-street.</Text>
    </Paragraph>
    <Paragraph Number="158" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="67" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- BACK STREETS</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mind telling me where we're going?</Text>
    </Paragraph>
    <Paragraph Number="159" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="67" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- BACK STREETS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory under the blanket, listening.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps"> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, somewhere fun. Believe me. </Text>
    </Paragraph>
    <Paragraph Number="161" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="67" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG -- SIDE STREET</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray peers out at the dark, quiet streets. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">A s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">ense of doom.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>-FLASHING BLUE LIGHTS </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">stab</Text>
      <Text> inside his vehicle. </Text>
    </Paragraph>
    <Paragraph Number="162" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="67" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- SIDE STREET</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's eyes shoot to wing-mirror... Carris has caught up </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">with</Text>
      <Text> them, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">siren </Text>
      <Text>light</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">s</Text>
      <Text> flashing on </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">her</Text>
      <Text> Harley.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Didn't think she'd let me leave without saying goodbye...</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Number="163" Type="Scene Heading">
      <SceneProperties Length="4/8" Page="67" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. UNDERPASS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">slows and parks under the</Text>
      <Text> shade of an underpass.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris pulls up behind them - keeping her distance. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Street lights flickering on.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Quiet. N</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">o other through traffic</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">steps</Text>
      <Text> out of the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Dodge</Text>
      <Text>, keep</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text> his front towards Carris.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What grounds you got for this stop?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">unclip</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">s</Text>
      <Text> her </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">bodycam</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
      <Text> She smashes in</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">a </Text>
      <Text>tail light</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> on the Dodge</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> Slots baton away. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Now s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">he </Text>
      <Text>pulls on latex gloves</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. Ned</Text>
      <Text> lifts</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text>arms</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> with a smile.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""> (</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">cont'd</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Didn't need to go breaking my lights to</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">gimme</Text>
      <Text> the reach-a-round.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She ignores him and opens the rear </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Dodge</Text>
      <Text> passenger door. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="68" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">INT. DODGE -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris</Text>
      <Text> feels around the rear, looking for something.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text>Lory keeps very still</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> under the blanket</Text>
      <Text> as the car is searched.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">finds what she wants - </Text>
      <Text>the impact wrench. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="68" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">EXT. UNDERPASS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris walks to the guardrail and angles the impact wrench against a cross-bolt.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">She </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">queezes the trigger and t</Text>
      <Text>he bolt </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">shoots out. The rail disconnects and slumps to the dirt.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="68" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">INT. DODGE -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Carris drops </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">the wrench on top of the blanket</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. </Text>
      <Text>Lory suppresses a gasp</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> as it hits her</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2" Page="68" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CARRIS"></CharacterArcBeat>
          <CharacterArcBeat Name="DISPATCH"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">EXT. UNDERPASS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Now Carris approaches Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, unclipping her Beretta.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You saw Booles come from the crash site. And </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">then </Text>
      <Text>he got in the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> behind you</Text>
      <Text>, and the driver vanished. I bet the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">d</Text>
      <Text>river looked like this. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Carris</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">holds</Text>
      <Text> out her phone and shows a picture of the Skinny </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Guy</Text>
      <Text> - CLYDE. Ray says nothing. He looks to Ned, then her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">A</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">nd</Text>
      <Text> I think I know where Clyde</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">'s been</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> all this time</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">(a beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Open the trunk for me Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'd let this go, Officer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Open the fucking trunk Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm afraid that won't be possible.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray</Text>
      <Text> reveals </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">his </Text>
      <Text>hand</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> is cuffed</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris backs into space </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">and pulls her Beretta on Ned </Text>
      <Text>and taps her radio all at once.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thirty-four Mary nine, requesting a code three. Confirm.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A burst of static.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ke</Text>
      <Text>ys</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Right pocket. You can fish 'em out, just mind the tackle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">DISPATCH</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Code Three confirmed. Sending units.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Throw them onto the ground.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned</Text>
      <Text> throws them into the d</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">irt</Text>
      <Text> in front of </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">her</Text>
      <Text>. She stoops to pick them up, gun </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">always </Text>
      <Text>on Ned.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Carris</Text>
      <Text> moves to the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Mustang's trunk</Text>
      <Text>. Keys find lock.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let it go. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Underline">Please</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris opens the trunk, sees inside... t</Text>
      <Text>a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">ps</Text>
      <Text> radio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I got</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text>a D-B here, where</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">'s </Text>
      <Text>the fucking units</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="AllCaps">DISPATCH</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Units proceeding. Two minutes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Distant sirens can be heard. Getting nearer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Y</Text>
      <Text>ou check </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">his </Text>
      <Text>leg yet?</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> You should really check his leg.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">-SHUT YOUR MOUTH AND DON'T MOVE.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris observes a BULGE in Clyde's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">pant</Text>
      <Text> leg.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> She </Text>
      <Text>reaches with her free hand and pulls at </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">the hem</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ma'am, it was self-defense...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">We</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">begin to </Text>
      <Text>track down the back of </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned's</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">shirt...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">...s</Text>
      <Text>elf-defense</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">,</Text>
      <Text> 'cos he had a gun.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">... and we see N</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">e</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">d has a GLOCK 9mm tucked behind his waist.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Carris finds Clyde has an EMPTY ANKLE HOLSTER.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned quickdraw</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s and Carris pivots too late.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned hits Carris with four rounds in arm and shoulder.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris </Text>
      <Text>empties a full auto-clip </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">-</Text>
      <Text>- 13 rounds in 0.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">7</Text>
      <Text> seconds</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> - a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">ll go</Text>
      <Text> wide of Ned,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> her </Text>
      <Text>ruined gun-arm unable to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">aim</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">She </Text>
      <Text>slumps against the Mustang trunk for cover. Blood smears against the white bodywork.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She finds her gun-arm is a gory mess. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris's working arm</Text>
      <Text> ejects a magazine, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">clamps</Text>
      <Text> the receiver between her knee</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">caps</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> and</Text>
      <Text> slots a fresh magazine</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">She p</Text>
      <Text>umps to load it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She swings the gun around the side of the car. Ned breaks around the Dodge for cover. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">sprays</Text>
      <Text> a mag full auto</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned ducks behind the engine block.</Text>
    </Paragraph>
    <Paragraph Number="164" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="70" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- ON LORY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Back windows blow in and Lory is showered with glass.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="70" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris is </Text>
      <Text>in total concentration as she reloads</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> one-armed.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned's shadow lengthening on the driver's side. Closing.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She pumps the receiver</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> to load</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">turns</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">head </Text>
      <Text>to aim-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">To find she is l</Text>
      <Text>ooking straight into the barrel of </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">a</Text>
      <Text> gun. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned fires, point blank.</Text>
    </Paragraph>
    <Paragraph Number="167" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="70" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- SID</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">E-</Text>
      <Text>MIRROR</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Carris's </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">dead </Text>
      <Text>body slump against the road.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">N</Text>
      <Text>ed</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> stands over her and </Text>
      <Text>toes </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">her face, revealing</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">p</Text>
      <Text>arts of her </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">head</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">are</Text>
      <Text> missing. Ned bursts into laugh</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">t</Text>
      <Text>er</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, relieved.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ho-ly shit Ray! Girl packing a full-auto Beretta! Can you believe it?</Text>
    </Paragraph>
    <Paragraph Number="171" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="71" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- ON LORY</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Another half-second, she would have had the inch on me. Finito!</Text>
    </Paragraph>
    <Paragraph Number="172" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="71" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. UNDERPASS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sirens echo loudly in the underpass. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">is all business. He </Text>
      <Text>takes Carris's Beretta</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. Y</Text>
      <Text>anks the magazine clip </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">free </Text>
      <Text>from her belt.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> Pulls her police r</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">adio</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Number="173" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="71" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned dumps </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">guns on the</Text>
      <Text> passenger seat and gets the engine started. Lory still hiding under the blanket.</Text>
    </Paragraph>
    <Paragraph Number="174" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="71" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge pulls the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Mustang</Text>
      <Text> forward. Rearview, Ray can see Carris's body, left like trash on the roadside.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="AllCaps">FADE TO:</Text>
    </Paragraph>
    <Paragraph Number="176" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="71" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. L.A. SKYLINE -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">SOARING</Text>
      <Text> OVER freeways and glittering lights...</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> moving through the industrial outer areas of the City.</Text>
    </Paragraph>
    <Paragraph Number="177" Type="Scene Heading">
      <SceneProperties Length="5/8" Page="71" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps">INTERCUT -- MUSTANG &amp; DODGE</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold+AllCaps"> -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">listens to dispatch chatter on </Text>
      <Text>Carris's police radio</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No APB for me or you Ray. Stakes ain't changed. All to play for.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>In the back seat, Lory lifts the blanket</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. She eyes t</Text>
      <Text>he impact wrench</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, strobed by passing streetlights.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">I'm b</Text>
      <Text>eginning to wonder if our parlay </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">won't</Text>
      <Text> be some sort of draw. That was </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">some </Text>
      <Text>pro-shooting back there.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">..</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Truth be told, I came second at a rodeo quickdraw once, in Calgary.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, I ain't much with a gun, Ned-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-don't bullshit me Ray. Cali celeb like you spent time on the range. And I only finished second in that rodeo.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned speaks quietly, so Ray can't hear. But Lory can.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Least until he got back to his motel. Weren't so fast then.</Text>
    </Paragraph>
    <Paragraph Number="179" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="72" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. QUIET STREET -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge parks in front of undeveloped land. Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">gets out, leaves headlights on</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, illuminating</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> pavement and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> manhole.</Text>
    </Paragraph>
    <Paragraph Number="180" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="72" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Ned pass his window, tightening black gloves. He makes his way around to the Mustang's trunk. Opens it.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
      <Text>Ned stick</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">s</Text>
      <Text> a tire-iron in his jeans and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">pulls</Text>
      <Text> Clyde's body out</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> of the trunk</Text>
      <Text>. He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">drag</Text>
      <Text>s Clyde towards the manhole.</Text>
    </Paragraph>
    <Paragraph Number="181" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="72" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- ON LORY UNDER BLANKET</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">leans up</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">reaches</Text>
      <Text> for the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">i</Text>
      <Text>mpact </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">w</Text>
      <Text>rench.</Text>
    </Paragraph>
    <Paragraph Number="182" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="72" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray sees movement in the back of the Dodge -- LORY. He panics, whispers out--</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic+Underline">Get the hell down.</Text>
    </Paragraph>
    <Paragraph Number="184" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="72" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MANHOLE -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned glances </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">back</Text>
      <Text>, just missing </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Lory</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Seeing nothing, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned</Text>
      <Text> continues to drag Clyde's body to the manhole. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">He h</Text>
      <Text>itches open the steel cover with the tire iron.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Drops Clyde down. A delayed splash and thud.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So long, Clyde.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">pulls</Text>
      <Text> the manhole cover into place, now a tombstone for Clyde. It reads "CITY OF L.A." and "MADE IN MEXICO".</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="73" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps">INTERCUT -</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps"> DODGE &amp; MUSTANG</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps"> -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">is driving. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The strange pop song</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">is playing on the radio, midway through the song</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="6" Size="12" Style="">Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> begins to sing with it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">Got to say it hurts to see you go... got to say it hurts to see you go...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">In the back, </Text>
      <Text>Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">holds </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Underline">the impact wrench</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> close to ches</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">t.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">I got a question for you Ray. Why was the phone number of your teammate's wife</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">...</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> saved on your phone?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He wasn't my teammate.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">He was. Until he wasn't. And is that why he wasn't? You cucked him in the bed-room, so he switched teams so as he could cuck you on the track?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lory listening. Her heart getting broken.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Must be a complex feeling, watching a young buck about to achieve a very thorough revenge. Oh c</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">ome on Ray, I've told you mine, you can tell me yours.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> You wanted to kill him.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray, spaced out. Confessing. Knowing </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Lory</Text>
      <Text>'s listening.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Sure. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">I wanted to kill him. </Text>
      <Text>For</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> a fraction of a second</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">A tear gathers on Lory's cheek.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But when you're driving two hundred twenty miles an hour, that's all it takes. And that's all it took.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Time's arrow, Ray. That burns bed was waiting for Lucky when he woke up</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> that day</Text>
      <Text>. He just didn't know it.</Text>
    </Paragraph>
    <Paragraph Number="186" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="73" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Bold+AllCaps">SLIPWAY</Text>
      <Text> -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">'s wheels grind</Text>
      <Text> over earthwork ramps</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="187" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="74" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looking through the windshield. A faded sign for</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">RIVERSIDE INTERNATIONAL RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">... </Text>
      <Text>and we RISE UP to take in the vast, crumbling, open ARENA... part reclaimed by the desert.</Text>
    </Paragraph>
    <Paragraph Number="190" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="74" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A dust cloud follows the Dodge as it circles wide and comes to stop in the middle of the dark, deserted space. </Text>
    </Paragraph>
    <Paragraph Number="191" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="74" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned pulls to a halt</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">, engine still running. As he reaches for the handbrake...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... the impact wrench is shoved against his neck.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW: Lory emerges from the blanket holding the trigger.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Was wonderin' if you were gonna slink around there all night.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="74" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray wrenches at the wheel. His cuff-wrist becomes bloodied.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">LORY, GET OUTTA THERE! MOVE!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="74" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Underline">Lory presses the head</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline"> against the back of Ned's spine</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned</Text>
      <Text> doesn't move. Just eyes on the rearview, looking at her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>G'ahead. Put it right here. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned star</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">es</Text>
      <Text> at Lory's eyes in the rearview.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Two notches up on the spine, I still get to use the toilet. One more up and I'm just a head on a stick.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The nozzle of the impact wrench travels higher.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">plants the wrench to Ned's skull</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now that there, that'll kill me straight out. One 'lil squeeze.</Text>
    </Paragraph>
    <Paragraph Number="196" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="75" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">thrash</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">es</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> at </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">his</Text>
      <Text> steering wheel</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="197" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="75" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Trouble with women when it comes to violence</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">? T</Text>
      <Text>hey know what needs doing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> but</Text>
      <Text> they hesitate</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> when it comes to.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Watch me, you piece of shit-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned hits the accelerator. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory is </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ripped</Text>
      <Text> backwards just as she squeezes the trigger. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The hammer </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ejects...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">...coming an inch short of</Text>
      <Text> Ned's neck.</Text>
    </Paragraph>
    <Paragraph Number="198" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="75" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. DODGE &amp; MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The tow is snapped tight by the acceleration</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="198A" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="75" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">The Dodge is shoved forward by the tension of the tow. </Text>
      <Text>Lory's face INTO THE BACK OF THE IMPACT WRENCH</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> spins and</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">SMASHES LORY IN THE FACE</Text>
      <Text> with </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">fist and </Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="AllCaps">CUT TO BLACK</Text>
    </Paragraph>
    <Paragraph Number="199" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="75" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's hand </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">is zip-tied to</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">window </Text>
      <Text>grab handle</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned takes her other </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">hand </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">and zip-ties it </Text>
      <Text>to the safety belt.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">She is drowsy; her face bruised, bloody swollen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>After I'm done with your daddy... we'll get to spend some time together. Lest he wins this thing?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lory</Text>
      <Text> spits in his face. Saliva and blood. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">For a moment Ned doesn't react; he lets the mixture lie there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He </Text>
      <Text>wipes his face with gloved hand</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">. </Text>
      <Text>Uses his thumb to paint blood onto her lips. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Lory</Text>
      <Text> turns her head away desperately.</Text>
    </Paragraph>
    <Paragraph Number="200" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="76" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">watches</Text>
      <Text> in mute horror</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> and rage</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>Drifting down we see his wrist is red and raw. But his hands are working under the dash. He has pulled out the ignition wires.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He sees Ned get out of the Dodge. Undo the tow rope. Ray's hands stuff the ignition wires back in place</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> to hide them</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ned is</Text>
      <Text> coming towards hi</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">m,</Text>
      <Text> taking Glock out of his pants.</Text>
    </Paragraph>
    <Paragraph Number="203" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="76" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory slinks sideways in the seat. Trying to get her hip pocket close to the hand restraint.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> Something inside it.</Text>
    </Paragraph>
    <Paragraph Number="204" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="76" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Bold+AllCaps">RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned stands back and speaks loudly; the master of ceremonies.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Here's the rules, everybody. Best pay attention. Way I figure it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Ray,</Text>
      <Text> you probably got the edge </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">on me </Text>
      <Text>behind the wheel, but I got edge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> on you</Text>
      <Text> behind the trigger.</Text>
    </Paragraph>
    <Paragraph Number="204A" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="76" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold+AllCaps">DODGE</Text>
      <Text> -- ON LORY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's fingers pull the switchblade out of her pocket.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what we're going to do is some </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">role reversal</Text>
      <Text>. I'm gonna be in the Dodge. Your baby girl's gonna be sitting right next to me.</Text>
    </Paragraph>
    <Paragraph Number="204B" Type="Scene Heading">
      <SceneProperties Length="7/8" Page="76" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now you, Ray, you is gonna be foot-loose. And I'm gonna be driving. And I'll be coming for you again and again. But you'll have this.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned ejects the mag, displays </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">it</Text>
      <Text> to Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Fou</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">r</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> rounds. Now y</Text>
      <Text>ou sure you </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">remember</Text>
      <Text> to use it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">G</Text>
      <Text>ive it here a moment</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">(grinning)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">That's the spirit.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned drops the mag into the dust, then flings the gun </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">deep into the race track. He</Text>
      <Text> returns to the Dodge. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No safety on a Glock. Slap that mag in, chamber a round, you hot to trot.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ned takes out the baggie of coke and tips a heavy line on the arch of forefinger and thumb. He snorts it and guffaws.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Now he tips some more onto the arch and offers it to Ray. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">C</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">are for the old pre-race ritual Ray? </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Or pass</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> up the edge just to spite me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Ray moves his head towards Ned's hand. Baring teeth. As if he's going to take a big bite.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Fuck it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">snorts the line.</Text>
    </Paragraph>
    <Paragraph Number="205" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="77" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- SIDE MIRROR</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Lory </Text>
      <Text>has been sawing the restraint with </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">the switchblade</Text>
      <Text>. She covers it with her hip as Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">wades towards her and gets in.</Text>
    </Paragraph>
    <Paragraph Number="206" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="77" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">drives the Dodge alongside the Mustang window. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">He </Text>
      <Text>tosses the handcuff key</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. It lands somewhere inside the dark compartment. </Text>
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">scrambles</Text>
      <Text> to find it</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Game 'on, killer.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned floors the Dodge and revs in a wide circle.</Text>
    </Paragraph>
    <Paragraph Number="207" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="77" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's head getting whipped about as it bumps over dust.</Text>
    </Paragraph>
    <Paragraph Number="208" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="78" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray frantically searches for the handcuff key. Headlights flood</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text>the Mustang with light. He finds the key...</Text>
    </Paragraph>
    <Paragraph Number="209" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="78" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge gathering ramming speed. Mustang dead ahead.</Text>
    </Paragraph>
    <Paragraph Number="210" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="78" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray snaps the cuff off, tumbles out of the car.</Text>
    </Paragraph>
    <Paragraph Number="211" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="78" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray rolls away from the Dodge's path -- just missing him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Woo-hoo, this is fun!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's knife slips from her hand. She traps it with her buttocks, reaching for it with her restrained hand...</Text>
    </Paragraph>
    <Paragraph Number="212" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="78" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray finds the magazine clip in the dirt... runs towards where Ned threw the gun. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">It is </Text>
      <Text>difficult to see</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> in the dark</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>In the distance, the headlights are turning </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">back</Text>
      <Text> again.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> Headlights growing brighter.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray sees a glint of the Glock in</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> dirt</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He grabs at it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge rac</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">es </Text>
      <Text>towards him... </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray dives out of the way, just missing it.</Text>
    </Paragraph>
    <Paragraph Number="213" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="78" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>ALMOST! I'm getting the hang of this. He the Matador and I'm the bull.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory has got her hands on the knife again.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> Gripping it.</Text>
    </Paragraph>
    <Paragraph Number="214" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="78" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray inserts the magazine in the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">G</Text>
      <Text>lock, chambers a round. Aims... tracking the Dodge as it circles </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">back</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="215" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="79" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned looks at Lory. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fun part ain't the knocking down. It's the William Tell element. I'm the apple and you're his sweetheart and he's got to keep his aim true.</Text>
    </Paragraph>
    <Paragraph Number="216" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="79" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray stands t</Text>
      <Text>wo</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">-</Text>
      <Text>handed</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> with a strong stance - clearly </Text>
      <Text>he's done some shooting. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">H</Text>
      <Text>eadlights </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">bear down on him.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray </Text>
      <Text>aims as it comes closer... at the engine block. Waiting... waiting... Lory's outline inside...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Fires twice---</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The bullets spark on the engine block... Ray dives late</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... his shoulder</Text>
      <Text> is hit by the wing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">-</Text>
      <Text>mirror. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">spins and hits the dust, badly hurt.</Text>
    </Paragraph>
    <Paragraph Number="217" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="79" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned circles around, commentating to Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Engine block</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">'</Text>
      <Text>s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text>a waste</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> of ammo</Text>
      <Text>. Two</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> rounds</Text>
      <Text> left.</Text>
    </Paragraph>
    <Paragraph Number="218" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="79" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray nurses his shoulder. It aches, but he can still lift his gun. He evaluates what to do. Looks to the Mustang. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">An idea</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="219" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="79" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned gunning for him.... swerving left as Ray DIVES....</Text>
    </Paragraph>
    <Paragraph Number="220" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="79" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sprinting to the Mustang, slotting gun in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">waist</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ray</Text>
      <Text> dives into the Mustang.</Text>
    </Paragraph>
    <Paragraph Number="221" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="79" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Rays reaches for the headlight toggle switch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Sitting duck in there Ray....</Text>
    </Paragraph>
    <Paragraph Number="222" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="80" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">FLOODLIGHTS fill</Text>
      <Text> the Dodge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> with light</Text>
      <Text>. Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">is </Text>
      <Text>blinded</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">...</Text>
    </Paragraph>
    <Paragraph Number="223" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="80" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Getting out of the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Mustang</Text>
      <Text>, dropping to an aiming position.</Text>
    </Paragraph>
    <Paragraph Number="224" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="80" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's eyes have adjusted to the light... searching for Ray.</Text>
    </Paragraph>
    <Paragraph Number="225" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="80" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Flood</Text>
      <Text>lights </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">illuminate</Text>
      <Text> the inside</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> of the Dodge</Text>
      <Text> for Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, who drops to a crouching aim.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">LORY GET YOUR HEAD DOWN</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Number="226" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="80" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory ducks. Ned imitates her, swerves blind and wide as-BULLETS EXPLODE THE REAR PASSENGER WINDOWS.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A shower of glass. Ned keeps his head down, accelerates blind into a bluff of sand. </Text>
    </Paragraph>
    <Paragraph Number="229" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="80" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY -- ON THE DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Stalling out, coughing dust.</Text>
    </Paragraph>
    <Paragraph Number="230" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="80" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned sticks his head up. Dusts some glass from his shoulder as he scans for Ray. He yanks Lory by the hair and holds her</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> head</Text>
      <Text> up</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> against the rest</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Them's his last two shots. He just blew his whole load. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Now I finish it.</Text>
    </Paragraph>
    <Paragraph Number="231" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="80" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold+AllCaps"> </Text>
      <Text>-- ON THE DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge reverses, doing a U-turn...</Text>
    </Paragraph>
    <Paragraph Number="232" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- THRU WINDSHIELD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Headlights scan the darkness, finding RAY</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> at the Mustang</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Number="233" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Attaching the cables </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">for the acid battery.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> Closing hood.</Text>
    </Paragraph>
    <Paragraph Number="234" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned speeds towards Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">. 
Lory saws the zip-tie... breaking open.</Text>
    </Paragraph>
    <Paragraph Number="235" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">rips out </Text>
      <Text>the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">ignition </Text>
      <Text>cables. Difficult to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">fuse </Text>
      <Text>in the dark. Headlights from the Dodge </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">fill the compartment.</Text>
    </Paragraph>
    <Paragraph Number="237" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Mustang is right in</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> Ned's sights</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">He ramps</Text>
      <Text> up a gear</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">
</Text>      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Underline">Lory's fist tightens on the knife</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Number="238" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">ignition </Text>
      <Text>wires spark and Ray gets the engine </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">going</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> He changes gear to reverse and floors</Text>
      <Text> the accelerator....</Text>
    </Paragraph>
    <Paragraph Number="239" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Mustang reverses in a cloud of dust. Gaining momentum. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">CONNECTS... but with low </Text>
      <Text>relative impact speed</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> as the Mustang is reversing.</Text>
    </Paragraph>
    <Paragraph Number="240" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray swinging the wheel, breaking from the Dodge.</Text>
    </Paragraph>
    <Paragraph Number="242" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="81" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned turns too late and overshoots the Mustang, driving into space. Ned grunts and tries to whip the wheel around when-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>LORY STABS HIM IN THE ARM.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Chaos in the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Dodge</Text>
      <Text> as Ned swings the wheel and Lory keeps stabbing. Arcing motions like her daddy taught her. </Text>
    </Paragraph>
    <Paragraph Number="243" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="82" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">drives towards the Dodge, seeing the fight inside.</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">The passenger door opens and -</Text>
    </Paragraph>
    <Paragraph Number="244" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="82" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">tumbles out and </Text>
      <Text>roll</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">s in the dirt.</Text>
    </Paragraph>
    <Paragraph Number="245" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="82" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Pulling door shut and steadying the wheel. He squeezes his gory arm, blood flowing down his skin.</Text>
    </Paragraph>
    <Paragraph Number="246" Type="Scene Heading">
      <SceneProperties Length="4/8" Page="82" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LORY"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. RACETRACK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">stops</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">beside Lory</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style=""> and opens the door. She seems OK.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Tell Mateo to g</Text>
      <Text>et the yard ready.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Indicate you heard me-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Get Mateo to get the yard read</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">y</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">...</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> Dad?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">is closing the door </Text>
      <Text>but waits for what she has to say.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">L</Text>
      <Text>ove you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Love you too.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray floors the pedal, gunning for the Dodge's trail. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory watches his tail lights </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">dim</Text>
      <Text>. The sound of the distant engines</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">fade</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">. She takes out her phone and-</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="AllCaps">SMASH CUT TO:</Text>
    </Paragraph>
    <Paragraph Number="247" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="82" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. RACEWAY -- SLIPWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">The Mustang accelerates up the slipway exit. 
It takes a corner, clipping the sidewalk.</Text>
    </Paragraph>
    <Paragraph Number="248" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="82" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray straightening her out. Steady, not breaking a sweat. Deadly focus as he sees THE DODGE in the distance.</Text>
    </Paragraph>
    <Paragraph Number="249" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. DODGE -- ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Headlights </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">bounce off</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> the rearview </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">into </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned's eyes. 
Ray rapidly gaining on him.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Up ahead </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Ned</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> sees a FLOOD CHANNEL ACCESS ROAD.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">
He accelerates towards it, turning blinding white.</Text>
    </Paragraph>
    <Paragraph Number="250" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Bold+AllCaps">ACCESS ROAD</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps"> GATE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">The Dodge SMASHES</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> through the gate.</Text>
    </Paragraph>
    <Paragraph Number="251" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">The Dodge jumps across the dusty access road. Back wheels hit side fencing, braking at the edge</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> of a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">flood channel.</Text>
    </Paragraph>
    <Paragraph Number="252" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned glances right at the perilous drop. Glad he didn't overshoot.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> His eyes</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> are lit by the rearview mirror - headlights</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> from the Mustang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="253" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray accelerat</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">es</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> to ramming speed.</Text>
    </Paragraph>
    <Paragraph Number="254" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Mustang smashing into the Dodge.</Text>
    </Paragraph>
    <Paragraph Number="255" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">is </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">ram</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">med</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">against the fencing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">Accelerat</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ing</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> forward.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Number="256" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Mustang gain</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> on the Dodge.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Up ahead the road bisects - one going uphill, the other downhill along</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">floo</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">d</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> channel. </Text>
    </Paragraph>
    <Paragraph Number="257" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. DODGE -</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="Bold+AllCaps">-</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps"> ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">lifting </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">Carris's</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> Beretta and aiming.</Text>
    </Paragraph>
    <Paragraph Number="258" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="83" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ray coming up alongside Ned, hunkered </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">low </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">in </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">his</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> cab, like a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">Comanche</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> slinging low on a horse.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">A FLASH OF GUNFIRE breaks out from the Dodge. Ray's Front windshield SPIDERS as a full auto clip is emptied.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Number="259" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="84" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Ned s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">wings wheel left and RAMS the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="84" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps">INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">Trying to keep control... a FENCE bisecting roads.
Ray yanks the wheel left...</Text>
    </Paragraph>
    <Paragraph Number="260" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="84" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Mustang</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style=""> turns into the</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> uphill path.
Dodge continues downhill alongside the flood channel.</Text>
    </Paragraph>
    <Paragraph Number="261" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="84" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="Bold+AllCaps">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Ned </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">c</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">heck</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">s</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> mirrors.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style=""> The Mustang is gone.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">
Looks like he's all alone. He cranks handbrake</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">, whips wheel.</Text>
    </Paragraph>
    <Paragraph Number="304" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="84" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge does a roundhouse sweep, facing where it came from. The engine</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> dies, leaving stillness and the dark.</Text>
    </Paragraph>
    <Paragraph Number="305" Type="Scene Heading">
      <SceneProperties Length="4/8" Page="84" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned takes his hands off the keys. He winds down the windows. The ambient sound of distant Los Angeles comes through. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>His eyes peer into the darkness of the dirt road ahead of him. This is where he expects Ray. Head-on.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>To his left flank is the flood channel, a vertiginous drop partitioned off by chain-link fence. To his right flank is a steep hill leading to the road above.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned checks the clips. All empty. He tosses the gun aside.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned waits. Seeps in the sounds of the night-time.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">His phone rings</Text>
      <Text>. It echoes into the darkness. He quickly answers the call to stop the ring</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">ing</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">A song comes through faintly... </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">the same one that has played throughout... a</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">s if filtered through a car radio. A silent occupant on the other end.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">That you</Text>
      <Text> Ray?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Silence from the caller.</Text>
    </Paragraph>
    <Paragraph Number="306" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="85" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. WRECK</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold+AllCaps">ING</Text>
      <Text> YARD -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A cube of scrap metal at the center of a compressor.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The compactor walls expand, and the WHITE MUSTANG begins to unfold like a metallic hypercube.</Text>
    </Paragraph>
    <Paragraph Number="307" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="85" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what you say we call it quits Ray? We cash-in and go our separate ways.</Text>
    </Paragraph>
    <Paragraph Number="308" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="85" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. WRECK</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold+AllCaps">ING</Text>
      <Text> YARD -- REVERSED </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory -- bruised, and MATEO (20, good-looking) -- unlock from an embrace. Ray watching them. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He returns his gaze to the expanding compressor. The Mustang expands and blood rushes inside the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Way I see it, we're in the clear. Clyde's been memory-holed. Cop didn't leave no notebook, and well - she ain't talking no more. </Text>
    </Paragraph>
    <Paragraph Number="308A" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="85" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Even if you get the inch on me, I got Lory's blood on me, the cop's blood, Clyde's blood.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">...</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Number="309" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="85" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">is upside down and </Text>
      <Text>burning on the flood channel floor. Lit by tail-lights of the reversing Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Italic">...t</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">he whole story is gonna be there to unpick, one DNA swab at a time for a County Coroner. </Text>
    </Paragraph>
    <Paragraph Number="311" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="85" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The burning Dodge. Ray holds out a jerry can, which catches gasoline as it arcs </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">away </Text>
      <Text>from the flames.</Text>
    </Paragraph>
    <Paragraph Number="312" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="86" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Mustang's trunk is opened by Ray. He rolls out Ned's bloodied body and closes the trunk.</Text>
    </Paragraph>
    <Paragraph Number="313" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="86" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Maybe the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">wrong</Text>
      <Text> story, Ray.</Text>
    </Paragraph>
    <Paragraph Number="314" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="86" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's mangled </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">body </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">lies</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style=""> in the Dodge. Lit by headlights.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Now, if I had the chance to drive away from here, get a hot shower...</Text>
    </Paragraph>
    <Paragraph Number="315" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="86" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...fresh set of clothes. It's all over. Done. Else you taking a risk.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned waits for a response to his gambit. Finally...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">No... that ain't the risk.</Text>
    </Paragraph>
    <Paragraph Number="316" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="86" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray sits in darkness. Engine and lights off. The hunter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">Risk is letting you keep breathing.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">The way I see it, long as I get you into the trunk of the Mustang, and the Mustang to the wrecker's yard...</Text>
    </Paragraph>
    <Paragraph Number="317" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="86" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The upside down Dodge stirs, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">and begins to rock. G</Text>
      <Text>lass re-assembling, roof </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="4" Size="12" Style="">un-crumpling</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">...then this whole thing is gonna be like a bad dream that never happened.</Text>
    </Paragraph>
    <Paragraph Number="318" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="86" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned listening... sweating.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="Italic">You were right, Ned. Once we collided, only one of us was gonna be around after...</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> </Text>
    </Paragraph>
    <Paragraph Number="321" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="87" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RAY"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray is resolved. Zen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="AllCaps">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">... and that's gonna be me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">He lets down his handbrake.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="87" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps">EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The Dodge rises into the air, rotating sideways towards the torn chain-link fence on the access road.</Text>
    </Paragraph>
    <Paragraph Number="322" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="87" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned hears a trundling sound on the phone call. A rumble. Another sound to his right through the window. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">A shadowy hulk</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">rolls</Text>
      <Text> downhill towards him</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="323" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="87" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray turns on his engine and headlights.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style=""> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Underline">Accelerates</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">.</Text>
    </Paragraph>
    <Paragraph Number="324" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="87" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="NED"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned flood-lit by </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">headlights</Text>
      <Text>. Too late to start the engine.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Always said you was a killer Ray...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="87" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="Bold+AllCaps">EXT. ACCESS ROAD -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">The chain-link fence wraps itself around the sideways Dodge, skidding sideways onto the access road...</Text>
    </Paragraph>
    <Paragraph Number="325" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="87" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. ACCESS ROAD -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Mustang </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">SLAMS</Text>
      <Text> SIDEWAYS </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="">into</Text>
      <Text> the Dodge and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">-</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>SMASH CUT TO:</Text>
    </Paragraph>
    <Paragraph Number="326" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="88" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACE TRACK -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>RAY'S WHITE INDYCAR barrels past a competitor at </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">20</Text>
      <Text>0mph.</Text>
    </Paragraph>
    <Paragraph Number="327" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="88" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. COCKPIT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray behind visor in the driver's seat.
White gloves gripping the steering wheel. </Text>
    </Paragraph>
    <Paragraph Number="328" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="88" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. GRANDSTAND</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>An ANNOUNCER go</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">es</Text>
      <Text> wild over the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">PA system</Text>
      <Text>. LORY jumps to her feet at the grandstand. Ray staging an incredible comeback.</Text>
    </Paragraph>
    <Paragraph Number="329" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="88" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. RACE TRACK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray moving up to top gear, flooring the pedal. 
Rearview; a </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">BLACK INDYCAR</Text>
      <Text> coming fast. </Text>
    </Paragraph>
    <Paragraph Number="330" Type="Scene Heading">
      <SceneProperties Length="1/8" Page="88" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. GRANDSTAND -- ON CROWD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Spectators going wild -- the final straight.
Tight on Lory, screaming - he's GONNA WIN.</Text>
    </Paragraph>
    <Paragraph Number="331" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="88" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. COCKPIT -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Staring at the </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">REARVIEW: </Text>
      <Text>Black Indycar accelerat</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">ing</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">past</Text>
      <Text> him. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style="">
</Text>      <Text>RADIO CONTROLLERS barking frantic orders.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray's Indy</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="3" Size="12" Style="">c</Text>
      <Text>ar and Black Indycar </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">about to touch</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>
CUT TO BLACK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="7" Size="12" Style="">THE SONG</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="5" Size="12" Style=""> reprises... and the credits roll.
</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text></Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="0" Spacing="1" StartsNewPage="No" Type="General">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline">THE END</Text>
    </Paragraph>
