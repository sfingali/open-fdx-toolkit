<?xml version="1.0" encoding="UTF-8"?>
<FinalDraft DocumentType="Script" Template="No" Version="2">
  <Content>
    <Paragraph Type="Scene Heading" Number="1">
      <SceneProperties Length="1/8" Page="1" Title=""/>
      <Text>CRACKED REARVIEW MIRROR</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>reflects </Text>
      <Text RevisionID="2">upside</Text>
      <Text RevisionID="5">-</Text>
      <Text RevisionID="2">down</Text>
      <Text> </Text>
      <Text RevisionID="2">speedway</Text>
      <Text>. </Text>
      <Text RevisionID="5">A</Text>
      <Text>sphalt sky</Text>
      <Text RevisionID="5"> sucks in smoke. 
A BLACK INDYCAR lies crushed against a barrier.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="2">
      <SceneProperties Length="1/8" Page="1" Title=""/>
      <Text>REVERSE ON</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>the eyes of RAY SPEAR visible through smashed helmet.</Text>
      <Text RevisionID="2"> </Text>
      <Text>A gash above right eye sucks in pulses of blood.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="3">
      <SceneProperties Length="1/8" Page="1" Title=""/>
      <Text>REARVIEW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A SAFETY TEAM push</Text>
      <Text RevisionID="7">es</Text>
      <Text RevisionID="2"> a </Text>
      <Text RevisionID="5">BURNT </Text>
      <Text RevisionID="2">RACING DRIVER </Text>
      <Text>into the cockpit. A NOZZLEMAN sucks lashes of water from the car</Text>
      <Text RevisionID="5">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Driver</Text>
      <Text> catches fire. The water is cut off, and the Safety Team </Text>
      <Text Style="Underline">run</Text>
      <Text RevisionID="7" Style="Underline">s</Text>
      <Text Style="Underline"> backwards</Text>
      <Text> from the scene, abandoning </Text>
      <Text RevisionID="2">the</Text>
      <Text RevisionID="5">m</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="4">
      <SceneProperties Length="1/8" Page="1" Title=""/>
      <Text>ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">hanging</Text>
      <Text> </Text>
      <Text RevisionID="7">by his</Text>
      <Text> seatbelt. </Text>
      <Text RevisionID="7">B</Text>
      <Text RevisionID="5">lood</Text>
      <Text> float</Text>
      <Text RevisionID="7">s</Text>
      <Text> up to his forehead. </Text>
      <Text>Glass </Text>
      <Text RevisionID="7">stirs...</Text>
      <Text> gain</Text>
      <Text RevisionID="7">s</Text>
      <Text> momentum. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="5">
      <SceneProperties Length="2/8" Page="1" Title=""/>
      <Text>REARVIEW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Flames implode into the </Text>
      <Text RevisionID="5">Black Indycar's engine. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">T</Text>
      <Text>he fire </Text>
      <Text RevisionID="5">clears and t</Text>
      <Text RevisionID="2">he Driver</Text>
      <Text> struggles with his seatbelt. Atomized fragments fly into the crumpled front-wing, which </Text>
      <Text RevisionID="7">self-</Text>
      <Text>reassembles</Text>
      <Text RevisionID="7"> as-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Cracks in our mirror-view heal</Text>
      <Text RevisionID="7">. T</Text>
      <Text>he scene rotates.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="6">
      <SceneProperties Length="2/8" Page="1" Title=""/>
      <Text>ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Head smashing off </Text>
      <Text>cockpit</Text>
      <Text RevisionID="2"> rim</Text>
      <Text>, mending his visor. </Text>
      <Text RevisionID="2">The</Text>
      <Text> world</Text>
      <Text> rotates RIGHT WAY </Text>
      <Text RevisionID="7">UP</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Tires</Text>
      <Text> mak</Text>
      <Text RevisionID="2">e</Text>
      <Text> contact with asphalt</Text>
      <Text RevisionID="5">.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Wheel rims un</Text>
      <Text RevisionID="7">-</Text>
      <Text RevisionID="5">explode and reassemble</Text>
      <Text RevisionID="7">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray SWERVES away from the Black Indycar... </Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="8">
      <SceneProperties Length="4/8" Page="2" Title=""/>
      <Text RevisionID="4">INT. MUSTANG -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">RAY wakes with a start.</Text>
      <Text RevisionID="5"> He </Text>
      <Text RevisionID="6">sits in</Text>
      <Text RevisionID="5"> the driver's seat of a Mustang</Text>
      <Text RevisionID="7"> that is </Text>
      <Text RevisionID="7" Style="Underline">violently shaking</Text>
      <Text RevisionID="7">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">A hand touches his - his punkish daughter LORY (17) sits in the passenger seat.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">It's OK - just an aftershock.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">The shaking begins to ease... and stop. Car alarms sound. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Out the windshield, Ray can see f</Text>
      <Text RevisionID="5">our lanes of bumper-to-bumper </Text>
      <Text RevisionID="7">freeway </Text>
      <Text RevisionID="5">gridlock.</Text>
      <Text RevisionID="7"> He tweaks the radio volume.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">NEWSCASTER (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7" Style="Italic">...disruption on the 101, the 405, the I-10, with reports of cracks and structural damage and a collapsed bridge in Eagle Rock. The massive 7.4 shaker has also caused power cuts in San Bernardino...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">A CHIHUAHUA stares out the back window of the Subaru Forester in front. Trapped just like Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray opens the door and steps out.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="9">
      <SceneProperties Length="1 7/8" Page="2" Title=""/>
      <Text RevisionID="2">EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">As soon as Ray's </Text>
      <Text RevisionID="7">right </Text>
      <Text RevisionID="5">foot finds the </Text>
      <Text RevisionID="7">asphalt</Text>
      <Text RevisionID="5">, a </Text>
      <Text RevisionID="4">shot of pain run</Text>
      <Text RevisionID="5">s</Text>
      <Text RevisionID="4"> up his knee</Text>
      <Text RevisionID="7"> - h</Text>
      <Text RevisionID="6">e gasps</Text>
      <Text RevisionID="7">, bends to knead</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="6">it out</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="6">Ray</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="7">straightens up and locks eyes</Text>
      <Text RevisionID="5"> with the driver of the BLACK DODGE RAM behind the</Text>
      <Text RevisionID="6">m</Text>
      <Text RevisionID="5">. A SKINNY GUY behind wheel. </Text>
      <Text RevisionID="7">They exchange a nod. Ray turns away and </Text>
      <Text RevisionID="7">takes out his cell.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Both </Text>
      <Text RevisionID="7">vehicles</Text>
      <Text RevisionID="5"> are in outer lane of a flyover </Text>
      <Text RevisionID="7">hugging a</Text>
      <Text RevisionID="5"> barrier. </Text>
      <Text RevisionID="7">An</Text>
      <Text RevisionID="5"> 18-WHEELER TRACTOR TRAILER </Text>
      <Text RevisionID="7">shadows them from the adjacent lane.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Ray dials and moves towards a distant smoke-stack from a crash ahead. No turn-offs, no drive-thrus, no gas stations. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Asphalt and </Text>
      <Text RevisionID="7" Style="Underline">HEAT</Text>
      <Text RevisionID="7">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">The call is answered.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">I've been trying to reach you-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7" Style="Italic">-and I was trying to reach you. The network must be down. You guys OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">In one piece. What about the hearing? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7" Style="Italic">Everyone else is here. No reason we can't still go ahead if-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">If I make it? No chance. Freeway's a parking lot. And we're on a flyover.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Ray glances over the barrier; a hundred-foot drop. Beyond, the downtown skyline is so far away it could be a matte painting. Fires in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">I'</Text>
      <Text RevisionID="7" Style="Italic">ll</Text>
      <Text RevisionID="4" Style="Italic"> try for a delay-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">What about the settlement offer?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">DEB (O.S</Text>
      <Text RevisionID="7">.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">They turned it down.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">The latest one?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">The latest one.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">A man walks past </Text>
      <Text RevisionID="1">from the </Text>
      <Text RevisionID="2">crash direction</Text>
      <Text RevisionID="1">. </Text>
      <Text>Ten-gallon hat, shades, </Text>
      <Text RevisionID="1">black gloves. </Text>
      <Text RevisionID="7">H</Text>
      <Text>eavy toolbox</Text>
      <Text RevisionID="7"> in one hand</Text>
      <Text>, </Text>
      <Text RevisionID="7">phone in </Text>
      <Text RevisionID="1">the other</Text>
      <Text>.</Text>
      <Text RevisionID="1"> We'll come to know him as NED BOOLES.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">I think the family are open but Eva wants her day in court.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Delay. Buys us more time to settle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">I'll do my best.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">The call ends. Ray </Text>
      <Text RevisionID="5">wades back</Text>
      <Text> to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">He</Text>
      <Text RevisionID="1"> sees Ned</Text>
      <Text RevisionID="2"> come around the back of the 18-wheeler and get in the back passenger seat of the Dodge Ram behind them.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">The Skinny Guy </Text>
      <Text RevisionID="1">cranes his head to interact with Ned</Text>
      <Text RevisionID="4"> as if surprised.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">TRUCKER (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Looks like we'll be here a while.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray looks up</Text>
      <Text RevisionID="7">:</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="4">TRUCKER (60s)</Text>
      <Text RevisionID="7"> - </Text>
      <Text RevisionID="4">tough-looking older woman</Text>
      <Text RevisionID="7">,</Text>
      <Text RevisionID="4"> LOCAL 630 cap</Text>
      <Text RevisionID="7">,</Text>
      <Text RevisionID="5"> reading a paperback.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Shame we get paid by the mile, not the hour. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray makes conversation</Text>
      <Text RevisionID="7">, angling to </Text>
      <Text RevisionID="4">observe the Dodge.</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="7">Hard to see through </Text>
      <Text RevisionID="5">the tint</Text>
      <Text RevisionID="7">ed</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="7">glass and shade.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">Least you got something to read. Any good?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Crime novel. Jim Thompson. Depends on how dark you like your coffee.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Pitch black.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Trucker tilts the cover: "POP. 1280". Ray raises a hand </Text>
      <Text RevisionID="7">- </Text>
      <Text RevisionID="4">appreciation, and adieu. He </Text>
      <Text RevisionID="7">heads back</Text>
      <Text RevisionID="4"> to </Text>
      <Text RevisionID="7">the</Text>
      <Text RevisionID="4"> Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="39">
      <SceneProperties Length="5" Page="4" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray slinks back inside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Deb is trying to reschedule the arbitration.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">They can't run it without you</Text>
      <Text RevisionID="7"> - I mean, it was a goddamn earthquake.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">I don't know how these things work.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Why are they pushing this?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">His wife Eva feels she has a grievance. And it's her right to pursue.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW: Skinny Man </Text>
      <Text RevisionID="7">watches </Text>
      <Text RevisionID="5">him. Ned is a silhouette in the back seat. An uncanny stillness.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">You didn't mean to hit him, right? That's what they're saying.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">No. Of course not. He was like a kid brother to me. Six years on the same team, until he changed suits.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sirens and blue lights appear behind them.</Text>
      <Text RevisionID="1"> Ray observes Lory tense up and sink into her seat. Looks in the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW</Text>
      <Text RevisionID="1">:</Text>
      <Text RevisionID="5"> as LAPD motorcycle </Text>
      <Text RevisionID="7">officer</Text>
      <Text RevisionID="2"> CARRIS (30s) filters through traffic on her LAPD-issue Harley</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray's </Text>
      <Text RevisionID="7">eyes</Text>
      <Text RevisionID="5"> drift to the</Text>
      <Text RevisionID="1"> Skinny Guy</Text>
      <Text RevisionID="5">. S</Text>
      <Text RevisionID="2">tock still, neck straight, </Text>
      <Text RevisionID="1">watch</Text>
      <Text RevisionID="5">ing</Text>
      <Text RevisionID="1"> the cop </Text>
      <Text RevisionID="5">pass. He doesn't seek her attention. Ned a </Text>
      <Text RevisionID="3">silhouett</Text>
      <Text RevisionID="5">e in the back.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray observe</Text>
      <Text RevisionID="6">s</Text>
      <Text RevisionID="5"> Lory </Text>
      <Text RevisionID="6">monitoring</Text>
      <Text RevisionID="5"> the motorcycle </Text>
      <Text RevisionID="6">as it </Text>
      <Text>pass</Text>
      <Text RevisionID="6">es</Text>
      <Text> by </Text>
      <Text RevisionID="3">her</Text>
      <Text> window... and keep</Text>
      <Text RevisionID="7">s</Text>
      <Text> on going. </Text>
      <Text RevisionID="5">She breathes out in relief... </Text>
      <Text>until she realizes Ray is staring at her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You've been made. Give it up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Give up what?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text RevisionID="2"> yanks her bag from her and searches</Text>
      <Text RevisionID="7"> it</Text>
      <Text RevisionID="5">. </Text>
      <Text RevisionID="7">C</Text>
      <Text RevisionID="4">heap </Text>
      <Text RevisionID="2">phone, cigarettes, condoms</Text>
      <Text RevisionID="5">... a</Text>
      <Text> rose-embroidered SWITCHBLADE</Text>
      <Text RevisionID="5">. </Text>
      <Text RevisionID="7">Push-button - t</Text>
      <Text RevisionID="5">he blade slices open.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray</Text>
      <Text> folds </Text>
      <Text RevisionID="5">it and</Text>
      <Text RevisionID="4"> </Text>
      <Text>puts it in the glove box.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You've seen the crew I roll with.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Spend time with boys you trust.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where'd be the fun in that?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">He</Text>
      <Text RevisionID="4"> checks her jacket pockets. Finds something. Lory's </Text>
      <Text RevisionID="5">demeanor</Text>
      <Text RevisionID="7"> shifts</Text>
      <Text RevisionID="4">. </Text>
      <Text RevisionID="7">A</Text>
      <Text RevisionID="4"> baggie of white powde</Text>
      <Text RevisionID="7">r comes out</Text>
      <Text RevisionID="4">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">It's not mine-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Don't give me that bullshit.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">He </Text>
      <Text RevisionID="7">pockets the baggie.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">OK. I know you use.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">You don't know that.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">One time I heard you downstairs at a party, and someone offered you weed.</Text>
    </Paragraph>
    <Paragraph>
      <DualDialogue>
        <Paragraph Type="Character">
          <Text RevisionID="4">RAY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text RevisionID="4">I said n</Text>
          <Text RevisionID="7">o... OK don't give me this bullshit. Total sanctimony. I said NO.</Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text RevisionID="4">LORY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text RevisionID="4">-you said weed stayed in the system for weeks, but coke would be gone in two days max.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">He says nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Were you high when you raced Lucky?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">My bloods were clean.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Bloods weren't taken for three days.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">He says nothing in response. </Text>
      <Text>Lory </Text>
      <Text RevisionID="4">gets out and </Text>
      <Text>leaves the door open and marches towards the crash. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray leans to </Text>
      <Text RevisionID="3">close the door.</Text>
      <Text> </Text>
      <Text RevisionID="3">As he does so, he</Text>
      <Text> hears raised voices in the Dodge behind.</Text>
      <Text RevisionID="3"> Sitting up, he looks in the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">REARVIEW: </Text>
      <Text>Skinny </Text>
      <Text RevisionID="1">Guy</Text>
      <Text> argu</Text>
      <Text RevisionID="3">es</Text>
      <Text> with </Text>
      <Text RevisionID="2">Ned</Text>
      <Text RevisionID="3">.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3">F</Text>
      <Text>ace taut</Text>
      <Text RevisionID="3">,</Text>
      <Text> stressed.</Text>
      <Text RevisionID="3"> A serious disagreement. Skinny Guy makes eye contact with Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray tweaks the mirror away. </Text>
      <Text RevisionID="7">Doesn't want to get involved.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">He turns on the radio, tweaks to music. </Text>
      <Text RevisionID="7">An EERIE 50s POP SONG begins to play on the radio...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">SINGER (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Italic">My baby left so long ago... 
my baby left so long ago... 
I look for her everywhere I go...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">He kills the radio</Text>
      <Text RevisionID="7">. T</Text>
      <Text>ilts the</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text RevisionID="2">bringing Dodge </Text>
      <Text RevisionID="5">back </Text>
      <Text RevisionID="2">into view</Text>
      <Text>. Skinny </Text>
      <Text RevisionID="1">Guy</Text>
      <Text>'s face is slicked with sweat</Text>
      <Text RevisionID="3">.</Text>
      <Text> </Text>
      <Text RevisionID="3">Ned is a silhouette in the back seat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text RevisionID="5">'s</Text>
      <Text> CELL </Text>
      <Text Style="Underline">RINGS</Text>
      <Text>. </Text>
      <Text RevisionID="7">E</Text>
      <Text RevisionID="2">yes fixed on the rearview</Text>
      <Text RevisionID="7">, </Text>
      <Text RevisionID="5">he answers. </Text>
      <Text RevisionID="4">The </Text>
      <Text RevisionID="7">husky </Text>
      <Text RevisionID="4">voice of ALICE </Text>
      <Text RevisionID="5">(late 30s) comes through.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7" Style="Italic">Tell me you're ok-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">We're both totally fine. Don't worry. The epicenter was way east. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7" Style="Italic">Where are you now?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">Stuck in a jam on the freeway but they'll get us moving soon enough. I'd put her on but she's stepped out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">I guess this is one way for you guys to spend time together.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, I have some </Text>
      <Text RevisionID="5">co-parental</Text>
      <Text> bad news to deliver. </Text>
      <Text RevisionID="4">I found a baggie on her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Oh that's just </Text>
      <Text RevisionID="4" Style="Italic">fucking </Text>
      <Text Style="Italic">great-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW: Skinny Guy now appears to be in the climax of the heated argument. Angry? Begging?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Therapy. She needs therapy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sure. Rehab worked wonders, why not? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S</Text>
      <Text RevisionID="2">.</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Oh screw you</Text>
      <Text>.</Text>
      <Text RevisionID="6"> </Text>
      <Text Style="Italic">I think she wants to stay with you. Maybe this is all acting out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Y</Text>
      <Text>ou get weekdays, I get weekends. That was the agreement. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Weekends when you're not busy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I got race days, training</Text>
      <Text RevisionID="2">, and it pays her tuition.</Text>
      <Text> Cheap shot</Text>
      <Text RevisionID="4">,</Text>
      <Text> </Text>
      <Text RevisionID="4">Al</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">You earned it. She needs a strong man in her life</Text>
      <Text RevisionID="2" Style="Italic">, a</Text>
      <Text Style="Italic">nd if you won't be that she'll find someone who will...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text RevisionID="1">Skinny Guy dives forward, trying to reach for his leg. Ned's arms reach around to grab Skinny Guy. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Call you back.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray</Text>
      <Text> hang</Text>
      <Text RevisionID="2">s</Text>
      <Text> up. Transfixed by the</Text>
      <Text RevisionID="1">: </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">REARVIEW: </Text>
      <Text RevisionID="2">Elbows and hands </Text>
      <Text RevisionID="7">struggling</Text>
      <Text RevisionID="2">. </Text>
      <Text RevisionID="5">Wipers</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="7">kick</Text>
      <Text RevisionID="1"> on</Text>
      <Text RevisionID="7">, </Text>
      <Text RevisionID="1">fluid </Text>
      <Text RevisionID="7">smearing</Text>
      <Text RevisionID="1"> the windshield</Text>
      <Text RevisionID="7">,</Text>
      <Text RevisionID="1"> obscuring </Text>
      <Text RevisionID="3">our</Text>
      <Text RevisionID="1"> view. Skinny Guy gets a leg up, heel </Text>
      <Text RevisionID="7">CRACKS the</Text>
      <Text RevisionID="1"> windshield.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray looks around </Text>
      <Text RevisionID="7">for other witnesses</Text>
      <Text RevisionID="4">. The Trucker is a shadow in </Text>
      <Text RevisionID="7">her</Text>
      <Text RevisionID="4"> cab. The Forester do</Text>
      <Text RevisionID="5">es</Text>
      <Text RevisionID="4">n't have line of sight.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">REARVIEW: between smearing wipers</Text>
      <Text RevisionID="5">... </Text>
      <Text RevisionID="1">Skinny Guy's head SNAP</Text>
      <Text RevisionID="7">S</Text>
      <Text RevisionID="1"> forward and back. </Text>
      <Text RevisionID="2">All</Text>
      <Text RevisionID="1"> struggle abates in an instant.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What the </Text>
      <Text RevisionID="4">hell</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW: Skinny Guy's head </Text>
      <Text RevisionID="7">lolls</Text>
      <Text RevisionID="5">, almost floppy... </Text>
      <Text RevisionID="7">then black gloved hands from the back prop it on the headrest.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray looks away from the mirror. Has no idea what to do. Has no idea what he just saw. </Text>
      <Text RevisionID="4" Style="Underline">If</Text>
      <Text RevisionID="4"> he saw anything. Looks into his phone. </Text>
      <Text RevisionID="4" Style="Italic">Call the cops?</Text>
      <Text RevisionID="4"> He tweaks the mirror again.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray</Text>
      <Text> returns gaze to the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text Style="Underline">No Skinny </Text>
      <Text RevisionID="1" Style="Underline">Guy</Text>
      <Text>. He’s gone. Just the silhouette of Ned</Text>
      <Text RevisionID="2"> </Text>
      <Text>behind </Text>
      <Text RevisionID="2">spidered windshield</Text>
      <Text>.</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="7">Wipers still going. </Text>
      <Text RevisionID="4">The back door opens</Text>
      <Text RevisionID="7">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray locks the doors. Cranks up the window. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: </Text>
      <Text>Ned getting out of the car. Stretching</Text>
      <Text RevisionID="7">. S</Text>
      <Text>urveying </Text>
      <Text RevisionID="7">the</Text>
      <Text> environment. </Text>
      <Text RevisionID="1">Like nothing happened.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray takes the phone from the rack. </Text>
      <Text RevisionID="7">D</Text>
      <Text RevisionID="4">ials 9-1-1.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned </Text>
      <Text RevisionID="7">climbing</Text>
      <Text> in</Text>
      <Text RevisionID="7">to</Text>
      <Text> the driver's seat of the Dodge</Text>
      <Text RevisionID="7">. E</Text>
      <Text>ncumbered by something.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray listens to the ringing tone. Answered.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">EMERGENCY OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="4">(filtered)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">What is your emergency?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Police.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: A FOIL SUNSHADE is placed across the entirety of the windshield, obscuring his view.</Text>
      <Text RevisionID="1"> The wipers stop.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">POLICE OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">Police, what is your emergency?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">I'd like to report a crime.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">POLICE OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">Are you in danger or do you require immediate emergency assistance?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">I don't think I'm in danger.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">He remembers </Text>
      <Text RevisionID="7">the baggie</Text>
      <Text RevisionID="4">. </Text>
      <Text RevisionID="7">Pulls it out for a moment</Text>
      <Text RevisionID="4">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">I'll call you back.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">POLICE OPERATOR (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">Sir, if I can just take your-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray hangs up and reaches for the door. Hesitates.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: </Text>
      <Text RevisionID="7">T</Text>
      <Text RevisionID="4">he </Text>
      <Text RevisionID="7">Dodge</Text>
      <Text RevisionID="4">. </Text>
      <Text RevisionID="7">No movement. All is calm.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray takes the switchblade from the glove box and pockets it</Text>
      <Text RevisionID="5">.</Text>
      <Text RevisionID="7"> U</Text>
      <Text RevisionID="5">nlocks the door</Text>
      <Text RevisionID="7"> and opens it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="42">
      <SceneProperties Length="1" Page="9" Title=""/>
      <Text RevisionID="4">EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Ray stands outside.</Text>
      <Text RevisionID="4"> He ambles </Text>
      <Text RevisionID="5">towards</Text>
      <Text RevisionID="4"> the Forester</Text>
      <Text RevisionID="5">,</Text>
      <Text RevisionID="7"> scanning for a drain. Nothing doing.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray bends to massage his leg. </Text>
      <Text RevisionID="7">S</Text>
      <Text RevisionID="4">teals a glance </Text>
      <Text RevisionID="7">at</Text>
      <Text RevisionID="4"> the Dodge. Sunshade up. </Text>
      <Text RevisionID="7">A </Text>
      <Text RevisionID="5">drain</Text>
      <Text RevisionID="7"> - one </Text>
      <Text RevisionID="5">car behind </Text>
      <Text RevisionID="7">the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Ray leans back towards the Forester's side-mirror.</Text>
      <Text RevisionID="4"> </Text>
      <Text RevisionID="7">A</Text>
      <Text RevisionID="4">ngles himself to see if </Text>
      <Text RevisionID="7">they had an eyeline to</Text>
      <Text RevisionID="4"> inside the Dodge. </Text>
      <Text RevisionID="7">Negative; the windshield is just out of view.</Text>
      <Text RevisionID="4"> The Chihuahua in the Forester looks down at him with curiosity.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray's cellphone RINGS</Text>
      <Text RevisionID="7"> loudly</Text>
      <Text>. He taps it, hair-trigger</Text>
      <Text RevisionID="2"> fast</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">I got the hearing rescheduled. It's reset, two weeks.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(...)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">You hearing me Ray?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray </Text>
      <Text RevisionID="7">rounds</Text>
      <Text RevisionID="4"> the cab of the 18-wheeler. The Dodge is </Text>
      <Text RevisionID="7">now </Text>
      <Text RevisionID="4">blocked from view by the engine block.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...Yeah. That’s great. </Text>
      <Text RevisionID="7">Is the lawyer still there?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">DEB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">Marco? </Text>
      <Text RevisionID="3" Style="Italic">He</Text>
      <Text RevisionID="2" Style="Italic">'s</Text>
      <Text Style="Italic"> buttonholing Lucky's wife and her </Text>
      <Text RevisionID="2" Style="Italic">rep</Text>
      <Text Style="Italic"> in a conference room.</Text>
      <Text RevisionID="4" Style="Italic"> See if we can reach a settlement before the rematch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Get </Text>
      <Text RevisionID="7">Marco</Text>
      <Text RevisionID="2"> to call me when he's out</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray walks down the driver-side of the 18-wheeler</Text>
      <Text RevisionID="2">'s box trailer. </Text>
      <Text RevisionID="4">A</Text>
      <Text RevisionID="2"> vista here: all </Text>
      <Text RevisionID="4">other </Text>
      <Text RevisionID="2">lanes are visible</Text>
      <Text RevisionID="4">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Simmering engines; hum of AC</Text>
      <Text RevisionID="2">.</Text>
      <Text> </Text>
      <Text RevisionID="2">C</Text>
      <Text>ommuters swelter. T</Text>
      <Text RevisionID="1">WO WOMEN</Text>
      <Text> roar at each other </Text>
      <Text Style="Italic">en español</Text>
      <Text>. A barbecue </Text>
      <Text RevisionID="7">smokes beside </Text>
      <Text>an RV. A HOMELESS MAN </Text>
      <Text RevisionID="7">works </Text>
      <Text>ca</Text>
      <Text RevisionID="2">r</Text>
      <Text>-to-car</Text>
      <Text RevisionID="2">, cap in hand.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>At the trailer</Text>
      <Text RevisionID="7">'s rear</Text>
      <Text>, </Text>
      <Text RevisionID="7">TWO GUYS </Text>
      <Text>play cards on the</Text>
      <Text RevisionID="7"> hood of a Honda Civic</Text>
      <Text>. </Text>
      <Text RevisionID="2">Ray passes them</Text>
      <Text RevisionID="7">, </Text>
      <Text RevisionID="4">mov</Text>
      <Text RevisionID="7">ing</Text>
      <Text RevisionID="4"> towards the drain. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">A TOYOTA PRIUS </Text>
      <Text RevisionID="7">- </Text>
      <Text RevisionID="5">the car directly behind the Dodge</Text>
      <Text RevisionID="7"> - sits in front of the drain.</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="4">Ray walks behind it and crouches</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Ray</Text>
      <Text RevisionID="4"> re-ties his shoelace</Text>
      <Text RevisionID="7"> and </Text>
      <Text RevisionID="4">drops the baggie of coke into the drain. Steals a glance</Text>
      <Text RevisionID="7"> at</Text>
      <Text RevisionID="4"> the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="43">
      <SceneProperties Length="1/8" Page="10" Title=""/>
      <Text RevisionID="4">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW: Ray crouched at the drain, looking at us.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">The interior is</Text>
      <Text RevisionID="4"> dark</Text>
      <Text RevisionID="7"> and</Text>
      <Text RevisionID="4"> sepulchral</Text>
      <Text RevisionID="7">. </Text>
      <Text RevisionID="4">Heavy breathing. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="44">
      <SceneProperties Length="6/8" Page="10" Title=""/>
      <Text RevisionID="5">INT. / </Text>
      <Text RevisionID="4">EXT. TOYOTA PRIUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray </Text>
      <Text RevisionID="7">approaches</Text>
      <Text RevisionID="5"> t</Text>
      <Text>he sole occupan</Text>
      <Text RevisionID="5">t;</Text>
      <Text> WALT, middle-aged, </Text>
      <Text RevisionID="2">sweat-stained </Text>
      <Text>shirt and tie. The trailer</Text>
      <Text RevisionID="2">'s shade</Text>
      <Text> falls short of his </Text>
      <Text RevisionID="2">windshield</Text>
      <Text RevisionID="7">,</Text>
      <Text RevisionID="5"> leaving him to bake in the sun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">T</Text>
      <Text>hink we'll be here long?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>WALT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Radio says they're hoping to get her moving in an hour.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray leans in, keeping the smile, but lowering his voice. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think I saw something in th</Text>
      <Text RevisionID="2">at </Text>
      <Text>Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>WALT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Saw something?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A commotion. Hard to miss.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How about you, </Text>
      <Text RevisionID="2" Style="Italic">compadre</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Walt finally makes eye contact. </Text>
      <Text RevisionID="7">Barely</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>WALT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look here, OK? </Text>
      <Text RevisionID="2">
</Text>
      <Text>I don't know </Text>
      <Text Style="Italic">what</Text>
      <Text> I saw.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Walt jacks up the radio to terminate the conversation.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">NEWSCASTER</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">-</Text>
      <Text RevisionID="7" Style="Italic">further casualties from the earthquake were reported on t</Text>
      <Text Style="Italic">he I-11</Text>
      <Text RevisionID="7" Style="Italic">.</Text>
      <Text Style="Italic"> Drivers are being advised to re-route around the crash site...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray backs away from the Prius</Text>
      <Text RevisionID="3">. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 3/8" Page="11" Title=""/>
      <Text RevisionID="5">EXT. MUSTANG &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray </Text>
      <Text RevisionID="3">walks towards </Text>
      <Text>the Mustang, mak</Text>
      <Text RevisionID="3">ing</Text>
      <Text> his way </Text>
      <Text RevisionID="3">in the tight squeeze between </Text>
      <Text>box trailer and Dodge.</Text>
      <Text RevisionID="4"> His hand </Text>
      <Text RevisionID="5">touches</Text>
      <Text RevisionID="4"> the switchblade </Text>
      <Text RevisionID="5">in </Text>
      <Text RevisionID="4">his pocket</Text>
      <Text RevisionID="5"> for comfort.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray</Text>
      <Text> steals a glance inside the Dodge</Text>
      <Text RevisionID="3"> as he passes</Text>
      <Text>.</Text>
      <Text RevisionID="7"> Tinted windows. </Text>
      <Text>Something shifting in the dark</Text>
      <Text RevisionID="7">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray's phone rings. He answers it quickly - </Text>
      <Text RevisionID="3">maybe </Text>
      <Text>too quickly - and walks to the shoulder. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">-you there Ray? You hear me?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I hear you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">He </Text>
      <Text RevisionID="7">moves</Text>
      <Text RevisionID="4"> out of earshot</Text>
      <Text RevisionID="7">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Listen, I just finished with </Text>
      <Text RevisionID="5" Style="Italic">Eva</Text>
      <Text Style="Italic">'s </Text>
      <Text RevisionID="1" Style="Italic">rep</Text>
      <Text Style="Italic"> and got a bite on the deal. </Text>
      <Text RevisionID="1" Style="Italic">She</Text>
      <Text Style="Italic"> says they'll get back today.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray watches Lory return to the Mustang</Text>
      <Text RevisionID="5"> and get in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fantastic, Marco. But listen, that wasn't why I wanted to speak... </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="7">glances</Text>
      <Text> at the Trucker's cab</Text>
      <Text RevisionID="7">.</Text>
      <Text> </Text>
      <Text RevisionID="7">I</Text>
      <Text>mprovises.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...I was sitting in this jam and I had this idea for a</Text>
      <Text RevisionID="7"> </Text>
      <Text>crime novel. Kinda in the style of Jim Thompson.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Planning a career change Ray? I hope that isn't a </Text>
      <Text RevisionID="5" Style="Italic">judgement</Text>
      <Text Style="Italic"> on my skills-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-quite the opposite. A little bird</Text>
      <Text RevisionID="5">ie</Text>
      <Text> told me that you do some courthouse criminal work. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Italic">I do some pro</Text>
      <Text RevisionID="7" Style="Italic"> </Text>
      <Text RevisionID="5" Style="Italic">bono, sure.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I wanted some legal advice on the situation my hero finds himself in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">For research purposes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For research purposes, exactly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">So tell me your story Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It's about a guy who's witness to a crime in the middle of a traffic jam. Car-jacking, turn</Text>
      <Text RevisionID="1">ed</Text>
      <Text> murder. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">Is he sure of what he's seen?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Pretty sure. </Text>
      <Text>And</Text>
      <Text RevisionID="1"> for all practical purposes, he's the only witness.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3">So</Text>
      <Text RevisionID="2"> m</Text>
      <Text>y question is... now what? What's </Text>
      <Text RevisionID="2">his</Text>
      <Text> responsibility?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">You mean, e</Text>
      <Text Style="Italic">thically or legally?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Legally, I guess.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Legally, there's no direct jeopardy. I'd argue he doesn't have a proactive responsibility to do anything.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>OK</Text>
      <Text RevisionID="2">...</Text>
      <Text> </Text>
      <Text RevisionID="2">s</Text>
      <Text>o </Text>
      <Text RevisionID="2">w</Text>
      <Text>hat about ethically?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">More of a Rabbi question. Above my pay grade.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let's say he calls it in. Like you're supposed to. Police arrest the killer. What next?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Well, if the perp doesn't plead guilty, then there'd be a trial. Your hero would be asked to testify. Defense would get his name as part of discovery. But if the case hinges on a witness, and the perp makes bail-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-no way </Text>
      <Text RevisionID="5">the perp</Text>
      <Text> makes bail, we're talking Murder One here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Setting's contemporary LA right? Most D.A.s were elected on ending cash bail. Now it's catch and release. And even if the perp doesn't make the streets, he might have associates</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray stares at Lory</Text>
      <Text RevisionID="5"> in the Mustang</Text>
      <Text RevisionID="3">. Imagining outcomes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But if </Text>
      <Text RevisionID="2">my hero</Text>
      <Text> never calls it in</Text>
      <Text RevisionID="2">...</Text>
      <Text> the killer never gets his name.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Correct. I once did pre-trial for a button-man charged with multiple homicide. Burnt to death a family of six because the grandmother ratted his crew pushing on the sidewalk. The thing I remember about him, was he had smooth hands. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="45">
      <SceneProperties Length="5 5/8" Page="14" Title=""/>
      <Text>INT.</Text>
      <Text RevisionID="4"> </Text>
      <Text>MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="4">locks the doors</Text>
      <Text RevisionID="5"> and keeps his eye on the rearview. </Text>
      <Text RevisionID="4">Lory fiddles with the AC.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">I think a car crashed off the overpass. Pontiac Sedan, classic. Then it was hit by a fuel truck, the fuel truck rolled over... t</Text>
      <Text RevisionID="2">his AC is trash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">It was state of the art.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Once upon a time.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: the sunshade is being taken down. </Text>
      <Text RevisionID="2">It reveals</Text>
      <Text> Ned </Text>
      <Text RevisionID="2">sitting </Text>
      <Text>in the driver's seat. Alone. Staring at Ray?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">What you staring at?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">She tries to look in the mirror but Ray tilts it away, landing on... a STRINGER walking up the inside lane, hauling a shoulder-mount camcorder. Ray has found a cover story.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Underline">Paparazzi</Text>
      <Text RevisionID="4">. Six o'clock.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">She scans the side mirror and makes the guy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Keep your face turned. Don't want you snapped.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Then why were you taking me to the arbitration? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">I was taking you for moral support. It looks good with the adjudicators.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">And for the photos, right?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">The STRINGER passes them, not giving a second glance to Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">And that's not a celeb pap. He's a stringer, hunting roadkill for the evening news. And based on what I saw, he's gonna get some... I saw like three dead bodies.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray finally turns attention away from the mirror to Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">You OK? Seeing that?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">It was SO COOL. Like something off a gore site. Totally liveleak dot com.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="5">(a beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Actually</Text>
      <Text RevisionID="5">...</Text>
      <Text RevisionID="4"> it was pretty gross.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="6">looks</Text>
      <Text RevisionID="4"> at </Text>
      <Text RevisionID="6">Ned's</Text>
      <Text RevisionID="4"> silhouette</Text>
      <Text RevisionID="6"> again. Then he pulls</Text>
      <Text RevisionID="5"> </Text>
      <Text>the </Text>
      <Text RevisionID="6">switchblade</Text>
      <Text> out</Text>
      <Text RevisionID="6">. F</Text>
      <Text RevisionID="2">licks it open</Text>
      <Text RevisionID="5">. This gets Lory's attention.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You</Text>
      <Text RevisionID="4"> even</Text>
      <Text> know how to use </Text>
      <Text RevisionID="2">this</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">And you do?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Get your index under the hook so</Text>
      <Text RevisionID="2"> as</Text>
      <Text> you don't slice your fingers. Stab. Don't slash. Center of mass. </Text>
      <Text RevisionID="2">Under the ribs. If he's close-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">-how do you know it'd be a he?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Because it's always a he, Lory. And what they got on you in body strength, you gotta make up in viciousness. So if he's too </Text>
      <Text>close,</Text>
      <Text RevisionID="2"> or fat,</Text>
      <Text> </Text>
      <Text RevisionID="2">you </Text>
      <Text>go high, somewhere you can get an arc. </Text>
      <Text RevisionID="2">His face. His neck.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So one moment I'm an idiot for carrying it and the next you're showing me how to use it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No contradiction. You are an idiot for carrying it. But if you're going to be an idiot and carry it-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-I'm just a fuck up, aren't I?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She becomes upset. </Text>
      <Text RevisionID="2">He puts the knife in the glove box.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No you ain't.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Compared to what, you? Winning championships at eighteen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I wasn't so perfect. How do you think I know how to use this thing?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Lory</Text>
      <Text RevisionID="2"> doesn't know what to do with Ray's </Text>
      <Text RevisionID="3">uncharacteristic candor. S</Text>
      <Text RevisionID="2">he turns attention to her cell. Ray checks the-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text Style="Underline">Ned is standing outside the Dodge</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory, you do your old man a favor?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned stretches his arms out, like he’s woken from a long nap. He lights a cigarette and surveys</Text>
      <Text RevisionID="2"> his environ</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Why don't you mosey on up to the police tape </Text>
      <Text RevisionID="4">again </Text>
      <Text>and ask the uniforms how long we're gonna be</Text>
      <Text RevisionID="4">?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory remains glued to her </Text>
      <Text RevisionID="2">cell</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned begins to amble towards </Text>
      <Text RevisionID="2">the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Could you do that for me? </Text>
      <Text Style="Underline">Please</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory rolls her eyes and gets out. </Text>
      <Text RevisionID="5">She marches towards the crash. Ray turns eyes towards Ned's approach, now entering the mirror blindspot.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray can hear Ned is singing a song... the same from earlier.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Italic">Baby left me so so long ago... 
Baby left me so so long ago... 
Baby left me so so long ago... 
I look for her in my rearview.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's waist ends up at the passenger window</Text>
      <Text RevisionID="5">. He </Text>
      <Text>leans in and meets eyes with Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Six dead.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned nods in the direction of the crash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>S’what the radio says anyhow. There will be more, you can bet on it. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray says nothing and </Text>
      <Text>Ned puts on </Text>
      <Text RevisionID="2">his</Text>
      <Text> peculiar smile. There’s something childish about him</Text>
      <Text RevisionID="2">.</Text>
      <Text> His speech is a</Text>
      <Text RevisionID="2"> constant,</Text>
      <Text> </Text>
      <Text RevisionID="2">flat southwestern</Text>
      <Text> drawl. Everything about his presence suggests the threat of sudden violence</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My AC’s gone an’ expired hisself and I’m just cooking in this heat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned extends a hand</Text>
      <Text RevisionID="2">.</Text>
      <Text> </Text>
      <Text RevisionID="2">Ray stares at his g</Text>
      <Text>rimy fingers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ned Booles.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray gives in and shakes the hand. Ned has a strong grip, fingers in the wrong place, like a </Text>
      <Text RevisionID="4">secret</Text>
      <Text> handshake.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You sure we never met?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think I'd remember.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ned lets go.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yep. I think you would. But you look familiar. Where you headed?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Downtown. </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How about you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, I'm just passing through, headed down the Cali coastline, then home through the mother road, back to the valley of the spun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm guessing Phoenix.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nobody from Phoenix. Phoenix-native is as rare as a scoophead shark. Naw, I get out of there drought season. Rivers and the wells dry up. One day there'll be nothing left of Phoenix. And I guess one day there'll be nothing left of all here this. Once the oil goes, anyway. And it will.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned looks around the inside of the car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I ain't seen no two-seat Mustang. </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This a model car or something?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sure is.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hot damn. What year?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sixty-three.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Man driving a sixty-three model-car Mustang. </Text>
      <Text RevisionID="2">You m</Text>
      <Text>ust be some sort of celebrity, </Text>
      <Text RevisionID="2">am I </Text>
      <Text>right?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You're mistaken.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You sure like lookin'</Text>
      <Text> at yourself in the mirror... hell, s’what you been doing all day! </Text>
      <Text Style="Underline">What you see</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned slaps the </Text>
      <Text RevisionID="2">hood</Text>
      <Text>, startling Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now I remember. You're that speed racer. </Text>
      <Text Style="Underline">Ray Spear</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray says nothing. </Text>
      <Text>Ned </Text>
      <Text RevisionID="2">traces </Text>
      <Text>a finger </Text>
      <Text RevisionID="2">over</Text>
      <Text> his </Text>
      <Text RevisionID="2">right </Text>
      <Text>eye</Text>
      <Text RevisionID="2">, mirroring Ray's scar.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, that from the crash? Nasty.</Text>
      <Text RevisionID="2"> I'm m</Text>
      <Text>ore a NASCAR guy myself, which is why it took me so long. But you lied, Ray. You </Text>
      <Text Style="Italic">lied</Text>
      <Text> when you said I was mistaken.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was being polite.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where I come from</Text>
      <Text RevisionID="5">,</Text>
      <Text RevisionID="2"> </Text>
      <Text>ain't</Text>
      <Text RevisionID="2"> so </Text>
      <Text>polite to fib.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well</Text>
      <Text RevisionID="2">,</Text>
      <Text> </Text>
      <Text RevisionID="2" Style="Italic">Ned</Text>
      <Text RevisionID="5" Style="Italic"> -</Text>
      <Text> where I come from, it's more polite than telling someone to fuck off. But, saying as we're being all candid, like</Text>
      <Text RevisionID="2">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's grin broadens.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I can tell you and me... we're gonna have a lot of fun </Text>
      <Text Style="Italic">killer.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned double-taps the hood and </Text>
      <Text RevisionID="2">steps away from the Mustang.</Text>
      <Text RevisionID="4"> Ray watches as Ned smiles in the direction of someone...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Lory is returning </Text>
      <Text RevisionID="4">from the</Text>
      <Text RevisionID="5"> direction of the</Text>
      <Text RevisionID="4"> crash site</Text>
      <Text RevisionID="5">. She</Text>
      <Text> gets in and hands Ray </Text>
      <Text RevisionID="5">a</Text>
      <Text> water bottle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Said maybe an hour. Who was that guy?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray drinks thirstily and hands </Text>
      <Text RevisionID="1">the bottle</Text>
      <Text> </Text>
      <Text RevisionID="5">back</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're leaving. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How you planning on doing that?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He tucks the ignition keys behind the sun visor.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>On foot. Grab your shit.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray pulls the phone from the holder and gets out.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="50">
      <SceneProperties Length="1" Page="20" Title=""/>
      <Text>EXT. MUSTANG -- CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray walks around the</Text>
      <Text RevisionID="2"> engine block of the</Text>
      <Text> 18-wheeler</Text>
      <Text RevisionID="2"> to avoid </Text>
      <Text RevisionID="5">passing </Text>
      <Text RevisionID="2">the Dodge</Text>
      <Text RevisionID="5">.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="5">He walks down the side of the box trailer and the inner lanes. </Text>
      <Text RevisionID="4">Lory struggles to keep up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">You can't just leave your car on the freeway-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-send Jay-Dee to pick up the car. The keys are behind the visor. You got GPS for the car-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">-Ray, just wait until he gets there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned appear</Text>
      <Text RevisionID="5">s</Text>
      <Text> at the rear of the box trailer</Text>
      <Text RevisionID="5">, blocking their path.</Text>
      <Text> He hold</Text>
      <Text RevisionID="5">s</Text>
      <Text> </Text>
      <Text RevisionID="5">the</Text>
      <Text RevisionID="4"> </Text>
      <Text>toolbox awa</Text>
      <Text RevisionID="5">y in a gunfighter stance. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Gotta go.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hangs up. </Text>
      <Text RevisionID="5">He </Text>
      <Text>walks sideways into the </Text>
      <Text RevisionID="2">inner lanes</Text>
      <Text>. Ned mirrors him in parallel. When Ray stops, Ned stops. When Ray moves, Ned moves. Like a reflection in a mirror. A shadow.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What's with this creep?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>More trouble than he's worth.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks across t</Text>
      <Text RevisionID="2">he barrier to the other carriageway</Text>
      <Text>. Fast moving</Text>
      <Text RevisionID="2"> traffic</Text>
      <Text>, but freedom in the street</Text>
      <Text RevisionID="3"> beyond</Text>
      <Text>. </Text>
      <Text RevisionID="3">Ray</Text>
      <Text> moves towards the </Text>
      <Text RevisionID="3">barrier</Text>
      <Text> - but a CAR buzzes past, and he recoils. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Are you FUCKING CRAZY?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray turns and walks towards the crash, grabbing her arm.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We go the other way.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They won't let us through-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">-I'll convince them</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray glances back. Ned isn't following. Just standing there, grinning, watching them go.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text RevisionID="5">CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="55">
      <SceneProperties Length="2/8" Page="21" Title=""/>
      <Text>EXT. FREEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory move through stalled lanes of traffic. He looks</Text>
      <Text RevisionID="5"> over the barrier; a hundred</Text>
      <Text RevisionID="7">-foot</Text>
      <Text RevisionID="5"> drop below.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory notices </Text>
      <Text RevisionID="5">Ray</Text>
      <Text> </Text>
      <Text RevisionID="5">is limping</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Keep going</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="57">
      <SceneProperties Length="2" Page="21" Title=""/>
      <Text>EXT. CRASH SITE -- FREEWAY -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">A </Text>
      <Text RevisionID="7">ROTATOR CRANE</Text>
      <Text RevisionID="5"> begins to lift the </Text>
      <Text RevisionID="7">mashed </Text>
      <Text RevisionID="5">fuel tank</Text>
      <Text RevisionID="7">, supervised by a haulage crew and police.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>RAY and LORY arrive at the police tape, looking for a way through. </Text>
      <Text RevisionID="4">OFFICER LENNOX (30s)</Text>
      <Text> stops them.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Return To Your Vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Listen, we gotta get through, OK?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Officer </Text>
      <Text>Carris joins Lennox for backup.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, we are not ASKING you to return to your vehicle. We are TELLING you-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're in trouble. We got serious issues, and I just need to get the hell off from this goddamn freeway-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">A deep rumble cuts him off and t</Text>
      <Text>he</Text>
      <Text RevisionID="7"> freeway begins to shake. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">A large AFTERSHOCK begins shaking the bridge and the cars. The rotator begins to sway, drawing everyone's attention. The metal pneumatics strain like the sinews of overworked muscle and the oil tank begins to sway. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">A winch cable snaps loose from the axle, and the fuel tank sways back and forth. The rest of the axle groans.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">The aftershock stops. Leaving just the sway of the fuel tank under the rotator. Nobody moves.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">The axle</Text>
      <Text> snaps from </Text>
      <Text RevisionID="2">the winch.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The fuel tank </Text>
      <Text RevisionID="2">sags</Text>
      <Text> to the ground</Text>
      <Text RevisionID="2">, and </Text>
      <Text>the leaf</Text>
      <Text RevisionID="3"> spring</Text>
      <Text> </Text>
      <Text RevisionID="2">rips and</Text>
      <Text> gouges a hole in the tank plating.</Text>
      <Text RevisionID="2"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">A river of DIESEL slurps across the asphalt. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray grabs Lory and pulls her away from the scene.</Text>
      <Text RevisionID="2"> 
</Text>
      <Text>Cops and paramedics and firefighters clear the area.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory tries to look back at the scene but Ray is insistent, pulling her away. </Text>
      <Text RevisionID="2">Proximate</Text>
      <Text> drivers </Text>
      <Text RevisionID="2">flee</Text>
      <Text> their cars</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The rotator winch cable begins to smoke with friction, going haywire without the load it was calibrated for. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">A</Text>
      <Text RevisionID="7"> SAFETY</Text>
      <Text RevisionID="4"> OPERATOR </Text>
      <Text>gets back in the rotator cab</Text>
      <Text RevisionID="2"> of Hercules and</Text>
      <Text> pulls a switch.</Text>
      <Text RevisionID="2"> </Text>
      <Text>A clamp chomps on the winch cable.</Text>
      <Text RevisionID="2">..</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">...which</Text>
      <Text> sparks, </Text>
      <Text RevisionID="2">and the sparks </Text>
      <Text>drift to the diesel, and </Text>
      <Text RevisionID="2">the diesel</Text>
      <Text> ignites. Flames race towards the hemorrhaging tank</Text>
      <Text RevisionID="2">er</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>GET DOWN! EVERYONE GET DOWN!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text Style="Bold+Italic+Underline">KRA-BOOOOMMMMMM</Text>
      <Text Style="Bold+Italic">!!!!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>-AN ORANGE EXPLOSION </Text>
      <Text Style="Underline">BURSTING</Text>
      <Text> UP INTO THE AIR.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray pulls Lory behind a car, covering her body with his own.</Text>
      <Text RevisionID="4"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4" Style="Bold+Italic">A flash of the racetrack explosion... orange flames sucking into the crashed black Indycar.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>SHRAPNEL RAINS down around</Text>
      <Text RevisionID="4"> Ray and Lory </Text>
      <Text>- pieces of metal THUMPING against car </Text>
      <Text RevisionID="7">hoods</Text>
      <Text>, CRACKING windshields. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4" Style="Bold+Italic">Atomi</Text>
      <Text RevisionID="7" Style="Bold+Italic">z</Text>
      <Text RevisionID="4" Style="Bold+Italic">ed fragments of the Indycar rac</Text>
      <Text RevisionID="7" Style="Bold+Italic">e</Text>
      <Text RevisionID="4" Style="Bold+Italic"> towards</Text>
      <Text RevisionID="7" Style="Bold+Italic"> it and</Text>
      <Text RevisionID="4" Style="Bold+Italic"> congeal</Text>
      <Text RevisionID="7" Style="Bold+Italic"> </Text>
      <Text RevisionID="4" Style="Bold+Italic">as it uncrumples from the barrier.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">The </Text>
      <Text RevisionID="5">patter </Text>
      <Text RevisionID="4">of debris </Text>
      <Text RevisionID="5">subsides</Text>
      <Text RevisionID="4">. </Text>
      <Text RevisionID="5">Thundering silence as the</Text>
      <Text RevisionID="4"> mushroom cloud widens in the sky.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4" Style="Bold+Italic">A smoke-stack is sucked into the burning Indycar.</Text>
      <Text RevisionID="4" Style="Italic"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="7">lifts himself off Lory</Text>
      <Text>. Bits of glass falling off his back. He pats her down. Checking for cuts or wounds.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">LORY, ARE YOU OK</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dad, I'm fine. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Smoke and debris. The blast smoke clears. Police Officer </Text>
      <Text>Carris moving car to car, looking for injured. Finding them.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">ARE YOU INJURED?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We don't think so.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">THEN GET BACK IN YOUR VEHICLE AND </Text>
      <Text RevisionID="2" Style="Underline">STAY THERE</Text>
      <Text RevisionID="2">!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray pulls Lory into motion, away from the crash site.</Text>
      <Text RevisionID="4"> They walk amidst a chorus of car alarms.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="59">
      <SceneProperties Length="1/8" Page="23" Title=""/>
      <Text>EXT. EYE IN THE SKY -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>CNN helicopter THUNDERS above the RAGING FIRE below. SIRENS SCREAM as more emergency service vehicles race to the scene.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="60">
      <SceneProperties Length="2/8" Page="23" Title=""/>
      <Text>EXT. FREEWAY -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory trudge wearily back towards the Mustang. The punishing sun soaking them through with sweat. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Wait a sec. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She turns as he puts his hand to his bad knee. He </Text>
      <Text RevisionID="4">pauses a moment,</Text>
      <Text> looking at the hellish scene behind him.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="62">
      <SceneProperties Length="3/8" Page="23" Title=""/>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory arrive</Text>
      <Text RevisionID="2"> at the Mustang. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">They find</Text>
      <Text> </Text>
      <Text RevisionID="1">Ned </Text>
      <Text RevisionID="2">standing behind it, </Text>
      <Text RevisionID="1">sweating and panting, like he's had a work out. </Text>
      <Text>He </Text>
      <Text RevisionID="1">pours</Text>
      <Text> water from a bottle onto the hot asphalt</Text>
      <Text RevisionID="1"> in front of the Dodge, almost </Text>
      <Text RevisionID="5">like a </Text>
      <Text RevisionID="1">ritual.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Out of the frying pan, Ray?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Get in the car</Text>
      <Text RevisionID="2"> Lory.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She gets in. Ray stares </Text>
      <Text RevisionID="2">at Ned.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="63">
      <SceneProperties Length="4" Page="24" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text RevisionID="1"> </Text>
      <Text>locks the doors. He holsters his phone</Text>
      <Text RevisionID="5"> and dials.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know that guy?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">He's just some asshole.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I saw </Text>
      <Text RevisionID="4">you</Text>
      <Text> talking to </Text>
      <Text RevisionID="4">him</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">-You've reached Deb, leave me something special after the jingle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(after the jingle)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Deb, change of plan. I don't need to pickup anymore, cancel Jay-Dee. I'm handling this myself.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned's silhouette in the front seat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory looks in the mirror as well and Ray tweaks it away.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's not just some asshole. Is this guy your bookie or something?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray rubs his face with his hands.</Text>
      <Text> </Text>
      <Text RevisionID="2">He wants to blank everything out for a second. </Text>
      <Text>Then he hears the sound of a lighter being sparked. Opens eyes to see Lory smoking</Text>
      <Text RevisionID="2">. Her cigarette hand is shaking. She's worried.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just tell me the truth. For once. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Any other time Ray would snatch </Text>
      <Text RevisionID="2">the </Text>
      <Text RevisionID="3">cigarette</Text>
      <Text> out of her hand. But her hand has a tremble, so she gets a pass.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Gimme </Text>
      <Text RevisionID="2">some of that.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She's surprised at the request. </Text>
      <Text RevisionID="2">She passes it to him. He smokes long and hard, and thinks how to say it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You're gonna think I'm crazy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Already do. Who is he?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Don't look back when I tell you this.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ned. That's the name he told me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">She cranes her head to look in the rearview.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">I said </Text>
      <Text RevisionID="3" Style="Underline">don't look back</Text>
      <Text RevisionID="3">. He might have eyes on us and I want the content of our conversation to be discre</Text>
      <Text RevisionID="7">et</Text>
      <Text RevisionID="3">. OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Do you know him?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Not until today. I seen him walking from the direction of the crash, he gets in the Dodge Ram behind us. I'm guessing now he was </Text>
      <Text RevisionID="5">un</Text>
      <Text RevisionID="3">invited.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah... wait. I saw someone else in </Text>
      <Text RevisionID="2">the driver's seat</Text>
      <Text>. A skinny guy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was alone in the car when it happened.</Text>
      <Text RevisionID="2">... </Text>
      <Text RevisionID="1">Ned and the Skinny Guy</Text>
      <Text> get into </Text>
      <Text RevisionID="2">some sort of</Text>
      <Text> struggle. And then... I think I saw the skinny guy get popped.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like, shot?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Didn't hear a shot. I saw </Text>
      <Text RevisionID="2">s</Text>
      <Text>kinny </Text>
      <Text RevisionID="2">g</Text>
      <Text>uy's head pump forward and back and go loose.</Text>
      <Text RevisionID="2"> Ragdoll.</Text>
      <Text> Jack in the box.</Text>
      <Text RevisionID="2"> Like the life was gone.</Text>
      <Text> </Text>
      <Text RevisionID="2">I think the b</Text>
      <Text>ody must still be in there.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">You're joking, right?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Wish I was. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">His stare tells her he's dead serious.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Tell the police what you saw. They'll arrest him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">I got advice. He might make bail. Then I'm the prime witness.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Maybe a body's all they need-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">You want to take that chance?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">OK, then. Just drive away.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">He knows I'm the only witness. And he knows who I am. That makes me a loose end. I wouldn't be hard to track down.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Make </Text>
      <Text RevisionID="4">an</Text>
      <Text> anonymous</Text>
      <Text RevisionID="4"> call</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And say what?</Text>
      <Text RevisionID="4"> I saw a murder?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Say you saw a gun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">But I didn't see a gun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">What if you did?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray stares at her.</Text>
      <Text RevisionID="5"> He taps his phone.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>CALL MARCO.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(it rings)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory, you have a devious mind.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Hey Ray - </Text>
      <Text RevisionID="3" Style="Italic">the rep likes the offer, he's pushing hard with Lucky's wife.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I await updates with bated breath. </Text>
      <Text RevisionID="2">Listen, I</Text>
      <Text> just wanted to ask your advice about this novel again.</Text>
      <Text RevisionID="3">..</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray nods to Lory so she gets his cover story.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I feel I got the hot hand creatively trapped in th</Text>
      <Text RevisionID="2">is</Text>
      <Text> jam, and if I don't crack it right now, I never will.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Billable hours?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">Whatever it takes to keep you talking, Marco.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Fire away.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What if my hero makes an anonymous tip-off to the police. Says he saw th</Text>
      <Text RevisionID="4">e perp</Text>
      <Text> </Text>
      <Text RevisionID="4">had a gun</Text>
      <Text>. So they investigate</Text>
      <Text RevisionID="4"> looking for a weapon</Text>
      <Text>, find the body</Text>
      <Text RevisionID="4">, lock the perp up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4" Style="Italic">I</Text>
      <Text Style="Italic">f the call is anonymous, they can't search the passenger compartment. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what can they do?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Look through windows or open doors. Run the plates. Ask </Text>
      <Text RevisionID="2" Style="Italic">the perp</Text>
      <Text Style="Italic"> to </Text>
      <Text RevisionID="2" Style="Italic">step</Text>
      <Text Style="Italic"> out of the vehicle </Text>
      <Text RevisionID="2" Style="Italic">while they</Text>
      <Text Style="Italic"> check </Text>
      <Text RevisionID="2" Style="Italic">the</Text>
      <Text Style="Italic"> license-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If they run the plates, they'll find out the car isn't his.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Correct. And once the vehicle is impounded, they can do a search.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>OK, all clear. Thanks Marco.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hangs up and looks to Lory.</Text>
      <Text RevisionID="2"> She fishes out</Text>
      <Text RevisionID="7"> a BURNER PHONE from her bag.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">This is a burner.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What you got a burner for?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Same reason you d</Text>
      <Text RevisionID="7">o</Text>
      <Text RevisionID="2">.</Text>
      <Text RevisionID="5"> To hide numbers from mom.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Off his look, </Text>
      <Text>Lory dials 9</Text>
      <Text RevisionID="5">-</Text>
      <Text>1</Text>
      <Text RevisionID="5">-</Text>
      <Text>1, tilting the- </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: </Text>
      <Text RevisionID="2">bringing </Text>
      <Text>the plates on the Dodge into view.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="64">
      <SceneProperties Length="1/8" Page="28" Title=""/>
      <Text RevisionID="4">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned's face is lit by the glow of his phone screen. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Gloved</Text>
      <Text RevisionID="4"> finger scroll</Text>
      <Text RevisionID="7">ing</Text>
      <Text RevisionID="4"> YouTube clips of the Ray Spear crash. </Text>
      <Text RevisionID="7">The</Text>
      <Text RevisionID="4"> point of impact</Text>
      <Text RevisionID="7"> with the black Indycar</Text>
      <Text RevisionID="4">.</Text>
      <Text RevisionID="7"> </Text>
      <Text RevisionID="4">Ned scrubs it back and forth</Text>
      <Text RevisionID="7">.</Text>
      <Text RevisionID="4"> </Text>
      <Text RevisionID="7">O</Text>
      <Text RevisionID="4">bsessive.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="65">
      <SceneProperties Length="1" Page="28" Title=""/>
      <Text RevisionID="4">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory and Ray sit waiting. 
REARVIEW: </Text>
      <Text RevisionID="7">Ned's </Text>
      <Text>silhouette</Text>
      <Text RevisionID="7">. Ever watchful.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I could really use a joint right now.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Not a good habit.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like you never had a tote.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="7">As a kid, maybe. </Text>
      <Text RevisionID="2">E</Text>
      <Text>nough to know it wasn't for me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what did you do for kicks?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Boost cars.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="2">(off her look)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'd hotwire 'em. Take 'em out for a spin. Treat 'em real nice. Wipe 'em down for prints and leave 'em in a well</Text>
      <Text RevisionID="7">-</Text>
      <Text>lit parking lot.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Shit. That's gangster.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fights too. I put guys in the hospital.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You never told me this.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Because I didn't want you to repeat my mistakes. But it turns out you're holding yourself to an image of me you can't possibly compare to. So now you know. And maybe you'll give yourself a bit more of a break.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray catches sight of </Text>
      <Text RevisionID="7">Officer </Text>
      <Text>Carris's Harle</Text>
      <Text RevisionID="4">y approaching.</Text>
      <Text RevisionID="7"> Officer </Text>
      <Text>L</Text>
      <Text RevisionID="7">ennox</Text>
      <Text RevisionID="5"> riding</Text>
      <Text> </Text>
      <Text RevisionID="7">pillion</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">She kickstands the bike. They</Text>
      <Text> dismount</Text>
      <Text RevisionID="2"> and take helmets off</Text>
      <Text>.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="7">A passing look </Text>
      <Text RevisionID="2">into the Mustang</Text>
      <Text RevisionID="7"> - they clock </Text>
      <Text RevisionID="2">Ray and Lory. Then the focus</Text>
      <Text RevisionID="7"> shifts to the </Text>
      <Text RevisionID="2">Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Carris circles the Dodge</Text>
      <Text RevisionID="3">, </Text>
      <Text RevisionID="7">unclipping</Text>
      <Text RevisionID="3"> her holster.</Text>
      <Text> She taps the</Text>
      <Text RevisionID="3"> driver's</Text>
      <Text> window and backs away.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="29" Title=""/>
      <Text RevisionID="5">EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Lennox </Text>
      <Text RevisionID="7">covers from</Text>
      <Text RevisionID="3"> the engine block. </Text>
      <Text RevisionID="7">A</Text>
      <Text RevisionID="3">ngled to ambush Ned if required, the box trailer taking stray shots.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="2">winds</Text>
      <Text> </Text>
      <Text RevisionID="2">down</Text>
      <Text RevisionID="3"> the window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, </Text>
      <Text RevisionID="2">mind stepping</Text>
      <Text> out of the vehicle with </Text>
      <Text RevisionID="2">your </Text>
      <Text>license and registration?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sure.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned reaches for glove box. Her hand </Text>
      <Text RevisionID="7">finds her</Text>
      <Text> gun grip.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Slow now</Text>
      <Text RevisionID="7">, slow...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">...a</Text>
      <Text RevisionID="1">s</Text>
      <Text> molasses</Text>
      <Text RevisionID="1"> in January.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">He slowly </Text>
      <Text RevisionID="5">takes out</Text>
      <Text RevisionID="2"> the registration. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris observes the mess inside. A NAVAJO BLANKET over the backseat. </Text>
      <Text RevisionID="7" Style="Italic">Something</Text>
      <Text RevisionID="2"> heavy</Text>
      <Text> beneath.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="71">
      <SceneProperties Length="1 5/8" Page="29" Title=""/>
      <Text RevisionID="7">INTERCUT -- </Text>
      <Text RevisionID="5">DODGE </Text>
      <Text RevisionID="7">&amp;</Text>
      <Text RevisionID="5"> MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory watching the scene.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Cop should have seen it by now.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It </Text>
      <Text RevisionID="2">must</Text>
      <Text> be </Text>
      <Text RevisionID="1">hidden</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned takes his</Text>
      <Text RevisionID="7"> driving</Text>
      <Text> license </Text>
      <Text RevisionID="2">and a pack of cigarette</Text>
      <Text RevisionID="3">s</Text>
      <Text RevisionID="2"> </Text>
      <Text>from </Text>
      <Text RevisionID="7">his </Text>
      <Text>shirt pocket</Text>
      <Text RevisionID="2">. </Text>
      <Text RevisionID="7">Hands license</Text>
      <Text RevisionID="2"> to Carris</Text>
      <Text RevisionID="7">. C</Text>
      <Text RevisionID="2">igarette</Text>
      <Text RevisionID="7">s</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="7">he keeps</Text>
      <Text RevisionID="2">. </Text>
      <Text>Carris steps back and taps her radio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">I need a 10-27, over.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox notes Ned listening to the dispatch chatter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, do you have a firearm on your person or in this vehicle?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No, I don't. Not on me. Not in the car. And as I understand it, it's an offense in this state to carry a concealed weapon without a license. And I'm a law abiding citizen.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text RevisionID="7">signals</Text>
      <Text> Lennox </Text>
      <Text RevisionID="7">- a word aside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">K</Text>
      <Text>eep your hands where we can see them and remain outside the vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned sparks a cigarette</Text>
      <Text RevisionID="2">.</Text>
      <Text RevisionID="7"> Hands visible, technically.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>C</Text>
      <Text RevisionID="3">arris</Text>
      <Text> and L</Text>
      <Text RevisionID="3">ennox</Text>
      <Text> </Text>
      <Text RevisionID="7">step away</Text>
      <Text>. Out of earshot from Ned, but close enough for Lory and Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">No outstanding warrants. Arrests for larceny, GTA... no convictions. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory listening.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What about the vehicle?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Confirmed with Hertz. Registered to Ned Booles and </Text>
      <Text RevisionID="3">a </Text>
      <Text>Clyde Burkman.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory whispers</Text>
      <Text RevisionID="7"> to Ray</Text>
      <Text>, who is </Text>
      <Text RevisionID="7">locked in</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">I don't understand. The car is his?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">The situation is more complex than that which it first appear</Text>
      <Text RevisionID="7">ed</Text>
      <Text RevisionID="3">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">If they don't search the car-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">-he gets away with it. </Text>
      <Text RevisionID="3" Style="Underline">I know, OK</Text>
      <Text RevisionID="3">?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris and Lennox return to the </Text>
      <Text RevisionID="5">Dodge</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sir, we'd like to have look inside your vehicle. Is that OK?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm not obliged to, am I? Fact you're asking means you don't have probable cause. So, no, you cannot.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">A glance between the cops.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned </Text>
      <Text RevisionID="7">catches Ray's eye. A</Text>
      <Text> </Text>
      <Text RevisionID="7">grin says h</Text>
      <Text>e's winning. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">A door opens. Lory is getting out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory, get the hell back-</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="71E">
      <SceneProperties Length="1/8" Page="31" Title=""/>
      <Text>EXT. MUSTANG &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY (O.S</Text>
      <Text RevisionID="2">.</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Officer! Can I have a word?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris and Lennox turn to observe Lory standing outside the Mustang. They glance at each other</Text>
      <Text RevisionID="3">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="71F">
      <SceneProperties Length="3/8" Page="31" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Lory led to the shoulder. </Text>
      <Text RevisionID="7">Talking to </Text>
      <Text RevisionID="2">the cops. </Text>
      <Text RevisionID="1">Carris</Text>
      <Text RevisionID="7"> taking notes</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">REARVIEW: Ned is watching too</Text>
      <Text>.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3" Style="Italic">Not good</Text>
      <Text RevisionID="2">.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">The</Text>
      <Text> pow-wow break</Text>
      <Text RevisionID="7">s</Text>
      <Text> up</Text>
      <Text RevisionID="7">.</Text>
      <Text> </Text>
      <Text RevisionID="7">Lory slams back into the car. Silence.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I told you not to get involved-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-they needed a name</Text>
      <Text RevisionID="3"> on the call</Text>
      <Text> to search the vehicle, OK? My name.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="72">
      <SceneProperties Length="2/8" Page="32" Title=""/>
      <Text>EXT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris and Lennox return, cock of the walk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Guess that little girlie just gave you probable cause. Does that mean you gonna give me the </Text>
      <Text RevisionID="1">reach-around</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He lifts his arms. Sweat</Text>
      <Text RevisionID="7">-dark </Text>
      <Text>armpits.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'll do it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="73">
      <SceneProperties Length="1/8" Page="32" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned looks towards Ray as he is frisked by Lennox.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="74">
      <SceneProperties Length="2/8" Page="32" Title=""/>
      <Text RevisionID="3">INT. / </Text>
      <Text>EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text RevisionID="7">searches </Text>
      <Text>the interior. </Text>
      <Text RevisionID="7">G</Text>
      <Text>love box. </Text>
      <Text RevisionID="7">Seat</Text>
      <Text> pockets. </Text>
      <Text RevisionID="7">U</Text>
      <Text>nder the seats. </Text>
      <Text RevisionID="7">Running fingers along the</Text>
      <Text> </Text>
      <Text RevisionID="7">upholstery.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Something big and chunky under the Navajo blanket. We're waiting for Carris to investigate it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris's nose twitches at a strange smell. She looks towards the blanket. </Text>
      <Text RevisionID="7">Pulls it</Text>
      <Text> back, revealing</Text>
      <Text RevisionID="2">...</Text>
      <Text> the toolbox. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text Style="Underline">No body</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="75">
      <SceneProperties Length="1/8" Page="32" Title=""/>
      <Text>INT. MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ray watches Carris get out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">He put the body in the trunk. I saw the seats down... the son of a bitch was putting it in the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="76">
      <SceneProperties Length="1/8" Page="32" Title=""/>
      <Text>EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris sets the toolbox down</Text>
      <Text RevisionID="7">. O</Text>
      <Text>pen</Text>
      <Text RevisionID="7">s</Text>
      <Text> it up. </Text>
      <Text RevisionID="7">L</Text>
      <Text RevisionID="2">ifts out a</Text>
      <Text> MODIFIED IMPACT WRENCH. She holds it </Text>
      <Text RevisionID="2">out </Text>
      <Text>like a gun.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Impact wrench</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="77">
      <SceneProperties Length="1/8" Page="33" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray and Lory watching.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look in the goddamn trunk.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="78">
      <SceneProperties Length="1 6/8" Page="33" Title=""/>
      <Text>EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">It's been modified.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Oh, you know your tools girl. Weekends spent with daddy under a crankshaft?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Lennox </Text>
      <Text RevisionID="7">bristles</Text>
      <Text RevisionID="2"> but Carris raises a hand. </Text>
      <Text RevisionID="7">Easy</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">What have you done</Text>
      <Text RevisionID="2"> with it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Weren't me. Was my</Text>
      <Text> partner Clyde. Redirect</Text>
      <Text RevisionID="3">s</Text>
      <Text> the rotational energy</Text>
      <Text RevisionID="2"> along the horizontal axis</Text>
      <Text RevisionID="3"> with the same force. More like a hammer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Why?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Why not? Ain't illegal, is it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Carris</Text>
      <Text> </Text>
      <Text RevisionID="7">signals to Lennox.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're gonna take a look in your trunk</Text>
      <Text RevisionID="1"> now, OK</Text>
      <Text> </Text>
      <Text RevisionID="1">s</Text>
      <Text>ir?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">There you go again, phrasing that real</Text>
      <Text> careful</Text>
      <Text RevisionID="2">. Means</Text>
      <Text> you need my permission, right?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We have probable cause to search-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-what I can reach. And in </Text>
      <Text RevisionID="1">a Terry stop</Text>
      <Text>, that's the passenger compartment. Not the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You seem p</Text>
      <Text>retty keen </Text>
      <Text RevisionID="7">on</Text>
      <Text> us not look</Text>
      <Text RevisionID="7">ing</Text>
      <Text> in there.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">R</Text>
      <Text>efusal to agree to a search is not in itself probable cause. Florida Versus Bostick. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox looks to Carris. </Text>
      <Text RevisionID="7">Both</Text>
      <Text> pissed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh I can tell what you're thinking. Let's make some shit up. Now this was some roadside stop, I'd let you, because you could always make up some goddamn probable cause, which could put me in a lot more trouble, like a cell, or a hole in the ground. But in the right here, right now, I got witnesses, like my man over here, and my people here, and my Jimmy Hoffa girl up there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The cops see everyone named is paying attention.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">We'll get a warrant.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Go get it, ma'am. C</Text>
      <Text>ome back with a warrant</Text>
      <Text RevisionID="2">, </Text>
      <Text>you'll open her up and find a spare tire, crank</Text>
      <Text RevisionID="2">,</Text>
      <Text> dirty oil cloth. And I'll get a big ole giggle out of that. Shall we dance? I could use the entertainment out here in this heat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris looks to Lennox. She gives the </Text>
      <Text RevisionID="3">smallest</Text>
      <Text> </Text>
      <Text RevisionID="7">head</Text>
      <Text>shake. </Text>
      <Text Style="Italic">Leave it</Text>
      <Text>. </Text>
      <Text RevisionID="7">H</Text>
      <Text>ands Ned</Text>
      <Text RevisionID="3"> his</Text>
      <Text> documents.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Next turn-off, you go get the windshield fixed. Because I would take a great deal of pleasure in arresting you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, I know </Text>
      <Text RevisionID="2">it</Text>
      <Text>, ma'am. You can give me the </Text>
      <Text RevisionID="1">reach-around</Text>
      <Text> anytime. One on one.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="84">
      <SceneProperties Length="7/8" Page="35" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Watching the stop wrapping up. Ned gets back in the Dodge. Ray looks at Lory. Worried he's going mad.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lory... I know what I saw.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>C</Text>
      <Text RevisionID="2">arris</Text>
      <Text> </Text>
      <Text RevisionID="2">taps Ray's window. He</Text>
      <Text> </Text>
      <Text RevisionID="7">lowers it</Text>
      <Text>.</Text>
      <Text RevisionID="2"> She</Text>
      <Text> </Text>
      <Text RevisionID="2">leans</Text>
      <Text> in. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think the caller was mistaken. I think that tool I lifted up could have been what they </Text>
      <Text RevisionID="3">seen</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look in the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Working on it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris is about to leave. Ray stops her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Meantime o</Text>
      <Text>fficer</Text>
      <Text RevisionID="2">, </Text>
      <Text>you mind </Text>
      <Text RevisionID="2">Lory stays </Text>
      <Text>up </Text>
      <Text RevisionID="2">with you </Text>
      <Text>near the </Text>
      <Text RevisionID="2">police </Text>
      <Text>tape?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We need to keep the site clear for first responders.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I just want to prevent a situation.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text RevisionID="7">eyes</Text>
      <Text> Ned. </Text>
      <Text RevisionID="7">Sees</Text>
      <Text> the potential flare-up. Her radio squawks. She taps to respond.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(into mic)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thirty-four Mary nine, to dispatch, on my way.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="2">(to Lennox)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You mind checking tail-lights and taking the slow way back? I might have another rider.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory looks at Ray</Text>
      <Text RevisionID="3">, worried for him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'll be fine.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3" Style="Underline">Go</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="85">
      <SceneProperties Length="2/8" Page="36" Title=""/>
      <Text>EXT. -- MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray watches </Text>
      <Text>Lory approach the </Text>
      <Text RevisionID="4">Harley</Text>
      <Text>. </Text>
      <Text RevisionID="7">Takes a helmet.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I thought LAPD </Text>
      <Text RevisionID="1">rode</Text>
      <Text> Beemers now.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They got the </Text>
      <Text RevisionID="2">new </Text>
      <Text>contrac</Text>
      <Text RevisionID="1">t</Text>
      <Text>. But </Text>
      <Text RevisionID="2">inventory let me hang</Text>
      <Text> onto </Text>
      <Text RevisionID="2">the Harley.</Text>
      <Text> </Text>
      <Text RevisionID="2">H</Text>
      <Text>eavier, lower to the ground, easier</Text>
      <Text RevisionID="2"> </Text>
      <Text>to maneuver. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text RevisionID="7">mounts up,</Text>
      <Text> puts arms around Carris. </Text>
      <Text RevisionID="7">One</Text>
      <Text> </Text>
      <Text RevisionID="7">l</Text>
      <Text>ook back at Ray as the Harley takes off.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="86">
      <SceneProperties Length="6/8" Page="36" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text RevisionID="2"> </Text>
      <Text>rais</Text>
      <Text RevisionID="2">es</Text>
      <Text> a hand</Text>
      <Text RevisionID="7"> to her</Text>
      <Text>. Next he turns </Text>
      <Text RevisionID="5">eyes to</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW:</Text>
      <Text> Ned. </Text>
      <Text RevisionID="1">Staring at him</Text>
      <Text RevisionID="2"> from the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray's phone rings and he answers it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">We got terms but there's one snag.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">Lucky's wife wants to speak to you before she signs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Eva? Why does Eva want to talk to me?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Italic">To</Text>
      <Text RevisionID="1" Style="Italic"> hear your side of the crash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">She's read the deposition-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">-she </Text>
      <Text RevisionID="2" Style="Italic">needs</Text>
      <Text RevisionID="1" Style="Italic"> to hear it </Text>
      <Text RevisionID="2" Style="Italic">from you </Text>
      <Text RevisionID="1" Style="Italic">directly</Text>
      <Text RevisionID="2" Style="Italic">,</Text>
      <Text RevisionID="1" Style="Italic"> Ray. </Text>
      <Text RevisionID="3" Style="Italic">I</Text>
      <Text RevisionID="2" Style="Italic">f</Text>
      <Text RevisionID="1" Style="Italic"> you can close her... she'll sign, and you'll be racing again.</Text>
      <Text RevisionID="3" Style="Italic"> Guaranteed.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Ray</Text>
      <Text RevisionID="1"> rubs his brow.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">OK</Text>
      <Text RevisionID="3">.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3">F</Text>
      <Text RevisionID="2">ine. </Text>
      <Text RevisionID="1">Tell </Text>
      <Text RevisionID="3">Eva</Text>
      <Text RevisionID="1"> to call me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">I'll give her your number-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">She's got my number. Listen, I got another angle on my story I wanted to run past you...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="87B">
      <SceneProperties Length="1/8" Page="37" Title=""/>
      <Text RevisionID="4">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned </Text>
      <Text RevisionID="7">threads</Text>
      <Text RevisionID="4"> fishwire through a fish-hook. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Loops a strip of</Text>
      <Text RevisionID="4"> double-sided electrical tape </Text>
      <Text RevisionID="7">around the hook. L</Text>
      <Text RevisionID="4">ets it dangle </Text>
      <Text RevisionID="7">around</Text>
      <Text RevisionID="4"> the rearview mirror and pulls on his black gloves.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="88">
      <SceneProperties Length="4/8" Page="37" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Italic">So y</Text>
      <Text Style="Italic">ou're writing a locked room mystery.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You'll need to e</Text>
      <Text RevisionID="1">xplain to me what that is.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: Ned step</Text>
      <Text RevisionID="5">s</Text>
      <Text RevisionID="4"> out of the Dodge</Text>
      <Text RevisionID="7">,</Text>
      <Text RevisionID="4"> holding something. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">An impossible crime has taken place in a confined space. Like a murder where the only door has been locked from the inside. Kind of a parlor game with your audience, so they can work out the solution.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: Ned makes his way behind the Prius. He crouches at the drain, his body blocking Ray's vantage.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="89">
      <SceneProperties Length="1/8" Page="37" Title=""/>
      <Text RevisionID="4">EXT. DRAIN</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned threads the sticky-tape hook between drain bars, careful</Text>
      <Text RevisionID="7"> not</Text>
      <Text RevisionID="4"> to </Text>
      <Text RevisionID="7">touch</Text>
      <Text RevisionID="4"> the sides.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">He clocks Walt watching him in his side-mirror. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned raises a finger to lips; shhhh....</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="90">
      <SceneProperties Length="1/8" Page="37" Title=""/>
      <Text RevisionID="4">INT. DRAIN</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">The sticky-tape hook is lowered down the shaft.</Text>
      <Text RevisionID="5"> We can see Ned looking down through the bars at us.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="90A">
      <SceneProperties Length="3 4/8" Page="38" Title=""/>
      <Text RevisionID="4">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW:</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="4">Ned is hunkered at the drain. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray doesn't like it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>OK. So I've written myself into a corner. Indulge me with solutions.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: Ned stands and </Text>
      <Text RevisionID="7">passes </Text>
      <Text RevisionID="4">the Prius. His hands coil</Text>
      <Text RevisionID="7">ing</Text>
      <Text RevisionID="4"> something that Ray cannot clearly see.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray opens the glove box, </Text>
      <Text RevisionID="7">searching</Text>
      <Text RevisionID="4"> for the </Text>
      <Text RevisionID="5">switchblade</Text>
      <Text RevisionID="4">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">The</Text>
      <Text Style="Italic"> body has to be hidden in the trunk. Or he's moved it elsewhere. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray's pushes aside the glove box contents. </Text>
      <Text RevisionID="4" Style="Underline">Finds nothing</Text>
      <Text RevisionID="4">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Or it was never in the car in the first place...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray becomes </Text>
      <Text RevisionID="1">frantic</Text>
      <Text>. He looks in the footwell.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Call you back-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray</Text>
      <Text> puts his hand down the passenger seat, checking underneath</Text>
      <Text RevisionID="7"> - when a</Text>
      <Text RevisionID="4"> shadow </Text>
      <Text>falls upon </Text>
      <Text RevisionID="2">him</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Stone cold mystery, ain't it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="7">at</Text>
      <Text> the passenger </Text>
      <Text RevisionID="2">door</Text>
      <Text>. Hips and menace.</Text>
      <Text RevisionID="4"> </Text>
      <Text RevisionID="7">F</Text>
      <Text RevisionID="4">ish-hook and fishwire </Text>
      <Text RevisionID="7">coiled</Text>
      <Text RevisionID="4"> in one hand. Like a garotte.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Fingerprints are a juicy thing. Now, wet ain't ideal, but all they need is a </Text>
      <Text RevisionID="7">smidgen</Text>
      <Text RevisionID="4"> and they can nail you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned </Text>
      <Text RevisionID="7">dangles</Text>
      <Text RevisionID="4"> the baggie </Text>
      <Text RevisionID="7">from</Text>
      <Text RevisionID="4"> the end of the fish-wire. </Text>
      <Text RevisionID="7">S</Text>
      <Text RevisionID="4">limed with sewer-gun</Text>
      <Text RevisionID="7">k, stuck to the sticky-tape.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Because being caught on possession with this would lose your racing license, wouldn't it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned reaches for the door handle. Ray blocks it.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know my AC ain't working Ray. And you don't strike me as the sort of guy who'd let a seat go to waste. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned just goes ahead and peels Ray's hand off </Text>
      <Text RevisionID="2">his, and opens the door. He </Text>
      <Text>sits inside</Text>
      <Text RevisionID="3"> and makes himself comfortable. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray discretely glances up to the cab of the 18-wheeler. Truck not paying attention. Then the Forester. No one is paying attention there either - </Text>
      <Text RevisionID="5">just</Text>
      <Text RevisionID="3"> the Chihuahua. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned hands the baggie over. Ra</Text>
      <Text RevisionID="7">y</Text>
      <Text RevisionID="4"> </Text>
      <Text RevisionID="7">shoves</Text>
      <Text RevisionID="4"> it under the dash.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ned</Text>
      <Text RevisionID="2"> sparks </Text>
      <Text RevisionID="3">a cigarette with </Text>
      <Text RevisionID="2">Ray's car lighter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Who you saw, his</Text>
      <Text> name was Clyde.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks at Ned carefully. Is he confessing?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He was an associate.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>More silence. Inviting questions. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">I t</Text>
      <Text>ake it you had a falling out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">D</Text>
      <Text RevisionID="1">idn't plan on things getting so heated out here in the open. I was gonna get Clyde to drive </Text>
      <Text RevisionID="2">us </Text>
      <Text RevisionID="1">some place private. But he was keen to get right to it. And you can't deny a man his showdown, can you Ray?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">What was you and Clyde into? Drugs?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">You worried my </Text>
      <Text RevisionID="1" Style="Italic">cartel associates</Text>
      <Text RevisionID="1"> gonna come gunning if you pop me? </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ned takes a drag of his cigarette.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Nah, me and Clyde were into B and Es. Home invasions in prosecutor parlance. High-end joints, high yield returns.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">So y</Text>
      <Text RevisionID="1">ou're a thief</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Oh, I've had many lives. Haven't you?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ned continues opening up to Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">This one time we was doing a house out in Pasadena. Cased it, thought it was unoccupied, but after we frosted the lock we busts in and finds two women. In bed together. I don't know who was more shocked! Real lookers Ray. Had to immobilize them, so Clyde hog-tied them with electric cable...once you see a woman hogtied, it gives you ideas, Ray. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray says nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Then it became less about the breakin' and enterin', and more just about the enterin', you know what I mean? And once you go down that path, only a matter of time before one of yous</Text>
      <Text RevisionID="7">e</Text>
      <Text RevisionID="1"> turns on the other. Even just to squeeze a bit more juice out of the situation. I guess Clyde figured it that way too, but he didn't want to try and shoot the devil in the back case he missed. So he ran.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ned fondles the Dodge keys to reveal a GPS device.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">I t</Text>
      <Text RevisionID="1">racked him all the way from Eagle Rock. Once I figured the route I managed to get ahead of him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lucky break with the jam. Else Clyde would have made </Text>
      <Text RevisionID="1">clean </Text>
      <Text>his departure</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, that weren't no lucky break.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A moment</Text>
      <Text RevisionID="1"> as Ray realizes...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The Sedan was your doing?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Got the job done, didn't it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Six dead</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Seven. Another just went in the hospital.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="2">stubs his cigarette. </Text>
      <Text>Looks at Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But </Text>
      <Text RevisionID="2">then </Text>
      <Text>you know what that's like, don't you Ray? Causing a pile-up with fatalities. I read it took a day for the burns to kill </Text>
      <Text RevisionID="2">Lucky</Text>
      <Text>. Hell, looked from the video you was toast as well.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It was an accident-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-it weren't no accident. I know it's a little phone screen but I can tell </Text>
      <Text Style="Italic">intent</Text>
      <Text> when I see it. You got an anger in you boy. I can smell it. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned smiles. Opens the car door and gets out. A curling finger appears at the window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Come hither. Got something to show you.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="91">
      <SceneProperties Length="1" Page="41" Title=""/>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="2">walks parallel to Ned </Text>
      <Text>the other side of the Mustang, </Text>
      <Text RevisionID="2">tracking him </Text>
      <Text>as he begins to walk </Text>
      <Text RevisionID="2">back </Text>
      <Text>to the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Warmer. Getting </Text>
      <Text RevisionID="2">warmer</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray breaks from the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Colder. Colder. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray moves back towards the trunk of the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Red hot Ray. And looks like we got company. You best grab it fast.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray follows Ned's eyeline towards the crash. A COP PARTY on their way. A K9 HANDLER and K9, snout against the </Text>
      <Text RevisionID="7">asphalt</Text>
      <Text>. Behind is Lennox, followed by Carris escorting Lory.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text RevisionID="2"> looks down and</Text>
      <Text> s</Text>
      <Text RevisionID="2">omething dark on the trunk handle.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">A smudge of blood. </Text>
      <Text>Heart racing... </Text>
      <Text RevisionID="1">Ray </Text>
      <Text>opens it a crack... then all the way...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>In the trunk: THE SKINNY </Text>
      <Text RevisionID="1">GUY</Text>
      <Text>. FOLDED UP AND </Text>
      <Text RevisionID="1" Style="Underline">VERY </Text>
      <Text Style="Underline">DEAD</Text>
      <Text>. LORY'S SWITCHBLADE IS</Text>
      <Text RevisionID="5"> STABBED </Text>
      <Text>DEEP IN</Text>
      <Text RevisionID="5">TO</Text>
      <Text> HIS RIBCAGE.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks at Ned, backing away to the Dodge. Ned raises his gloved hands like OJ to the jury. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Bet her</Text>
      <Text> juicy paw</Text>
      <Text RevisionID="2"> </Text>
      <Text>prints </Text>
      <Text RevisionID="2">is</Text>
      <Text> all over it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned sits back in the Dodge. Master of chaos. Table set. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray alternates looks between the body, the switchblade, Lory, the cop, back to the switchblade - </Text>
      <Text Style="Italic">fuck, fuck, FUCK!</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He SLAMS the trunk shut </Text>
      <Text RevisionID="1">- </Text>
      <Text>just as</Text>
      <Text RevisionID="1"> Carris arrives beside him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray, mind coming over here please?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches as the K9 HANDLER and K9 approach Ned's car, trailed by Lennox. The dog </Text>
      <Text RevisionID="2">goes wild at the array of scents</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="92">
      <SceneProperties Length="3/8" Page="42" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned moves the window down halfway, and watches as Handler and Lennox do a routine for his benefit.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Officer Lennox, my K9 is agitated and wants to explore this vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is it trained to detect firearms, drugs, cadavers?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Why yes </Text>
      <Text RevisionID="3">she</Text>
      <Text> is.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox taps the glass, hard, right by Ned's face.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="93">
      <SceneProperties Length="2/8" Page="43" Title=""/>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Ned get frisked</Text>
      <Text RevisionID="2"> roughly</Text>
      <Text> by Lennox. The K9 bares its teeth. Bitch has good instincts.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I understand you mightn't feel you can speak freely here</Text>
      <Text RevisionID="1">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-here's fine. Let's get </Text>
      <Text RevisionID="1">right to it</Text>
      <Text>. What'd you tell her Lory?</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="94">
      <SceneProperties Length="1/8" Page="43" Title=""/>
      <Text RevisionID="1">EXT. DODGE -- IN THE TRUNK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">The </Text>
      <Text RevisionID="3">trunk is opened</Text>
      <Text RevisionID="1"> to reveal Lennox</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3">inspecting it. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">We don't see what is inside</Text>
      <Text RevisionID="3">, but can see Ned's gloating smile over his shoulder.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="95">
      <SceneProperties Length="2 4/8" Page="43" Title=""/>
      <Text>EXT. MUSTANG</Text>
      <Text RevisionID="5"> &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray keeps his</Text>
      <Text> focus to the questioning with Carris. He bursts out laughing</Text>
      <Text RevisionID="1">, confusing Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">I never said any such thing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You can trust her-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Enough</Text>
      <Text RevisionID="3"> of all the bullshit Lory. Enough now.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Lory is silenced and confused.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Officer, </Text>
      <Text>I </Text>
      <Text RevisionID="1">think I </Text>
      <Text>see what's happened here. </Text>
      <Text RevisionID="3">My girl here's</Text>
      <Text> got bored sitting in this temporary parking lot</Text>
      <Text RevisionID="3">,</Text>
      <Text> and she called you guys to give</Text>
      <Text RevisionID="1"> herself</Text>
      <Text> a hoot with this little fantasy of hers</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Stop fucking lying.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Underline">Hey</Text>
      <Text RevisionID="2">. </Text>
      <Text RevisionID="1">Pack it down</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory restrains herself, mute and furious. Ray looks at Lory as he speaks. Making it more direct and personal.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Lory Ann Spear. Juvenile delinquent.</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="2">Look her up. </Text>
      <Text RevisionID="1">Seventeen years of age and already </Text>
      <Text RevisionID="2">got </Text>
      <Text RevisionID="1">a rap sheet.</Text>
      <Text> I just </Text>
      <Text RevisionID="1">lifted</Text>
      <Text> her after she bailed rehab. She's a compulsive attention seeker</Text>
      <Text RevisionID="2">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-YOU LYING PIECE OF SHIT.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory SHOVES Ray. He staggers back, hits the car </Text>
      <Text RevisionID="7">hood</Text>
      <Text>. Carris intervenes and separates her.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned savors the chaos</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Lory, g</Text>
      <Text>et inside the vehicle or you're under arrest.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">She doesn't move. Ray intervenes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You go to County I'</Text>
      <Text RevisionID="2">ll</Text>
      <Text> leave it to your mother to bail you out. And I don't know when she's </Text>
      <Text RevisionID="2">getting </Text>
      <Text>back from Vermont.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory makes a decision. Scales into the passenger seat.</Text>
      <Text RevisionID="2"> Alone, </Text>
      <Text>Ray speaks </Text>
      <Text RevisionID="2">softly</Text>
      <Text> to Carris.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm sure there's an offense in the statute books. But she's trying to go clean and I don't think a spell inside would do her good.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox and the Handler approach. Ray observes the K9 tug at the leash, trying to get to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">What'd you find?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENNOX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Spare ti</Text>
      <Text RevisionID="7">r</Text>
      <Text RevisionID="5">e. </Text>
      <Text>Dirty oil cloth. Crank</Text>
      <Text RevisionID="5">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Son of a bitch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Terry is going cray-cray over there</Text>
      <Text RevisionID="3">. Would love to strip the car down</Text>
      <Text> but I got nothing solid.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lennox and Carris both observe Ned's grin. Handler observes the K9's interest in the trunk of the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mighty interested in what's in there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray saunters from Carris towards the trunk</Text>
      <Text RevisionID="2">, puts his hand on the handl</Text>
      <Text RevisionID="3">e</Text>
      <Text RevisionID="2"> and covers the blood mark.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Supplies for a cookout, but we been stuck in this jam so long I think it's going off. I give </Text>
      <Text RevisionID="2">her </Text>
      <Text>a treat?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Handler raises a hand to stop him opening it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HANDLER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No thank you! Only the handler can. For discipline.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">T</Text>
      <Text>hink I read that somewhere.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Handler leads the feverish K9 away from the trunk. </Text>
      <Text RevisionID="2">As he</Text>
      <Text> clears </Text>
      <Text RevisionID="2">eyeline, Ray meets</Text>
      <Text> the watchful </Text>
      <Text RevisionID="2">gaze </Text>
      <Text>of Ned.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text RevisionID="2">surveys</Text>
      <Text> the whole scene. </Text>
      <Text RevisionID="2">Lory, convincing. </Text>
      <Text>Ray, cool as a cucumber. Ned, grinning like a Cheshire cat. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tell her no more tall tales</Text>
      <Text RevisionID="5">... else </Text>
      <Text>you'll be dialing for a bondsman</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Appreciated, officer.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The cops depart in the direction of the crash site. K9 snarls at Ray</Text>
      <Text RevisionID="1">, tugging</Text>
      <Text> at his leash as he's pulled a</Text>
      <Text RevisionID="1">way</Text>
      <Text>.</Text>
      <Text RevisionID="1"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A slow clap breaks out</Text>
      <Text RevisionID="2"> from Ned.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray Spear... you are one cool customer. I can see how you got the bones for the </Text>
      <Text RevisionID="2">speedway</Text>
      <Text>. Pure instinct, </Text>
      <Text Style="Italic">killer.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="102">
      <SceneProperties Length="2 6/8" Page="46" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="3">l</Text>
      <Text RevisionID="2">ocks the door.</Text>
      <Text> Lory</Text>
      <Text RevisionID="3">'s</Text>
      <Text> rage is silent and electric.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Don't fucking talk to me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm afraid we</Text>
      <Text RevisionID="1">'re</Text>
      <Text> go</Text>
      <Text RevisionID="2">ing to</Text>
      <Text> have to.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You made me look like a crazy person. You're a selfish, narcissistic prick.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He gives it a moment.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You done?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. I'm not done. I'm glad Mom left you. I'm glad I didn't have to grow up with you.</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="2">I fucking hate and despise you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He just </Text>
      <Text RevisionID="1">t</Text>
      <Text>akes it. Soaks it up.</Text>
      <Text RevisionID="1"> Waits.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Why'd you make me look like a liar?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So they would think the whole thing </Text>
      <Text RevisionID="2">was</Text>
      <Text> bullshit and move along.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is it, </Text>
      <Text Style="Underline">dad</Text>
      <Text>? Is it all bullshit? Is there no fucking body in that creep's trunk because you made it up?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">I didn't make it up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Then </Text>
      <Text RevisionID="1" Style="Underline">why</Text>
      <Text RevisionID="1">?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">I'll tel</Text>
      <Text RevisionID="4">l</Text>
      <Text RevisionID="2"> you. But w</Text>
      <Text RevisionID="1">hen I do, I don't want you looking back</Text>
      <Text RevisionID="2">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Underline">What is it</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The</Text>
      <Text RevisionID="1">re's no body in that creep's trunk...</Text>
      <Text> because the son of a bitch stuck it in ours.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory controls herself and doesn't look.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You've seen it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">I've seen it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is he dead?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Very much so. And I got more bad news. He's got your knife stuck in his ribs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Wait... you don't think I-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It's a </Text>
      <Text RevisionID="1" Style="Italic">setup</Text>
      <Text> Lory. </Text>
      <Text RevisionID="1">It's w</Text>
      <Text>hy I had to lie to the police.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">We</Text>
      <Text> got nothing to do with it, it's been planted, we don't even know-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-but it's </Text>
      <Text Style="Underline">my</Text>
      <Text> Mustang. And it</Text>
      <Text RevisionID="7">'</Text>
      <Text>s </Text>
      <Text Style="Underline">your</Text>
      <Text> knife. And the whole thing is a fucking mess.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He reaches to hold her hand</Text>
      <Text RevisionID="1">s</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Things I said, I didn't mean. I had to hurt you, for real, to sell it.</Text>
      <Text RevisionID="1"> Bait </Text>
      <Text RevisionID="3">them</Text>
      <Text RevisionID="1"> with emotion so she wouldn't get the scent.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. I get it. I didn't mean what I said, either.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah, you did. Long called for.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She grows more resolute. Looks at him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I need to know this is </Text>
      <Text RevisionID="1">for </Text>
      <Text>real. I need to see it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No way. You're not opening that fucking trunk. He's gonna be right there, watching you, he'll know-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-he knows we're in it together. </Text>
      <Text RevisionID="1">I mean, w</Text>
      <Text>e are, aren't we?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He </Text>
      <Text Style="Underline">suspects</Text>
      <Text>. Suspecting ain't knowing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Think he'll take that chance?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray's phone rings. MARCO.</Text>
      <Text RevisionID="2"> It rings and rings. </Text>
      <Text RevisionID="1">Lory opens the door, defiant.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="1">(whispers)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">And I want my fucking knife back</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray... lets her go.</Text>
      <Text RevisionID="2"> He answers the call and</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="2">watches her in the mirrors, keeping his eye on </Text>
      <Text RevisionID="1">Ned's car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Hey Ray, you spoken to Eva yet?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">She ain't called. Not sure she will.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">I'm worried this deal's gonna slip away if we don't close today.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Soon as she rings, I'll let you know. </Text>
      <Text RevisionID="1">But saying as I got you</Text>
      <Text RevisionID="2"> on the blower...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="103">
      <SceneProperties Length="1/8" Page="48" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="2">stares at</Text>
      <Text> Lory as she approaches the trunk. Places a hand on handle. Tentative.</Text>
      <Text RevisionID="2"> She looks at Ned for a moment.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="108">
      <SceneProperties Length="1/8" Page="49" Title=""/>
      <Text>INT. MUSTANG -- INSIDE TRUNK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Light cracks open an inch and Lory opens the trunk. She catches a glimpse of Clyde and slams it shut.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="108A">
      <SceneProperties Length="3/8" Page="49" Title=""/>
      <Text RevisionID="1">INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Watching Lory carefully, visible now the trunk is closed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Italic">I mean it's convoluted-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">But you follow.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Italic">Body in the trunk, daughter's knife with her DNA in the body...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray can see Ned watching. He slips his hand to the door handle, ready to spring out if required.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="109">
      <SceneProperties Length="1/8" Page="49" Title=""/>
      <Text>INT. DODGE -- THRU WINDSHIELD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned watches Lory back away from the trunk. She makes eye contact with Ned, disgusted. His breath is heavy watching her. She turns away. Steels herself. Opens the trunk again.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="110">
      <SceneProperties Length="1/8" Page="49" Title=""/>
      <Text>INT. MUSTANG -- INSIDE TRUNK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory reaches </Text>
      <Text RevisionID="5">for </Text>
      <Text>the rose-embroidered </Text>
      <Text RevisionID="5">knife </Text>
      <Text>handle. </Text>
      <Text RevisionID="5">She pulls at it. It won't come easy - w</Text>
      <Text>edged</Text>
      <Text RevisionID="5"> too</Text>
      <Text> deep</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Finally it loosens, slick with ribcage gore.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">She folds it shut, and </Text>
      <Text RevisionID="5">closes the trunk with her clean hand.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="111">
      <SceneProperties Length="2 7/8" Page="49" Title=""/>
      <Text>INT. MUSTANG -- LATER</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text RevisionID="3">uses wipes to </Text>
      <Text>clean blood</Text>
      <Text RevisionID="3"> from her hands and the switchblade. Ray continues his conversation with Marco.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">I don't love</Text>
      <Text RevisionID="4" Style="Italic"> your hero</Text>
      <Text Style="Italic"> lying to cops.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He was trying to retain optionality.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S</Text>
      <Text RevisionID="2">.</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">It's conspiracy after the fact.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can he back out</Text>
      <Text RevisionID="1"> now</Text>
      <Text>, say he panicked. Claim his life was under threat?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">He can't really c</Text>
      <Text Style="Italic">laim his life was under threat in the presence of police officers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what's he looking at?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Depends on his profile. Would you describe your hero as privileged? </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Very privileged. Privileged in a way he never realized.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">OK, so in today's prosecuting environment, that's a charging enhancement, not a plus. If I was a D.A. on the make, looking to make a high profile conviction... I would push a story to a jury that our guy is a co-conspirator.</Text>
      <Text RevisionID="2" Style="Italic"> </Text>
      <Text Style="Italic">You've got the daughter for leverage. And you got the psychopath angling for a plea deal as well. If I was on defense, and we were offered twenty years and the daughter walks... I'd take it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Why the</Text>
      <Text> hell would he take twenty years</Text>
      <Text RevisionID="2"> for something he didn't do</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARCO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Because Murder One is the death penalty, Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray opens his mouth to speak. It hits him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Appreciate the advice, Marco.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hangs up. He looks into-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>REARVIEW: Ned's smiling face. Ray snaps the mirror away</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">They sit in silence.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">You could beat it at trial.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Maybe. Maybe not. I'd be finished either way.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Not if you beat it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">There are stages of ruin Lory. There's the ruin of the investigation. Then the charge. Then the acquittal. I'd be done.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">So no cops.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Underline">No cops</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">She decides to play her hand.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Way I see it, this is a game of pass the parcel. </Text>
      <Text RevisionID="5">The parcel is in our trunk. </Text>
      <Text RevisionID="1">And we just need to work out what to do with the parcel.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You mean... dispose of it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">It solves the problem-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">-it</Text>
      <Text RevisionID="1"> make</Text>
      <Text RevisionID="2">s</Text>
      <Text RevisionID="1"> me an accessory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">And not a witness</Text>
      <Text RevisionID="2">, right. No reason to come after you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray </Text>
      <Text RevisionID="2">gets the logic.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I know a guy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know a guy. Great.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Underline">Mateo</Text>
      <Text>. Works at a scrap</Text>
      <Text RevisionID="3"> </Text>
      <Text>yard. I mean, he's really a mechanic and he'd love to work pit but-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-how can "Mateo" help us?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Pay him cash, and this car is just another cube in a junkyard. And so is whatever is in the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You haven't thought this through. "Mateo" could put the squeeze on </Text>
      <Text RevisionID="5">me</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He won't.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You can't be sure.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Trust me. He's not going to the cops.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looks at her, and her gaze tells him everything.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How old is this creep?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Twenty. And he's not a creep, it was me doing the chasing</Text>
      <Text RevisionID="2">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">G</Text>
      <Text>ive me his </Text>
      <Text RevisionID="2">fucking </Text>
      <Text>number.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="112">
      <SceneProperties Length="1 6/8" Page="52" Title=""/>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="2">walks to the shoulder</Text>
      <Text>, phone to ear.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Am I speaking to Mateo?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Who is this?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ray Spear here.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm Lory's father.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Oh - Mr Spear - I know you - it's like an honor-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-Lory tells me you work at a scrap</Text>
      <Text RevisionID="3"> </Text>
      <Text>yard.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Yeah, like, I manage here but I'm really a mechanic, looking to hustle-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-I need a car scrapped Mateo. And the hustle I need is that it's done tonight, and it's off the books.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">I mean, Mr. Spear, sir, I'd like to help but we need to book you in. I gotta follow the law, you know-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Follow the law Mateo? Seriously? Let</Text>
      <Text RevisionID="2">'</Text>
      <Text>s cut to the chase. Lory told me about you guys.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">What? Jesus-fuck, look - listen - I don't know, I don't know what-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm not interested in explanations. I'm interested in discretion. Is discretion something you're interested in?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(silence)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Answer me Mateo.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(a whisper)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Yes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can you do the thing that I'm asking you to do?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Yeah, I can do it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I imagine your yard got surveillance cameras and record-keeping.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">I open her up for a night shift, I control the environment. It'll be on the down-low.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What happens to the blocks on the yard?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">We aggregate them and ship them to China. Container ships.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray begins moving back to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm gonna call you later to arrange. And we'll need to talk about the other thing. I won't hurt you or call the cops, but I am her father. You understand?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MATEO (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">I do, sir.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Keep </Text>
      <Text RevisionID="3">your</Text>
      <Text RevisionID="2"> phone charged</Text>
      <Text RevisionID="3">, the line clear and wait on my call.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray eyeballs Ned in the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="113">
      <SceneProperties Length="1" Page="54" Title=""/>
      <Text>INT. MUSTANG -- CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="2">gets in</Text>
      <Text> and reholsters the phone. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mateo is on stand-by.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How'd he take it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Shit his pants, how do you think?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's actually a nice guy.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Seriously. He doesn't like me drinking</Text>
      <Text RevisionID="4"> or using</Text>
      <Text>. His family are Catholic and stuff. I've had dinner there.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Don't tell me you're looking for me to bless this thing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're only three years apart.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray's mind is on next steps. A decision.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">I need to lay this out to Ned. So as there's no misunderstanding.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She looks at him</Text>
      <Text RevisionID="2"> like he's crazy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">H</Text>
      <Text>e's been running a tight game. I don't see him getting sloppy in the last innings. Not with you to make some noise in the afterwards.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He turns to her, speaking closely.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But if </Text>
      <Text RevisionID="2">I am</Text>
      <Text> wrong... make some noise. You honk. You scream. You holler. </Text>
      <Text RevisionID="2">R</Text>
      <Text>un if you have to. And if he gets close</Text>
      <Text RevisionID="2">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">S</Text>
      <Text>tab</Text>
      <Text RevisionID="1">,</Text>
      <Text> don't slash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That's my girl.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">He gets out.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="114">
      <SceneProperties Length="3/8" Page="55" Title=""/>
      <Text>EXT. </Text>
      <Text RevisionID="2">MUSTANG -- CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray struts towards the Dodge. The showdown. Ned is already winding down the passenger-side window. </Text>
      <Text RevisionID="5">As he approaches we can hear the radio is playing </Text>
      <Text RevisionID="7">that strange 50s pop song.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">SINGER</Text>
      <Text RevisionID="5"> (O.S.</Text>
      <Text RevisionID="7">)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Italic">Want to tell her I'm her only man... want to tell her I'm her only man... I look for her every chan</Text>
      <Text RevisionID="7" Style="Italic">c</Text>
      <Text RevisionID="5" Style="Italic">e I can.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Big smile waiting for Ray; cat who's got the cream.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Been wondering when you'd come by.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Step into my office.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ned </Text>
      <Text RevisionID="5">opens the passenger door</Text>
      <Text RevisionID="2">. </Text>
      <Text>Ray glances at Lory,</Text>
      <Text RevisionID="5"> then climbs in.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="115">
      <SceneProperties Length="1 6/8" Page="56" Title=""/>
      <Text>INT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="2">locks the doors</Text>
      <Text RevisionID="5"> and winds up the window. It is dark and fetid inside; the seat feel</Text>
      <Text RevisionID="7">s</Text>
      <Text RevisionID="5"> sticky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">My father used to like this song.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Maybe you get to see him soon.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Underline">Phone</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned kills the radio. </Text>
      <Text RevisionID="1">Ray hands over his phone</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You ain't recording this</Text>
      <Text RevisionID="3">, are you</Text>
      <Text RevisionID="2">?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Shit. Should have thought of that.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Wouldn't be admissible anyway.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ned</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="1">takes the sunshade from the bac</Text>
      <Text RevisionID="4">k and mounts it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So as we got some privacy.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray's eyeline with Lory is cutoff. </Text>
      <Text>Ned reaches into the back and gives Ray a good sniff of his perspiration. He </Text>
      <Text RevisionID="1">pulls </Text>
      <Text>the impact wrench on</Text>
      <Text RevisionID="1">to</Text>
      <Text> his lap.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Clyde made this for delivering the </Text>
      <Text Style="Italic">coup de grace</Text>
      <Text> to a safe. By a twist of fate, </Text>
      <Text RevisionID="3">it turned out he forged the tool of his own demise.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned squeezes the trigger</Text>
      <Text RevisionID="5">... the head punches out like a xenomorph's mandible.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray doesn't react. Ned laughs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You don't break a sweat, do you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How does this end, Ned?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I guess you thinking we could just go our separate ways</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Long as Clyde disappears, you'</Text>
      <Text RevisionID="1">d be</Text>
      <Text> in the clear. </Text>
      <Text RevisionID="1">And I'd</Text>
      <Text> be an accessory. </Text>
      <Text RevisionID="1">Way I see it, we'd have </Text>
      <Text>the goods on each other</Text>
      <Text RevisionID="1">. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How you planning on disappearing Clyde?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Scrap yard. A close contact. No paperwork, no cameras.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>In the Mustang? More of a sin than what I did to Clyde. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Best to be thorough. Forensics. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned bursts into a belly laugh.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You come up with that you</Text>
      <Text RevisionID="1">r</Text>
      <Text>self?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm adapting.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No, you discovering who you really are, </Text>
      <Text Style="Italic">killer</Text>
      <Text>. When you woke up for breakfast, you ever imagined this here conversation was lying in store for you? Like that fuel tank driver, when he pulled on his pants this morning, he had no conception he was gonna be driving down this freeway... </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="118">
      <SceneProperties Length="2/8" Page="57" Title=""/>
      <Text>INT. FUEL TANKER -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Through </Text>
      <Text RevisionID="5">the</Text>
      <Text> windshield</Text>
      <Text RevisionID="5"> of the tanker</Text>
      <Text>,</Text>
      <Text RevisionID="5"> we can see</Text>
      <Text> the Sedan levitate upwards.</Text>
      <Text RevisionID="4"> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">... and out of nowhere a fucking Sedan was going to drop down in front of him like a piano grand.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="119">
      <SceneProperties Length="1/8" Page="58" Title=""/>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Got me thinking about </Text>
      <Text Style="Italic">time's arrow </Text>
      <Text>Ray. I read it in a physics book once, by that</Text>
      <Text RevisionID="2"> spastic</Text>
      <Text RevisionID="3"> fella.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="120">
      <SceneProperties Length="2/8" Page="58" Title=""/>
      <Text>INT. SEDAN -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">The eyes of the SEDAN DRIVER</Text>
      <Text> stare into space - he's </Text>
      <Text RevisionID="2">already </Text>
      <Text>dead. His head bobs as </Text>
      <Text RevisionID="2">the Sedan</Text>
      <Text> </Text>
      <Text RevisionID="2">floats up</Text>
      <Text> from the road.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">And what I learned is some things in the universe have properties, that you can flip, back to front.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="121">
      <SceneProperties Length="2/8" Page="58" Title=""/>
      <Text>EXT. FREEWAY OVERPASS -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Sedan floats upwards through the air. An inverted swandive, arcing through towards the overpass.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Now you look in a mirror, left is right and right is left. Everything's reversed, but it ain't fundamentally different.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="122">
      <SceneProperties Length="2/8" Page="58" Title=""/>
      <Text>EXT. OVERPASS -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Sedan lands on the overpass, reverses away from the precipice to the safety of solid asphalt.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">But time is different. Each direction of time has a specific flavor. Things running forwards ain't the same as things reversed, reversed again.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="123">
      <SceneProperties Length="1/8" Page="58" Title=""/>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You ever see a newborn's eyes light up? Spark of life for the first time?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I seen it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="124">
      <SceneProperties Length="4/8" Page="59" Title=""/>
      <Text>INT. SEDAN -- THRU WINDSHIELD -- REVERSED FOOTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Sedan Driver's </Text>
      <Text>head is slumped forward. A puncture wound in his neck, blood rushing inside it. The Sedan loses momentum as the door opens</Text>
      <Text RevisionID="4"> and</Text>
      <Text> Ned p</Text>
      <Text RevisionID="4">ulls </Text>
      <Text>the side pillar.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Now, I seen the lights go out in someone's eyes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Sedan slows and Ned yanks the handbrake. He puts handcuffs onto the dead </Text>
      <Text RevisionID="4">Sedan Driver.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">And it ain't just the reverse of the lights coming on. You get a real sense that which is extinguished can never be lit again. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned</Text>
      <Text RevisionID="4"> lifts the impact wrench to the </Text>
      <Text>wound in the </Text>
      <Text RevisionID="4">Sedan Driver</Text>
      <Text>'s neck</Text>
      <Text RevisionID="4">. Blood rushes inside as he plugs the wound.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">His head snaps back, coming to life, turning to Ned.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Sedan Driver's eyes open and wide and pleading, tears inverting up into his eye sockets...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="125">
      <SceneProperties Length="2" Page="59" Title=""/>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned lets his thoughts sit there, simmering.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I guess what I'm saying is, I think we was always gonna meet Ray. </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We're like two particles destined to collide. One going forwards in time. The other backwards. And only one of us is gonna exist afterwards.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">You know what? </Text>
      <Text RevisionID="3">It was a mistake trying to reason with you</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="2">reaches to unlock</Text>
      <Text> his door and </Text>
      <Text RevisionID="2">get out</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned rips Ray back into the car and shoves the impact wrench under his chin. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You move I </Text>
      <Text RevisionID="2">snap</Text>
      <Text> your neck like a barnyard chicken. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray becomes perfectly still.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Indicate you heard me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(choking)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">I heard you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know this situation is beyond the law Ray. This is the you and me now. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned withdraws the impact wrench and Ray gasps.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let me tell you what's gonna happen.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Traffic's gonna be moving soon. And when it does, you and I are gonna take a drive someplace.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...and what happens there?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What happens there is we're gonna play a little game. </Text>
      <Text Style="Underline">Winner takes all; </Text>
      <Text>loser ends up in a flood-drain, sort of thing. I'm still formulating it in my head. Now, the deck might be tilted in my favor, you can expect that, but you'll have a fair shot.</Text>
      <Text RevisionID="2"> Or we can sunset this day of ours</Text>
      <Text RevisionID="3">. But then, you won't see me coming. You</Text>
      <Text RevisionID="2"> won't</Text>
      <Text RevisionID="3"> know the when or the where...</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3">but</Text>
      <Text RevisionID="2"> I will be coming for you Ray.</Text>
      <Text RevisionID="3"> I can promise you that.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray says nothing. They sit in silence. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Besides, I know you want a pop at me Ray. I can smell it off of you. Take me out, and this whole nightmare will be a pocket universe, vanishing in a second. Like it never happened.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Ray's phone begins to buzz.</Text>
      <Text RevisionID="3"> Ray ignores it, but Ned is curious. He</Text>
      <Text RevisionID="2"> inspects the caller</Text>
      <Text RevisionID="3"> ID</Text>
      <Text RevisionID="2">.</Text>
      <Text RevisionID="3"> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Eva</Text>
      <Text RevisionID="2">. Who's Eva?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">The phone continues to buzz. Ray is unsure what to do with this information. Ned raises the phone.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">I can take it and find out-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">-Lucky's wife. Eva is Lucky's wife.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Guy you killed? Why's she wanna talk to you?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">The phone continues to buzz.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">It's about a settlement</Text>
      <Text RevisionID="3"> for the crash. We settle, </Text>
      <Text RevisionID="2">I can race again.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">So you wanna take it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">The phone continues to buzz. Eventually, Ray nods. </Text>
      <Text RevisionID="2">Ned</Text>
      <Text RevisionID="3"> </Text>
      <Text RevisionID="2">tosses the phone to Ray</Text>
      <Text RevisionID="3"> and unlocks the doors.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">I like that. You still think you'll make it out of here. All to play for.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="126">
      <SceneProperties Length="2 2/8" Page="61" Title=""/>
      <Text RevisionID="1">EXT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray </Text>
      <Text RevisionID="2">gets out, unsteady on his feet. He</Text>
      <Text RevisionID="1"> takes the call</Text>
      <Text RevisionID="2"> and walks</Text>
      <Text RevisionID="1"> towards the shoulder</Text>
      <Text RevisionID="3"> of the road.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Hey you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">I thought you wouldn't pick up. You never pick up.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray raises a hand to Lory in the Mustang, indicating he's OK. He walks to the chain-link fence. Rests against it. Like a prisoner against the mesh of the prison yard.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">It's been a long time. Not since...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">...the funeral.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">I wanted to call but my lawyers... I </Text>
      <Text RevisionID="3">know I </Text>
      <Text RevisionID="1">should have called</Text>
      <Text RevisionID="3">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3" Style="Italic">-I'll sign the fucking settlement OK? Whatever you tell me. But I just want the truth. That's all I want. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">He </Text>
      <Text RevisionID="5">takes a moment, summoning something inside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">I'd been holding onto that wheel for two hundred laps. No power steering in those boxes. My muscles were aching. They were numb, Eva. One twinge of nerves is all it took. Soon as the carts clipped... it was over. Listen, I'd never want to harm Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">EVA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3" Style="Italic">I just... I</Text>
      <Text RevisionID="1" Style="Italic"> </Text>
      <Text RevisionID="3" Style="Italic">can't get out my head this idea... that </Text>
      <Text RevisionID="1" Style="Italic">the crash might have </Text>
      <Text RevisionID="3" Style="Italic">had</Text>
      <Text RevisionID="1" Style="Italic"> something to do with me.</Text>
      <Text RevisionID="4" Style="Italic"> With us.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">That's garbage. You</Text>
      <Text RevisionID="3"> -</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="1" Style="Underline">we</Text>
      <Text RevisionID="5">, we</Text>
      <Text RevisionID="1"> had nothing to do with </Text>
      <Text RevisionID="5">it</Text>
      <Text RevisionID="3">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">EVA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">You promise me that Ray? You swear it was an accident?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">He closes his eyes. Summons something inside.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">I swear to you. </Text>
      <Text RevisionID="5">On my life</Text>
      <Text RevisionID="1">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Eva</Text>
      <Text RevisionID="1"> breathes in to say something, then clicks off. Ray isn't sure he's convinced her.</Text>
      <Text RevisionID="3"> Hell, he's not sure he even cares.</Text>
      <Text RevisionID="1"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">He opens his eyes and sees the Trucker leaning by the Mustang. She emerges, lighting a cigarette she has bummed from Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Union rules. Hope you don't mind me bumming a smoke. We're not meant to keep them in the cab.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">The less she smokes, the better.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">There is a monster... at the periphery... who must be confronted.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="5">(stopping)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Say again?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Theme of my book, I think. But I guess that's the same with every story, isn't it? The Minotaur. The shark. The wolf at the edge of the flock. The shadow. You can only ignore them so long before-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="5">(sharpening)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">-you have to strike them dead.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">TRUCKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Amen, brother.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray</Text>
      <Text RevisionID="3"> looks at the Dodge</Text>
      <Text RevisionID="5">, then Lory.</Text>
      <Text RevisionID="3"> M</Text>
      <Text RevisionID="2">ak</Text>
      <Text RevisionID="5">ing</Text>
      <Text RevisionID="2"> a decision</Text>
      <Text RevisionID="3">. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray walks up to</Text>
      <Text RevisionID="2"> Ned's window.</Text>
      <Text RevisionID="3"> Taps the glass. </Text>
      <Text RevisionID="5">The glass winds down. </Text>
      <Text RevisionID="3">Ray leans </Text>
      <Text RevisionID="2">in close to Ned</Text>
      <Text RevisionID="3">. A hint of dominance.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">I do this thing you're talking about... I parry with you...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">...you parry, and I keep it between the </Text>
      <Text RevisionID="5">you</Text>
      <Text RevisionID="1"> and </Text>
      <Text RevisionID="5">me</Text>
      <Text RevisionID="1">. But if I have to hunt you </Text>
      <Text RevisionID="2">down </Text>
      <Text RevisionID="1">to find my satisfaction....</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">He nods towards Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Let's</Text>
      <Text RevisionID="2"> keep it to the </Text>
      <Text RevisionID="5">you</Text>
      <Text RevisionID="2"> and </Text>
      <Text RevisionID="5">me</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ned spits in his hand and extends it for a handshake. Ray stares at the hand, not wanting to touch it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="128">
      <SceneProperties Length="1" Page="63" Title=""/>
      <Text RevisionID="1">INT. MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray cleans his deal-hand with wipes. Cars begin</Text>
      <Text RevisionID="5">ning</Text>
      <Text RevisionID="1"> to move</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">When?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Once the jam clears.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">The jam's clearing</Text>
      <Text RevisionID="4"> now</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">I can see that.</Text>
      <Text RevisionID="4"> I can see it's clearing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">He'll kill you-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">He'll try. But I intend to intercede in that matter</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">We could just drive away-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">-and be looking over our shoulder the rest of our lives? No. </Text>
      <Text RevisionID="2" Style="Underline">No</Text>
      <Text RevisionID="2">. I got a chance to fix things. This ends, tonight.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I don't want to leave you. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where I'm going, you can't go.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'll call, later. It'll be over.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And if you don't?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That won't happen, OK? I'm gonna see you before the night </Text>
      <Text RevisionID="1">is done</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He thumps his heart. She thumps hers</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You're a good kid. Once this is all over we're gonna talk about </Text>
      <Text RevisionID="3">turning</Text>
      <Text> things around, OK?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She kisses his cheek and gets out, suppressing tears.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="131">
      <SceneProperties Length="1/8" Page="64" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="3">slots a </Text>
      <Text>key in</Text>
      <Text RevisionID="3">to</Text>
      <Text> a</Text>
      <Text RevisionID="3"> carbon-steel </Text>
      <Text>handcuff. He glances up to see Lory exiting the Mustang. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ned</Text>
      <Text> grunts in satisfaction. </Text>
      <Text Style="Underline">Game on</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="132">
      <SceneProperties Length="7/8" Page="65" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Lory filter through traffic</Text>
      <Text RevisionID="5">. H</Text>
      <Text RevisionID="2">is</Text>
      <Text> phone rings.</Text>
      <Text RevisionID="5">
Finally, he answers it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Italic">AMAZING NEWS</Text>
      <Text RevisionID="3" Style="Italic">, Ray - amazing news.</Text>
      <Text Style="Italic"> Eva just signed the deal.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She did, huh.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">The number is higher but it</Text>
      <Text RevisionID="7" Style="Italic">'</Text>
      <Text Style="Italic">s in our range - look, the most important part is you're in the clear. It's all over. </Text>
      <Text RevisionID="1" Style="Italic+Underline">You can race again</Text>
      <Text Style="Italic">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The news leaves him utterly </Text>
      <Text RevisionID="3">bereft</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That's terrific. I knew you could pull it off.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Marco</Text>
      <Text RevisionID="3" Style="Italic">'s</Text>
      <Text Style="Italic"> booked a table at Booty's, we should go </Text>
      <Text RevisionID="3" Style="Italic">pop some champagne.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know, maybe not tonight.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">You working on that mystery novel? Marco told me the premise. It sounds really neat... if you wanna do it as a movie, I got a producer friend who is a wiz at putting together contained thrillers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm still figuring out the ending. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DEB (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Knock 'em dead in the third act. That's all that matters.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Intend to. Have one on Marco for me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He hangs up. Observes </Text>
      <Text RevisionID="3">more </Text>
      <Text>traffic </Text>
      <Text RevisionID="3">beginning to move</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="133">
      <SceneProperties Length="1/8" Page="66" Title=""/>
      <Text>EXT. CRASH SITE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">The rotators Odysseus and Hercules </Text>
      <Text>pull away </Text>
      <Text RevisionID="2">skeletal car</Text>
      <Text> remain</Text>
      <Text RevisionID="2">s</Text>
      <Text>, clearing another lane.</Text>
      <Text RevisionID="2"> Water hoses away debris.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="134">
      <SceneProperties Length="1 1/8" Page="66" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text RevisionID="3">'s phone is ringing someone. The call is answered.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Your shoot wrapped?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="3">ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3" Style="Italic">Like twenty minutes ago. I'm exhausted. Is </Text>
      <Text Style="Italic">Lory with you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She's near. Not too far.</Text>
      <Text RevisionID="2"> Still in this jam. All by myself.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>There's silence.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Listen Ray, </Text>
      <Text RevisionID="3" Style="Italic">I gotta go sort a ride for the airport-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I wanted to say I'm sorry.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">For what.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For fucking it all up. We had something good going-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">-Ray, you don't need to-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-and I made sure I broke it so bad it couldn't be fixed. I'm sorry for that. You didn't do anything to deserve it... or what you did do doesn't compare to what I did.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Jesus Ray, you doing AA or something? Is this a confessional?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We did good with Lory though. I know she's on a rough stretch, but she was the one good thing to come out of the whole shitshow that was us.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">He cries, suppressing his gasps. Tears run down his face.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALICE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Ray... are you OK? I'm getting worried</Text>
      <Text RevisionID="4" Style="Italic"> here.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: Ned is approaching the car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm good. It's all good. I gotta go.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">H</Text>
      <Text RevisionID="2">e</Text>
      <Text RevisionID="4"> heels away the tears, </Text>
      <Text>hardens up.</Text>
      <Text RevisionID="2"> Getting ready.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="136">
      <SceneProperties Length="7/8" Page="67" Title=""/>
      <Text>INT. / EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned saunters </Text>
      <Text RevisionID="3">up </Text>
      <Text>to Ray's </Text>
      <Text RevisionID="3">window</Text>
      <Text>. Peering in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Keys.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We can't leave the Mustang here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Not planning to. </Text>
      <Text Style="Underline">Keys</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray reaches for the keys and </Text>
      <Text RevisionID="2">hands</Text>
      <Text> them </Text>
      <Text RevisionID="2">over</Text>
      <Text>. Ned </Text>
      <Text RevisionID="2">takes them... and </Text>
      <Text>slaps a handcuff on </Text>
      <Text RevisionID="2">Ray's</Text>
      <Text> wrist and </Text>
      <Text RevisionID="2">puts the other </Text>
      <Text>cuff </Text>
      <Text RevisionID="2">on</Text>
      <Text> the wheel</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey, what the fuck is this-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">M</Text>
      <Text>y game</Text>
      <Text RevisionID="3">...</Text>
      <Text> my rules. </Text>
      <Text RevisionID="1">Time comes I'll cut you loose. I said you'd have a </Text>
      <Text RevisionID="2">fair </Text>
      <Text RevisionID="1">shot, didn't I? Now, open the hood for me</Text>
      <Text RevisionID="2"> Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray chafes at the cuffs. There's nothing he can do.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">I said open the hood for me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray hits the hood release and Ned walks around to inspect it. He pulls the cables out of the acid battery. </Text>
      <Text RevisionID="4">He comes around the car window again.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Any</Text>
      <Text> tow cables?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">You're w</Text>
      <Text>elcome to dig around the trunk</Text>
      <Text RevisionID="4">, Ned.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned walks towards the crash.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Don't go anywhere.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray</Text>
      <Text> watches Ned go car to car. He's got </Text>
      <Text RevisionID="3">his</Text>
      <Text> wallet out, offering cash</Text>
      <Text RevisionID="3"> for tow rope</Text>
      <Text RevisionID="5">s, looking for a seller.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="137">
      <SceneProperties Length="1/8" Page="68" Title=""/>
      <Text>EXT. CRASH SITE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Traffic begins to move faster as a SECOND LANE opens. Police office</Text>
      <Text RevisionID="2">r</Text>
      <Text>s guide traffic through </Text>
      <Text RevisionID="2">the underpass</Text>
      <Text> with flares.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="138">
      <SceneProperties Length="1 1/8" Page="68" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The 18-wheeler begins to move. Trucker waves at Ray as she departs. </Text>
      <Text RevisionID="2">He</Text>
      <Text> raises his free hand </Text>
      <Text RevisionID="2">to bid </Text>
      <Text RevisionID="2" Style="Italic">adieu</Text>
      <Text RevisionID="2"> </Text>
      <Text>when-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>-his passenger-side door opens. No one there... except LORY. Crouched low, scooping herself inside, closing door behind. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Get the hell out of here-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She sees Ray is cuffed to the wheel.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's going to do to you what he did to that guy in the </Text>
      <Text RevisionID="2">Sedan</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">He's going to be back any second. </Text>
      <Text>I told you to </Text>
      <Text Style="Underline">leave</Text>
      <Text Style="Italic">-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Underline">I'm not leaving you</Text>
      <Text>. How do I get you out of the cuffs?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He can see Ned </Text>
      <Text RevisionID="3">in the distance,</Text>
      <Text> still going car to car.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He's got the keys on him. But there's a toolbox. Look for a hacksaw. </Text>
      <Text RevisionID="2">Or </Text>
      <Text>anything I can stab with.</Text>
      <Text RevisionID="2">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She pulls her switchblade from her pocket.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. You keep that. </Text>
      <Text Style="Underline">Go</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She gets out. Ray </Text>
      <Text RevisionID="3">keeps </Text>
      <Text RevisionID="4">eyes</Text>
      <Text RevisionID="3"> on Ned</Text>
      <Text RevisionID="4">, turns to:</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: Lory approaching the Dodge. She opens the backseat door and gets inside. The door closes behind her.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Ned hand over cash</Text>
      <Text RevisionID="3"> to a DRIVER. The Driver gets out of his car,</Text>
      <Text RevisionID="4"> and opens the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: Lory is unseen behind the tint glass.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray sees the Driver ahead taking out TOWING CABLES from his trunk. Handing them to Ned. Exchanging civilities.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray p</Text>
      <Text>ush</Text>
      <Text RevisionID="4">es</Text>
      <Text> on the </Text>
      <Text RevisionID="3">light indicators</Text>
      <Text> desperately.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">REARVIEW: Lory opens the door holding a hacksaw. She sees something and closes the door again, disappearing inside.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray looks forwards... NED IS RETURNING.</Text>
      <Text RevisionID="5"> He passes by the Mustang, not acknowledging Ray.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW: </Text>
      <Text>Ray watches Ned get inside the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tell me you got out. Please tell me you got out...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="139">
      <SceneProperties Length="1/8" Page="69" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned starts the engine. Indicates and eases the Dodge forward, overtaking the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="147">
      <SceneProperties Length="1/8" Page="69" Title=""/>
      <Text>EXT. FREEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned parks the Dodge in front of </Text>
      <Text RevisionID="2">the </Text>
      <Text>Mustang. </Text>
      <Text RevisionID="3">The two vehicles an</Text>
      <Text> island of stillness </Text>
      <Text RevisionID="3">among</Text>
      <Text> slow-</Text>
      <Text RevisionID="2">moving</Text>
      <Text> traffic. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Next, </Text>
      <Text>Ned gets out</Text>
      <Text RevisionID="2"> and fixes</Text>
      <Text> the tow cables</Text>
      <Text RevisionID="3"> to the Mustang</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="148">
      <SceneProperties Length="5/8" Page="69" Title=""/>
      <Text RevisionID="4">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">As Ned </Text>
      <Text RevisionID="3">bends, </Text>
      <Text RevisionID="2">Ray scans the Dodge for signs of Lory</Text>
      <Text RevisionID="3"> in the rear window</Text>
      <Text RevisionID="4"> of the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Lory raises her head above the back-window. </Text>
      <Text Style="Underline">Sees Ray</Text>
      <Text>. </Text>
      <Text RevisionID="3">Ned stands</Text>
      <Text> -- she ducks down</Text>
      <Text RevisionID="3">. She was almost caught.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned saunters back to Ray's window. He mounts Ray's phone on the dash, then </Text>
      <Text RevisionID="3">holds </Text>
      <Text>out his own phone.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Type in your number.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(off Ray)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It ain't for dinner and a show.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray types the number in. Ned dials it. Ray's phone rings. Ned pings it to answer, sets it </Text>
      <Text RevisionID="2">on</Text>
      <Text> speaker. The voice echo</Text>
      <Text RevisionID="2">e</Text>
      <Text>s as Ned talks, filtered via phone</Text>
      <Text RevisionID="2"> speaker</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So as we're in </Text>
      <Text Style="Italic">communicado.</Text>
      <Text> Make sure the </Text>
      <Text RevisionID="3">call</Text>
      <Text> don't break, else I'll assume you</Text>
      <Text RevisionID="1">'re </Text>
      <Text RevisionID="3">using the line for something else.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray watches </Text>
      <Text>Ned walk </Text>
      <Text RevisionID="1">back </Text>
      <Text>to the Dodge</Text>
      <Text RevisionID="4"> and get in. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">The Prius overtakes and passes him. Ray peers into the driving seat, and makes eye contact with Walt.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Walt wipes sweat from his brow and accelerates past the Dodge, tires squealing. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Gone, leaving Ray alone.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="150">
      <SceneProperties Length="1/8" Page="70" Title=""/>
      <Text>INT. DODGE -- ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Twisting </Text>
      <Text RevisionID="3">the </Text>
      <Text>ignition, easing the Dodge forward</Text>
      <Text RevisionID="3">.</Text>
      <Text RevisionID="5">
Hidden beneath a blanket, </Text>
      <Text RevisionID="5" Style="Underline">Lory</Text>
      <Text RevisionID="5"> feels the Dodge accelerate. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="150A">
      <SceneProperties Length="1/8" Page="70" Title=""/>
      <Text>EXT. TIGHT ON TUG &amp; TOW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The tow cables grow tight and pull the Mustang forward.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="150B">
      <SceneProperties Length="1/8" Page="70" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned tilts his rearview, bringing Ray into view.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You in my rearview now, boy.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="150C">
      <SceneProperties Length="1/8" Page="70" Title=""/>
      <Text RevisionID="1">INT. MUSTANG &amp; DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray watches the crash site </Text>
      <Text RevisionID="2">draw</Text>
      <Text RevisionID="1"> near.</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="1">Carris eyeball</Text>
      <Text RevisionID="5">s</Text>
      <Text RevisionID="1"> them with suspicion</Text>
      <Text RevisionID="5">. She begins to pad towards them.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">NED (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1" Style="Italic">Best make sure she don't see them cuffs, killer. Else the whole jig gets a lot more complicated.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="151">
      <SceneProperties Length="1" Page="71" Title=""/>
      <Text>EXT. CRASH SITE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris moves towards th</Text>
      <Text RevisionID="3">e </Text>
      <Text RevisionID="1">tug-tow </Text>
      <Text>procession. Traffic's slow enough that she </Text>
      <Text RevisionID="2">can pace </Text>
      <Text>alongside Ned's window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Kind of you to show some charity.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can't let a misunderstanding get in the way of a good deed.</Text>
      <Text RevisionID="2"> Was he</Text>
      <Text>ading to a service station </Text>
      <Text RevisionID="1">anyway</Text>
      <Text RevisionID="3">, to fix the windshield.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris slows and walks alongside the Mustang's window. Ray covers his cuffed hand and acts relaxed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where's </Text>
      <Text RevisionID="1">Lory</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Bailed </Text>
      <Text RevisionID="1">and hitched a ride</Text>
      <Text RevisionID="3"> when the engine went</Text>
      <Text>. Don't think she fancied </Text>
      <Text RevisionID="3">the company of </Text>
      <Text>our towing partner</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CAPTAIN (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(thru radio)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Carris! I want lane three opened immediately...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Surprised the engine crept up on you. She looks taken care of.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Happens all the time with model cars. </Text>
      <Text RevisionID="2">The p</Text>
      <Text>rice of singular beauty is it's a boondoggle finding spare parts.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CAPTAIN (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Carris, lane three, right now!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Carris</Text>
      <Text> slows and lets the Mustang and Dodge </Text>
      <Text RevisionID="2">outpace her</Text>
      <Text>.</Text>
      <Text RevisionID="4"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">In the side-mirror, Ray watches Carris pick up a piece of guardrail</Text>
      <Text RevisionID="7">. She </Text>
      <Text RevisionID="4">inspect the holes in it. </Text>
      <Text RevisionID="7">L</Text>
      <Text RevisionID="4">ooks up to</Text>
      <Text RevisionID="7"> the</Text>
      <Text RevisionID="4"> gap in the overpass above, into the shadow of which Ray passes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray observes a </Text>
      <Text Style="Italic">Santa Muerte</Text>
      <Text> doll, charred and tinged with blood</Text>
      <Text RevisionID="2">, flicker</Text>
      <Text RevisionID="7">ing</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="3">under</Text>
      <Text RevisionID="2"> the shadows of passing traffic.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray watches Ned indicate right. Turning onto the OFF-RAMP.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="156">
      <SceneProperties Length="1/8" Page="72" Title=""/>
      <Text>EXT. DODGE &amp; MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">...leaving the freeway and entering the veins of L.A.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="157">
      <SceneProperties Length="1/8" Page="72" Title=""/>
      <Text>EXT. LOS ANGELES -- BACK STREETS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dodge </Text>
      <Text RevisionID="3">tows</Text>
      <Text> Mustang</Text>
      <Text RevisionID="3"> </Text>
      <Text>down an empty side-street.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="158">
      <SceneProperties Length="1/8" Page="72" Title=""/>
      <Text>INT. MUSTANG -- BACK STREETS</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mind telling me where we're going?</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="159">
      <SceneProperties Length="1/8" Page="72" Title=""/>
      <Text>INT. DODGE -- BACK STREETS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory under the blanket, listening.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
      <Text RevisionID="2"> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, somewhere fun. Believe me. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="161">
      <SceneProperties Length="1/8" Page="72" Title=""/>
      <Text>INT. MUSTANG -- SIDE STREET</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray peers out at the dark, quiet streets. </Text>
      <Text RevisionID="2">A s</Text>
      <Text RevisionID="1">ense of doom.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>-FLASHING BLUE LIGHTS </Text>
      <Text RevisionID="3">stab</Text>
      <Text> inside his vehicle. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="162">
      <SceneProperties Length="1/8" Page="72" Title=""/>
      <Text>INT. DODGE -- SIDE STREET</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's eyes shoot to wing-mirror... Carris has caught up </Text>
      <Text RevisionID="2">with</Text>
      <Text> them, </Text>
      <Text RevisionID="2">siren </Text>
      <Text>light</Text>
      <Text RevisionID="3">s</Text>
      <Text> flashing on </Text>
      <Text RevisionID="3">her</Text>
      <Text> Harley.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Didn't think she'd let me leave without saying goodbye...</Text>
      <Text RevisionID="1"> </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="163">
      <SceneProperties Length="3/8" Page="72" Title=""/>
      <Text>EXT. UNDERPASS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="1">slows and parks under the</Text>
      <Text> shade of an underpass.</Text>
      <Text RevisionID="1"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Carris pulls up behind them - keeping her distance. </Text>
      <Text RevisionID="1">Street lights flickering on.</Text>
      <Text> </Text>
      <Text RevisionID="5">Quiet. N</Text>
      <Text RevisionID="1">o other through traffic</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="2">steps</Text>
      <Text> out of the </Text>
      <Text RevisionID="2">Dodge</Text>
      <Text>, keep</Text>
      <Text RevisionID="2">s</Text>
      <Text> his front towards Carris.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What grounds you got for this stop?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris unclip</Text>
      <Text RevisionID="6">s</Text>
      <Text> her bodycam</Text>
      <Text RevisionID="5">.</Text>
      <Text> She smashes in</Text>
      <Text RevisionID="6"> </Text>
      <Text RevisionID="5">a </Text>
      <Text>tail light</Text>
      <Text RevisionID="5"> on the Dodge</Text>
      <Text>.</Text>
      <Text RevisionID="5"> Slots baton away. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Now s</Text>
      <Text RevisionID="2">he </Text>
      <Text>pulls on latex gloves</Text>
      <Text RevisionID="2">. Ned</Text>
      <Text> lifts</Text>
      <Text RevisionID="1"> </Text>
      <Text>arms</Text>
      <Text RevisionID="2"> with a smile.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Didn't need to go breaking my lights to</Text>
      <Text> gimme the reach-a-round.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She ignores him and opens the rear </Text>
      <Text RevisionID="3">Dodge</Text>
      <Text> passenger door. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="73" Title=""/>
      <Text RevisionID="5">INT. DODGE -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Carris</Text>
      <Text> feels around the rear, looking for something.</Text>
      <Text RevisionID="5"> </Text>
      <Text>Lory keeps very still</Text>
      <Text RevisionID="5"> under the blanket</Text>
      <Text> as the car is searched.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text RevisionID="3">finds what she wants - </Text>
      <Text>the impact wrench. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="73" Title=""/>
      <Text RevisionID="5">EXT. UNDERPASS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Carris walks to the guardrail and angles the impact wrench against a cross-bolt.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">She </Text>
      <Text RevisionID="7">s</Text>
      <Text RevisionID="5">queezes the trigger and t</Text>
      <Text>he bolt </Text>
      <Text RevisionID="5">shoots out. The rail disconnects and slumps to the dirt.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="73" Title=""/>
      <Text RevisionID="5">INT. DODGE -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Carris drops </Text>
      <Text RevisionID="5">the wrench on top of the blanket</Text>
      <Text RevisionID="3">. </Text>
      <Text>Lory suppresses a gasp</Text>
      <Text RevisionID="2"> as it hits her</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 1/8" Page="73" Title=""/>
      <Text RevisionID="5">EXT. UNDERPASS -- DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Now Carris approaches Ray</Text>
      <Text RevisionID="5">, unclipping her Beretta.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You saw Booles come from the crash site. And </Text>
      <Text RevisionID="2">then </Text>
      <Text>he got in the Dodge</Text>
      <Text RevisionID="1"> behind you</Text>
      <Text>, and the driver vanished. I bet the </Text>
      <Text RevisionID="1">d</Text>
      <Text>river looked like this. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Carris</Text>
      <Text> </Text>
      <Text RevisionID="3">holds</Text>
      <Text> out her phone and shows a picture of the Skinny </Text>
      <Text RevisionID="1">Guy</Text>
      <Text> - CLYDE. Ray says nothing. He looks to Ned, then her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">A</Text>
      <Text RevisionID="3">nd</Text>
      <Text> I think I know where Clyde</Text>
      <Text RevisionID="3">'s been</Text>
      <Text RevisionID="5"> all this time</Text>
      <Text>.</Text>
      <Text RevisionID="3"> </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="5">(a beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Open the trunk for me Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'd let this go, Officer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Open the fucking trunk Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I'm afraid that won't be possible.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray</Text>
      <Text> reveals </Text>
      <Text RevisionID="3">his </Text>
      <Text>hand</Text>
      <Text RevisionID="3"> is cuffed</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris backs into space </Text>
      <Text RevisionID="5">and pulls her Beretta on Ned </Text>
      <Text>and taps her radio all at once.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thirty-four Mary nine, requesting a code three. Confirm.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A burst of static.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Ke</Text>
      <Text>ys</Text>
      <Text RevisionID="3"> to the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Right pocket. You can fish 'em out, just mind the tackle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">DISPATCH</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Code Three confirmed. Sending units.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Throw them onto the ground.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ned</Text>
      <Text> throws them into the d</Text>
      <Text RevisionID="5">irt</Text>
      <Text> in front of </Text>
      <Text RevisionID="5">her</Text>
      <Text>. She stoops to pick them up, gun </Text>
      <Text RevisionID="3">always </Text>
      <Text>on Ned.</Text>
      <Text RevisionID="3"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Carris</Text>
      <Text> moves to the </Text>
      <Text RevisionID="2">Mustang's trunk</Text>
      <Text>. Keys find lock.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let it go. </Text>
      <Text RevisionID="2" Style="Underline">Please</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Carris opens the trunk, sees inside... t</Text>
      <Text>a</Text>
      <Text RevisionID="2">ps</Text>
      <Text> radio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I got</Text>
      <Text RevisionID="1"> </Text>
      <Text>a D-B here, where</Text>
      <Text RevisionID="1">'s </Text>
      <Text>the fucking units</Text>
      <Text RevisionID="1">?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="7">DISPATCH</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Units proceeding. Two minutes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Distant sirens can be heard. Getting nearer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Y</Text>
      <Text>ou check </Text>
      <Text RevisionID="1">his </Text>
      <Text>leg yet?</Text>
      <Text RevisionID="1"> You should really check his leg.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">CARRIS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">-SHUT YOUR MOUTH AND DON'T MOVE.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris observes a BULGE in Clyde's </Text>
      <Text RevisionID="7">pant</Text>
      <Text> leg.</Text>
      <Text RevisionID="5"> She </Text>
      <Text>reaches with her free hand and pulls at </Text>
      <Text RevisionID="5">the hem</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Ma'am, it was self-defense...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">We</Text>
      <Text> </Text>
      <Text RevisionID="3">begin to </Text>
      <Text>track down the back of </Text>
      <Text RevisionID="3">Ned's</Text>
      <Text> </Text>
      <Text RevisionID="3">shirt...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">...s</Text>
      <Text>elf-defense</Text>
      <Text RevisionID="2">,</Text>
      <Text> 'cos he had a gun.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">... and we see N</Text>
      <Text RevisionID="6">e</Text>
      <Text RevisionID="1">d has a GLOCK 9mm tucked behind his waist.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Carris finds Clyde has an EMPTY ANKLE HOLSTER.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned quickdraw</Text>
      <Text RevisionID="5">s and Carris pivots too late.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned hits Carris with four rounds in arm and shoulder.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Carris </Text>
      <Text>empties a full auto-clip </Text>
      <Text RevisionID="3">-</Text>
      <Text>- 13 rounds in 0.</Text>
      <Text RevisionID="7">7</Text>
      <Text> seconds</Text>
      <Text RevisionID="5"> - a</Text>
      <Text RevisionID="3">ll go</Text>
      <Text> wide of Ned,</Text>
      <Text RevisionID="3"> her </Text>
      <Text>ruined gun-arm unable to </Text>
      <Text RevisionID="3">aim</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">She </Text>
      <Text>slumps against the Mustang trunk for cover. Blood smears against the white bodywork.</Text>
      <Text RevisionID="3"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She finds her gun-arm is a gory mess. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Carris's working arm</Text>
      <Text> ejects a magazine, </Text>
      <Text RevisionID="2">clamps</Text>
      <Text> the receiver between her knee</Text>
      <Text RevisionID="2">caps</Text>
      <Text RevisionID="5"> and</Text>
      <Text> slots a fresh magazine</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">She p</Text>
      <Text>umps to load it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She swings the gun around the side of the car. Ned breaks around the Dodge for cover. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Carris </Text>
      <Text RevisionID="5">sprays</Text>
      <Text> a mag full auto</Text>
      <Text RevisionID="5">... </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned ducks behind the engine block.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="164">
      <SceneProperties Length="1/8" Page="76" Title=""/>
      <Text>INT. DODGE -- ON LORY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Back windows blow in and Lory is showered with glass.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="76" Title=""/>
      <Text RevisionID="5">EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Carris is </Text>
      <Text>in total concentration as she reloads</Text>
      <Text RevisionID="5"> one-armed.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned's shadow lengthening on the driver's side. Closing.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She pumps the receiver</Text>
      <Text RevisionID="5"> to load</Text>
      <Text> and </Text>
      <Text RevisionID="5">turns</Text>
      <Text> </Text>
      <Text RevisionID="5">head </Text>
      <Text>to aim-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">To find she is l</Text>
      <Text>ooking straight into the barrel of </Text>
      <Text RevisionID="5">a</Text>
      <Text> gun. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned fires, point blank.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="167">
      <SceneProperties Length="2/8" Page="76" Title=""/>
      <Text>INT. MUSTANG -- SID</Text>
      <Text RevisionID="1">E-</Text>
      <Text>MIRROR</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Carris's </Text>
      <Text RevisionID="5">dead </Text>
      <Text>body slump against the road.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">N</Text>
      <Text>ed</Text>
      <Text RevisionID="5"> stands over her and </Text>
      <Text>toes </Text>
      <Text RevisionID="5">her face, revealing</Text>
      <Text> </Text>
      <Text RevisionID="5">p</Text>
      <Text>arts of her </Text>
      <Text RevisionID="5">head</Text>
      <Text> </Text>
      <Text RevisionID="7">are</Text>
      <Text> missing. Ned bursts into laugh</Text>
      <Text RevisionID="7">t</Text>
      <Text>er</Text>
      <Text RevisionID="5">, relieved.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ho-ly shit Ray! Girl packing a full-auto Beretta! Can you believe it?</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="171">
      <SceneProperties Length="1/8" Page="76" Title=""/>
      <Text>INT. DODGE -- ON LORY</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Another half-second, she would have had the inch on me. Finito!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="172">
      <SceneProperties Length="1/8" Page="76" Title=""/>
      <Text>EXT. UNDERPASS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sirens echo loudly in the underpass. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="5">is all business. He </Text>
      <Text>takes Carris's Beretta</Text>
      <Text RevisionID="5">. Y</Text>
      <Text>anks the magazine clip </Text>
      <Text RevisionID="2">free </Text>
      <Text>from her belt.</Text>
      <Text RevisionID="3"> Pulls her police r</Text>
      <Text RevisionID="5">adio</Text>
      <Text RevisionID="3">.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="173">
      <SceneProperties Length="1/8" Page="76" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned dumps </Text>
      <Text RevisionID="5">guns on the</Text>
      <Text> passenger seat and gets the engine started. Lory still hiding under the blanket.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="174">
      <SceneProperties Length="1/8" Page="77" Title=""/>
      <Text>INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge pulls the </Text>
      <Text RevisionID="2">Mustang</Text>
      <Text> forward. Rearview, Ray can see Carris's body, left like trash on the roadside.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text RevisionID="3">FADE TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="176">
      <SceneProperties Length="1/8" Page="77" Title=""/>
      <Text>EXT. L.A. SKYLINE -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">SOARING</Text>
      <Text> OVER freeways and glittering lights...</Text>
      <Text RevisionID="3"> moving through the industrial outer areas of the City.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="177">
      <SceneProperties Length="5/8" Page="77" Title=""/>
      <Text RevisionID="7">INTERCUT -- MUSTANG &amp; DODGE</Text>
      <Text RevisionID="2"> -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="3">listens to dispatch chatter on </Text>
      <Text>Carris's police radio</Text>
      <Text RevisionID="3">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No APB for me or you Ray. Stakes ain't changed. All to play for.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>In the back seat, Lory lifts the blanket</Text>
      <Text RevisionID="5">. She eyes t</Text>
      <Text>he impact wrench</Text>
      <Text RevisionID="5">, strobed by passing streetlights.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">I'm b</Text>
      <Text>eginning to wonder if our parlay </Text>
      <Text RevisionID="3">won't</Text>
      <Text> be some sort of draw. That was </Text>
      <Text RevisionID="2">some </Text>
      <Text>pro-shooting back there.</Text>
      <Text RevisionID="2">..</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Truth be told, I came second at a rodeo quickdraw once, in Calgary.</Text>
      <Text Style="Italic"> </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, I ain't much with a gun, Ned-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>-don't bullshit me Ray. Cali celeb like you spent time on the range. And I only finished second in that rodeo.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned speaks quietly, so Ray can't hear. But Lory can.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Least until he got back to his motel. Weren't so fast then.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="179">
      <SceneProperties Length="1/8" Page="77" Title=""/>
      <Text>EXT. QUIET STREET -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge parks in front of undeveloped land. Ned </Text>
      <Text RevisionID="2">gets out, leaves headlights on</Text>
      <Text RevisionID="3">, illuminating</Text>
      <Text RevisionID="2"> pavement and</Text>
      <Text RevisionID="3"> a</Text>
      <Text RevisionID="2"> manhole.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="180">
      <SceneProperties Length="1/8" Page="78" Title=""/>
      <Text>INT. MUSTANG -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray watches Ned pass his window, tightening black gloves. He makes his way around to the Mustang's trunk. Opens it.</Text>
      <Text RevisionID="3"> </Text>
      <Text>Ned stick</Text>
      <Text RevisionID="3">s</Text>
      <Text> a tire-iron in his jeans and </Text>
      <Text RevisionID="3">pulls</Text>
      <Text> Clyde's body out</Text>
      <Text RevisionID="3"> of the trunk</Text>
      <Text>. He </Text>
      <Text RevisionID="3">drag</Text>
      <Text>s Clyde towards the manhole.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="181">
      <SceneProperties Length="1/8" Page="78" Title=""/>
      <Text>INT. DODGE -- ON LORY UNDER BLANKET</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text RevisionID="3">leans up</Text>
      <Text> and </Text>
      <Text RevisionID="2">reaches</Text>
      <Text> for the </Text>
      <Text RevisionID="2">i</Text>
      <Text>mpact </Text>
      <Text RevisionID="2">w</Text>
      <Text>rench.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="182">
      <SceneProperties Length="1/8" Page="78" Title=""/>
      <Text>INT. MUSTANG -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray sees movement in the back of the Dodge -- LORY. He panics, whispers out--</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic+Underline">Get the hell down.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="184">
      <SceneProperties Length="2/8" Page="78" Title=""/>
      <Text>EXT. MANHOLE -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned glances </Text>
      <Text RevisionID="3">back</Text>
      <Text>, just missing </Text>
      <Text RevisionID="3">Lory</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Seeing nothing, </Text>
      <Text RevisionID="3">Ned</Text>
      <Text> continues to drag Clyde's body to the manhole. </Text>
      <Text RevisionID="3">He h</Text>
      <Text>itches open the steel cover with the tire iron.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Drops Clyde down. A delayed splash and thud.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So long, Clyde.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="3">pulls</Text>
      <Text> the manhole cover into place, now a tombstone for Clyde. It reads "CITY OF L.A." and "MADE IN MEXICO".</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="78" Title=""/>
      <Text RevisionID="7">INTERCUT -</Text>
      <Text RevisionID="5"> DODGE &amp; MUSTANG</Text>
      <Text RevisionID="7"> -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned </Text>
      <Text RevisionID="6">is driving. </Text>
      <Text RevisionID="7">The strange pop song</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="6">is playing on the radio, midway through the song</Text>
      <Text RevisionID="5">. </Text>
      <Text RevisionID="6">Ned</Text>
      <Text RevisionID="5"> begins to sing with it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Italic">Got to say it hurts to see you go... got to say it hurts to see you go...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">In the back, </Text>
      <Text>Lory </Text>
      <Text RevisionID="5">holds </Text>
      <Text RevisionID="5" Style="Underline">the impact wrench</Text>
      <Text RevisionID="2"> close to ches</Text>
      <Text RevisionID="5">t.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">I got a question for you Ray. Why was the phone number of your teammate's wife</Text>
      <Text RevisionID="3">...</Text>
      <Text RevisionID="2"> saved on your phone?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">He wasn't my teammate.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">He was. Until he wasn't. And is that why he wasn't? You cucked him in the bed-room, so he switched teams so as he could cuck you on the track?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Lory listening. Her heart getting broken.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="2">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2">Must be a complex feeling, watching a young buck about to achieve a very thorough revenge. Oh c</Text>
      <Text RevisionID="1">ome on Ray, I've told you mine, you can tell me yours.</Text>
      <Text RevisionID="2"> You wanted to kill him.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray, spaced out. Confessing. Knowing </Text>
      <Text RevisionID="3">Lory</Text>
      <Text>'s listening.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Sure. </Text>
      <Text RevisionID="1">I wanted to kill him. </Text>
      <Text>For</Text>
      <Text RevisionID="1"> a fraction of a second</Text>
      <Text RevisionID="2">...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">A tear gathers on Lory's cheek.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But when you're driving two hundred twenty miles an hour, that's all it takes. And that's all it took.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Time's arrow, Ray. That burns bed was waiting for Lucky when he woke up</Text>
      <Text RevisionID="3"> that day</Text>
      <Text>. He just didn't know it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="186">
      <SceneProperties Length="1/8" Page="79" Title=""/>
      <Text>EXT. </Text>
      <Text RevisionID="3">SLIPWAY</Text>
      <Text> -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge</Text>
      <Text RevisionID="3">'s wheels grind</Text>
      <Text> over earthwork ramps</Text>
      <Text RevisionID="3">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="187">
      <SceneProperties Length="1/8" Page="79" Title=""/>
      <Text>INT. MUSTANG -- NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray looking through the windshield. A faded sign for</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text Style="Underline">RIVERSIDE INTERNATIONAL RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">... </Text>
      <Text>and we RISE UP to take in the vast, crumbling, open ARENA... part reclaimed by the desert.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="190">
      <SceneProperties Length="1/8" Page="80" Title=""/>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A dust cloud follows the Dodge as it circles wide and comes to stop in the middle of the dark, deserted space. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="191">
      <SceneProperties Length="2/8" Page="80" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned pulls to a halt</Text>
      <Text RevisionID="5">, engine still running. As he reaches for the handbrake...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">... the impact wrench is shoved against his neck.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW: Lory emerges from the blanket holding the trigger.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Was wonderin' if you were gonna slink around there all night.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="80" Title=""/>
      <Text RevisionID="5">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray wrenches at the wheel. His cuff-wrist becomes bloodied.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">LORY, GET OUTTA THERE! MOVE!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="80" Title=""/>
      <Text RevisionID="5">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5" Style="Underline">Lory presses the head</Text>
      <Text Style="Underline"> against the back of Ned's spine</Text>
      <Text>. </Text>
      <Text RevisionID="3">Ned</Text>
      <Text> doesn't move. Just eyes on the rearview, looking at her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>G'ahead. Put it right here. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned star</Text>
      <Text RevisionID="2">es</Text>
      <Text> at Lory's eyes in the rearview.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Two notches up on the spine, I still get to use the toilet. One more up and I'm just a head on a stick.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The nozzle of the impact wrench travels higher.</Text>
      <Text RevisionID="2"> </Text>
      <Text>Lory </Text>
      <Text Style="Underline">plants the wrench to Ned's skull</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now that there, that'll kill me straight out. One 'lil squeeze.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="196">
      <SceneProperties Length="1/8" Page="80" Title=""/>
      <Text>INT. MUSTANG </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="2">thrash</Text>
      <Text RevisionID="3">es</Text>
      <Text RevisionID="2"> at </Text>
      <Text RevisionID="3">his</Text>
      <Text> steering wheel</Text>
      <Text RevisionID="3">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="197">
      <SceneProperties Length="3/8" Page="81" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Trouble with women when it comes to violence</Text>
      <Text RevisionID="2">? T</Text>
      <Text>hey know what needs doing</Text>
      <Text RevisionID="2"> but</Text>
      <Text> they hesitate</Text>
      <Text RevisionID="2"> when it comes to.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Watch me, you piece of shit-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned hits the accelerator. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory is </Text>
      <Text RevisionID="5">ripped</Text>
      <Text> backwards just as she squeezes the trigger. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The hammer </Text>
      <Text RevisionID="5">ejects...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">...coming an inch short of</Text>
      <Text> Ned's neck.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="198">
      <SceneProperties Length="1/8" Page="81" Title=""/>
      <Text>EXT. DODGE &amp; MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The tow is snapped tight by the acceleration</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="198A">
      <SceneProperties Length="1/8" Page="81" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">The Dodge is shoved forward by the tension of the tow. </Text>
      <Text>Lory's face INTO THE BACK OF THE IMPACT WRENCH</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned</Text>
      <Text RevisionID="5"> spins and</Text>
      <Text> </Text>
      <Text Style="Underline">SMASHES LORY IN THE FACE</Text>
      <Text> with </Text>
      <Text RevisionID="2">fist and </Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text RevisionID="2">CUT TO BLACK</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="199">
      <SceneProperties Length="3/8" Page="81" Title=""/>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's hand </Text>
      <Text RevisionID="5">is zip-tied to</Text>
      <Text> </Text>
      <Text RevisionID="5">window </Text>
      <Text>grab handle</Text>
      <Text RevisionID="5">.</Text>
      <Text> </Text>
      <Text RevisionID="5">Ned takes her other </Text>
      <Text RevisionID="3">hand </Text>
      <Text RevisionID="5">and zip-ties it </Text>
      <Text>to the safety belt.</Text>
      <Text RevisionID="2"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">She is drowsy; her face bruised, bloody swollen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>After I'm done with your daddy... we'll get to spend some time together. Lest he wins this thing?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Lory</Text>
      <Text> spits in his face. Saliva and blood. </Text>
      <Text RevisionID="5">For a moment Ned doesn't react; he lets the mixture lie there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">He </Text>
      <Text>wipes his face with gloved hand</Text>
      <Text RevisionID="2">. </Text>
      <Text>Uses his thumb to paint blood onto her lips. </Text>
      <Text RevisionID="2">Lory</Text>
      <Text> turns her head away desperately.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="200">
      <SceneProperties Length="1/8" Page="82" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="2">watches</Text>
      <Text> in mute horror</Text>
      <Text RevisionID="2"> and rage</Text>
      <Text>.</Text>
      <Text RevisionID="2"> </Text>
      <Text>Drifting down we see his wrist is red and raw. But his hands are working under the dash. He has pulled out the ignition wires.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He sees Ned get out of the Dodge. Undo the tow rope. Ray's hands stuff the ignition wires back in place</Text>
      <Text RevisionID="3"> to hide them</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ned is</Text>
      <Text> coming towards hi</Text>
      <Text RevisionID="5">m,</Text>
      <Text> taking Glock out of his pants.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="203">
      <SceneProperties Length="1/8" Page="82" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory slinks sideways in the seat. Trying to get her hip pocket close to the hand restraint.</Text>
      <Text RevisionID="5"> Something inside it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="204">
      <SceneProperties Length="2/8" Page="82" Title=""/>
      <Text>EXT. </Text>
      <Text RevisionID="5">RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned stands back and speaks loudly; the master of ceremonies.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Here's the rules, everybody. Best pay attention. Way I figure it</Text>
      <Text RevisionID="2"> Ray,</Text>
      <Text> you probably got the edge </Text>
      <Text RevisionID="2">on me </Text>
      <Text>behind the wheel, but I got edge</Text>
      <Text RevisionID="2"> on you</Text>
      <Text> behind the trigger.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="204A">
      <SceneProperties Length="2/8" Page="82" Title=""/>
      <Text>INT. </Text>
      <Text RevisionID="2">DODGE</Text>
      <Text> -- ON LORY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's fingers pull the switchblade out of her pocket.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what we're going to do is some </Text>
      <Text Style="Italic">role reversal</Text>
      <Text>. I'm gonna be in the Dodge. Your baby girl's gonna be sitting right next to me.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="204B">
      <SceneProperties Length="7/8" Page="82" Title=""/>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now you, Ray, you is gonna be foot-loose. And I'm gonna be driving. And I'll be coming for you again and again. But you'll have this.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned ejects the mag, displays </Text>
      <Text RevisionID="5">it</Text>
      <Text> to Ray.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Fou</Text>
      <Text RevisionID="7">r</Text>
      <Text RevisionID="5"> rounds. Now y</Text>
      <Text>ou sure you </Text>
      <Text RevisionID="5">remember</Text>
      <Text> to use it?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">G</Text>
      <Text>ive it here a moment</Text>
      <Text RevisionID="4">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text RevisionID="5">(grinning)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">That's the spirit.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned drops the mag into the dust, then flings the gun </Text>
      <Text RevisionID="7">deep into the race track. He</Text>
      <Text> returns to the Dodge. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No safety on a Glock. Slap that mag in, chamber a round, you hot to trot.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ned takes out the baggie of coke and tips a heavy line on the arch of forefinger and thumb. He snorts it and guffaws.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Now he tips some more onto the arch and offers it to Ray. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">C</Text>
      <Text RevisionID="4">are for the old pre-race ritual Ray? </Text>
      <Text RevisionID="5">Or pass</Text>
      <Text RevisionID="4"> up the edge just to spite me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Ray moves his head towards Ned's hand. Baring teeth. As if he's going to take a big bite.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="4">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">Fuck it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Ray </Text>
      <Text RevisionID="5">snorts the line.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="205">
      <SceneProperties Length="1/8" Page="83" Title=""/>
      <Text>INT. DODGE -- SIDE MIRROR</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="4">Lory </Text>
      <Text>has been sawing the restraint with </Text>
      <Text Style="Underline">the switchblade</Text>
      <Text>. She covers it with her hip as Ned </Text>
      <Text RevisionID="5">wades towards her and gets in.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="206">
      <SceneProperties Length="2/8" Page="83" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned </Text>
      <Text RevisionID="3">drives the Dodge alongside the Mustang window. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">He </Text>
      <Text>tosses the handcuff key</Text>
      <Text RevisionID="5">. It lands somewhere inside the dark compartment. </Text>
      <Text>Ray</Text>
      <Text RevisionID="3"> </Text>
      <Text RevisionID="5">scrambles</Text>
      <Text> to find it</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Game 'on, killer.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned floors the Dodge and revs in a wide circle.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="207">
      <SceneProperties Length="1/8" Page="83" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's head getting whipped about as it bumps over dust.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="208">
      <SceneProperties Length="1/8" Page="84" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray frantically searches for the handcuff key. Headlights flood</Text>
      <Text RevisionID="2"> </Text>
      <Text>the Mustang with light. He finds the key...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="209">
      <SceneProperties Length="1/8" Page="84" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge gathering ramming speed. Mustang dead ahead.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="210">
      <SceneProperties Length="1/8" Page="84" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray snaps the cuff off, tumbles out of the car.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="211">
      <SceneProperties Length="2/8" Page="84" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray rolls away from the Dodge's path -- just missing him.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Woo-hoo, this is fun!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory's knife slips from her hand. She traps it with her buttocks, reaching for it with her restrained hand...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="212">
      <SceneProperties Length="2/8" Page="84" Title=""/>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray finds the magazine clip in the dirt... runs towards where Ned threw the gun. </Text>
      <Text RevisionID="3">It is </Text>
      <Text>difficult to see</Text>
      <Text RevisionID="5"> in the dark</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>In the distance, the headlights are turning </Text>
      <Text RevisionID="3">back</Text>
      <Text> again.</Text>
      <Text RevisionID="5"> Headlights growing brighter.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray sees a glint of the Glock in</Text>
      <Text RevisionID="5"> dirt</Text>
      <Text>. </Text>
      <Text RevisionID="5">He grabs at it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge rac</Text>
      <Text RevisionID="5">es </Text>
      <Text>towards him... </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray dives out of the way, just missing it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="213">
      <SceneProperties Length="1/8" Page="84" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>ALMOST! I'm getting the hang of this. He the Matador and I'm the bull.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory has got her hands on the knife again.</Text>
      <Text RevisionID="2"> Gripping it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="214">
      <SceneProperties Length="1/8" Page="85" Title=""/>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray inserts the magazine in the </Text>
      <Text RevisionID="3">G</Text>
      <Text>lock, chambers a round. Aims... tracking the Dodge as it circles </Text>
      <Text RevisionID="3">back</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="215">
      <SceneProperties Length="2/8" Page="85" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned looks at Lory. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fun part ain't the knocking down. It's the William Tell element. I'm the apple and you're his sweetheart and he's got to keep his aim true.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="216">
      <SceneProperties Length="2/8" Page="85" Title=""/>
      <Text>EXT. RACEWAY -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray stands t</Text>
      <Text>wo</Text>
      <Text RevisionID="3">-</Text>
      <Text>handed</Text>
      <Text RevisionID="3"> with a strong stance - clearly </Text>
      <Text>he's done some shooting. </Text>
      <Text RevisionID="3">H</Text>
      <Text>eadlights </Text>
      <Text RevisionID="3">bear down on him.</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Ray </Text>
      <Text>aims as it comes closer... at the engine block. Waiting... waiting... Lory's outline inside...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Fires twice---</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The bullets spark on the engine block... Ray dives late</Text>
      <Text RevisionID="5">... his shoulder</Text>
      <Text> is hit by the wing</Text>
      <Text RevisionID="5">-</Text>
      <Text>mirror. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He </Text>
      <Text RevisionID="5">spins and hits the dust, badly hurt.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="217">
      <SceneProperties Length="1/8" Page="85" Title=""/>
      <Text>INT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned circles around, commentating to Lory.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Engine block</Text>
      <Text RevisionID="3">'</Text>
      <Text>s</Text>
      <Text RevisionID="5"> </Text>
      <Text>a waste</Text>
      <Text RevisionID="5"> of ammo</Text>
      <Text>. Two</Text>
      <Text RevisionID="5"> rounds</Text>
      <Text> left.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="218">
      <SceneProperties Length="1/8" Page="85" Title=""/>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray nurses his shoulder. It aches, but he can still lift his gun. He evaluates what to do. Looks to the Mustang. </Text>
      <Text Style="Underline">An idea</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="219">
      <SceneProperties Length="1/8" Page="85" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned gunning for him.... swerving left as Ray DIVES....</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="220">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>EXT. RACEWAY -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sprinting to the Mustang, slotting gun in </Text>
      <Text RevisionID="3">waist</Text>
      <Text>. </Text>
      <Text RevisionID="3">Ray</Text>
      <Text> dives into the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="221">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Rays reaches for the headlight toggle switch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Sitting duck in there Ray....</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="222">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">FLOODLIGHTS fill</Text>
      <Text> the Dodge</Text>
      <Text RevisionID="3"> with light</Text>
      <Text>. Ned </Text>
      <Text RevisionID="3">is </Text>
      <Text>blinded</Text>
      <Text RevisionID="3">...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="223">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>EXT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Getting out of the </Text>
      <Text RevisionID="7">Mustang</Text>
      <Text>, dropping to an aiming position.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="224">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's eyes have adjusted to the light... searching for Ray.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="225">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>EXT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Flood</Text>
      <Text>lights </Text>
      <Text RevisionID="3">illuminate</Text>
      <Text> the inside</Text>
      <Text RevisionID="3"> of the Dodge</Text>
      <Text> for Ray</Text>
      <Text RevisionID="3">, who drops to a crouching aim.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Underline">LORY GET YOUR HEAD DOWN</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="226">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory ducks. Ned imitates her, swerves blind and wide as-BULLETS EXPLODE THE REAR PASSENGER WINDOWS.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A shower of glass. Ned keeps his head down, accelerates blind into a bluff of sand. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="229">
      <SceneProperties Length="1/8" Page="86" Title=""/>
      <Text>EXT. RACEWAY -- ON THE DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Stalling out, coughing dust.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="230">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>INT. DODGE </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned sticks his head up. Dusts some glass from his shoulder as he scans for Ray. He yanks Lory by the hair and holds her</Text>
      <Text RevisionID="3"> head</Text>
      <Text> up</Text>
      <Text RevisionID="3"> against the rest</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Them's his last two shots. He just blew his whole load. </Text>
      <Text RevisionID="5">Now I finish it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="231">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>EXT. RACEWAY</Text>
      <Text RevisionID="2"> </Text>
      <Text>-- ON THE DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge reverses, doing a U-turn...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="232">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>INT. DODGE -- THRU WINDSHIELD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Headlights scan the darkness, finding RAY</Text>
      <Text RevisionID="7"> at the Mustang</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="233">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>EXT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Attaching the cables </Text>
      <Text RevisionID="3">for the acid battery.</Text>
      <Text RevisionID="5"> Closing hood.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="234">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned speeds towards Ray</Text>
      <Text RevisionID="5">. 
Lory saws the zip-tie... breaking open.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="235">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray</Text>
      <Text RevisionID="5"> </Text>
      <Text RevisionID="3">rips out </Text>
      <Text>the </Text>
      <Text RevisionID="3">ignition </Text>
      <Text>cables. Difficult to </Text>
      <Text RevisionID="3">fuse </Text>
      <Text>in the dark. Headlights from the Dodge </Text>
      <Text RevisionID="3">fill the compartment.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="237">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">Mustang is right in</Text>
      <Text RevisionID="3"> Ned's sights</Text>
      <Text>. </Text>
      <Text RevisionID="3">He ramps</Text>
      <Text> up a gear</Text>
      <Text RevisionID="3">. </Text>
      <Text RevisionID="5">
</Text>
      <Text RevisionID="3" Style="Underline">Lory's fist tightens on the knife</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="238">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The </Text>
      <Text RevisionID="3">ignition </Text>
      <Text>wires spark and Ray gets the engine </Text>
      <Text RevisionID="2">going</Text>
      <Text>.</Text>
      <Text RevisionID="2"> He changes gear to reverse and floors</Text>
      <Text> the accelerator....</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="239">
      <SceneProperties Length="1/8" Page="87" Title=""/>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Mustang reverses in a cloud of dust. Gaining momentum. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge </Text>
      <Text RevisionID="5">CONNECTS... but with low </Text>
      <Text>relative impact speed</Text>
      <Text RevisionID="5"> as the Mustang is reversing.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="240">
      <SceneProperties Length="1/8" Page="88" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray swinging the wheel, breaking from the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="242">
      <SceneProperties Length="2/8" Page="88" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned turns too late and overshoots the Mustang, driving into space. Ned grunts and tries to whip the wheel around when-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>LORY STABS HIM IN THE ARM.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Chaos in the </Text>
      <Text RevisionID="2">Dodge</Text>
      <Text> as Ned swings the wheel and Lory keeps stabbing. Arcing motions like her daddy taught her. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="243">
      <SceneProperties Length="1/8" Page="88" Title=""/>
      <Text>INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="3">drives towards the Dodge, seeing the fight inside.</Text>
      <Text> </Text>
      <Text RevisionID="3">The passenger door opens and -</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="244">
      <SceneProperties Length="1/8" Page="88" Title=""/>
      <Text>EXT. RACEWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory </Text>
      <Text RevisionID="3">tumbles out and </Text>
      <Text>roll</Text>
      <Text RevisionID="3">s in the dirt.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="245">
      <SceneProperties Length="1/8" Page="88" Title=""/>
      <Text>INT. DODGE -- ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Pulling door shut and steadying the wheel. He squeezes his gory arm, blood flowing down his skin.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="246">
      <SceneProperties Length="4/8" Page="88" Title=""/>
      <Text>EXT. RACETRACK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray </Text>
      <Text RevisionID="3">stops</Text>
      <Text> </Text>
      <Text RevisionID="3">beside Lory</Text>
      <Text RevisionID="4"> and opens the door. She seems OK.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="1">Tell Mateo to g</Text>
      <Text>et the yard ready.</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="4">Indicate you heard me-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="1">LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">Get Mateo to get the yard read</Text>
      <Text RevisionID="7">y</Text>
      <Text RevisionID="4">...</Text>
      <Text RevisionID="1"> Dad?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He </Text>
      <Text RevisionID="5">is closing the door </Text>
      <Text>but waits for what she has to say.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LORY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="4">L</Text>
      <Text>ove you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Love you too.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray floors the pedal, gunning for the Dodge's trail. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory watches his tail lights </Text>
      <Text RevisionID="3">dim</Text>
      <Text>. The sound of the distant engines</Text>
      <Text RevisionID="1"> </Text>
      <Text RevisionID="3">fade</Text>
      <Text RevisionID="1">. She takes out her phone and-</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text RevisionID="1">SMASH CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="247">
      <SceneProperties Length="1/8" Page="89" Title=""/>
      <Text RevisionID="1">EXT. RACEWAY -- SLIPWAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">The Mustang accelerates up the slipway exit. 
It takes a corner, clipping the sidewalk.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="248">
      <SceneProperties Length="1/8" Page="89" Title=""/>
      <Text RevisionID="1">INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray straightening her out. Steady, not breaking a sweat. Deadly focus as he sees THE DODGE in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="249">
      <SceneProperties Length="1/8" Page="89" Title=""/>
      <Text RevisionID="1">INT. DODGE -- ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Headlights </Text>
      <Text RevisionID="2">bounce off</Text>
      <Text RevisionID="1"> the rearview </Text>
      <Text RevisionID="2">into </Text>
      <Text RevisionID="1">Ned's eyes. 
Ray rapidly gaining on him.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Up ahead </Text>
      <Text RevisionID="3">Ned</Text>
      <Text RevisionID="1"> sees a FLOOD CHANNEL ACCESS ROAD.</Text>
      <Text RevisionID="3">
He accelerates towards it, turning blinding white.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="250">
      <SceneProperties Length="1/8" Page="89" Title=""/>
      <Text RevisionID="1">EXT. </Text>
      <Text RevisionID="3">ACCESS ROAD</Text>
      <Text RevisionID="1"> GATE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">The Dodge SMASHES</Text>
      <Text RevisionID="1"> through the gate.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="251">
      <SceneProperties Length="1/8" Page="89" Title=""/>
      <Text RevisionID="1">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">The Dodge jumps across the dusty access road. Back wheels hit side fencing, braking at the edge</Text>
      <Text RevisionID="3"> of a </Text>
      <Text RevisionID="5">flood channel.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="252">
      <SceneProperties Length="1/8" Page="89" Title=""/>
      <Text RevisionID="1">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ned glances right at the perilous drop. Glad he didn't overshoot.</Text>
      <Text RevisionID="3"> His eyes</Text>
      <Text RevisionID="1"> are lit by the rearview mirror - headlights</Text>
      <Text RevisionID="3"> from the Mustang</Text>
      <Text RevisionID="1">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="253">
      <SceneProperties Length="1/8" Page="89" Title=""/>
      <Text RevisionID="1">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray accelerat</Text>
      <Text RevisionID="3">es</Text>
      <Text RevisionID="1"> to ramming speed.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="254">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Mustang smashing into the Dodge.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="255">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ned </Text>
      <Text RevisionID="3">is </Text>
      <Text RevisionID="1">ram</Text>
      <Text RevisionID="3">med</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="1">against the fencing</Text>
      <Text RevisionID="3">. </Text>
      <Text RevisionID="2">Accelerat</Text>
      <Text RevisionID="5">ing</Text>
      <Text RevisionID="2"> forward.</Text>
      <Text RevisionID="1"> </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="256">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Mustang gain</Text>
      <Text RevisionID="2">s</Text>
      <Text RevisionID="1"> on the Dodge.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="1">Up ahead the road bisects - one going uphill, the other downhill along</Text>
      <Text RevisionID="3"> the </Text>
      <Text RevisionID="1">floo</Text>
      <Text RevisionID="2">d</Text>
      <Text RevisionID="1"> channel. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="257">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">INT. DODGE -</Text>
      <Text RevisionID="3">-</Text>
      <Text RevisionID="1"> ON NED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">lifting </Text>
      <Text RevisionID="5">Carris's</Text>
      <Text RevisionID="3"> Beretta and aiming.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="258">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">INT. MUSTANG</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ray coming up alongside Ned, hunkered </Text>
      <Text RevisionID="2">low </Text>
      <Text RevisionID="1">in </Text>
      <Text RevisionID="2">his</Text>
      <Text RevisionID="1"> cab, like a </Text>
      <Text RevisionID="4">Comanche</Text>
      <Text RevisionID="1"> slinging low on a horse.</Text>
      <Text RevisionID="2"> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">A FLASH OF GUNFIRE breaks out from the Dodge. Ray's Front windshield SPIDERS as a full auto clip is emptied.</Text>
      <Text RevisionID="2"> </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="259">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Ned s</Text>
      <Text RevisionID="1">wings wheel left and RAMS the Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="7">INT. MUSTANG -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">Trying to keep control... a FENCE bisecting roads.
Ray yanks the wheel left...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="260">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">The </Text>
      <Text RevisionID="1">Mustang</Text>
      <Text RevisionID="7"> turns into the</Text>
      <Text RevisionID="1"> uphill path.
Dodge continues downhill alongside the flood channel.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="261">
      <SceneProperties Length="1/8" Page="90" Title=""/>
      <Text RevisionID="1">INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="1">Ned </Text>
      <Text RevisionID="3">c</Text>
      <Text RevisionID="1">heck</Text>
      <Text RevisionID="2">s</Text>
      <Text RevisionID="1"> mirrors.</Text>
      <Text RevisionID="3"> The Mustang is gone.</Text>
      <Text RevisionID="1">
Looks like he's all alone. He cranks handbrake</Text>
      <Text RevisionID="3">, whips wheel.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="304">
      <SceneProperties Length="1/8" Page="91" Title=""/>
      <Text>EXT. ACCESS ROAD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge does a roundhouse sweep, facing where it came from. The engine</Text>
      <Text RevisionID="1"> dies, leaving stillness and the dark.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="305">
      <SceneProperties Length="4/8" Page="91" Title=""/>
      <Text>INT. DODGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned takes his hands off the keys. He winds down the windows. The ambient sound of distant Los Angeles comes through. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>His eyes peer into the darkness of the dirt road ahead of him. This is where he expects Ray. Head-on.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>To his left flank is the flood channel, a vertiginous drop partitioned off by chain-link fence. To his right flank is a steep hill leading to the road above.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned checks the clips. All empty. He tosses the gun aside.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned waits. Seeps in the sounds of the night-time.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text Style="Underline">His phone rings</Text>
      <Text>. It echoes into the darkness. He quickly answers the call to stop the ring</Text>
      <Text RevisionID="3">ing</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">A song comes through faintly... </Text>
      <Text RevisionID="7">the same one that has played throughout... a</Text>
      <Text RevisionID="5">s if filtered through a car radio. A silent occupant on the other end.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">That you</Text>
      <Text> Ray?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="3">Silence from the caller.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="306">
      <SceneProperties Length="1/8" Page="91" Title=""/>
      <Text>EXT. WRECK</Text>
      <Text RevisionID="2">ING</Text>
      <Text> YARD -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A cube of scrap metal at the center of a compressor.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The compactor walls expand, and the WHITE MUSTANG begins to unfold like a metallic hypercube.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="307">
      <SceneProperties Length="1/8" Page="91" Title=""/>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what you say we call it quits Ray? We cash-in and go our separate ways.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="308">
      <SceneProperties Length="2/8" Page="91" Title=""/>
      <Text>EXT. WRECK</Text>
      <Text RevisionID="2">ING</Text>
      <Text> YARD -- REVERSED </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lory -- bruised, and MATEO (20, good-looking) -- unlock from an embrace. Ray watching them. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He returns his gaze to the expanding compressor. The Mustang expands and blood rushes inside the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Way I see it, we're in the clear. Clyde's been memory-holed. Cop didn't leave no notebook, and well - she ain't talking no more. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="308A">
      <SceneProperties Length="1/8" Page="92" Title=""/>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Even if you get the inch on me, I got Lory's blood on me, the cop's blood, Clyde's blood.</Text>
      <Text RevisionID="2">...</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="309">
      <SceneProperties Length="2/8" Page="92" Title=""/>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Dodge </Text>
      <Text RevisionID="3">is upside down and </Text>
      <Text>burning on the flood channel floor. Lit by tail-lights of the reversing Mustang.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="2" Style="Italic">...t</Text>
      <Text Style="Italic">he whole story is gonna be there to unpick, one DNA swab at a time for a County Coroner. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="311">
      <SceneProperties Length="1/8" Page="92" Title=""/>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The burning Dodge. Ray holds out a jerry can, which catches gasoline as it arcs </Text>
      <Text RevisionID="3">away </Text>
      <Text>from the flames.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="312">
      <SceneProperties Length="1/8" Page="92" Title=""/>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Mustang's trunk is opened by Ray. He rolls out Ned's bloodied body and closes the trunk.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="313">
      <SceneProperties Length="1/8" Page="92" Title=""/>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Maybe the </Text>
      <Text Style="Underline">wrong</Text>
      <Text> story, Ray.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="314">
      <SceneProperties Length="1/8" Page="92" Title=""/>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned's mangled </Text>
      <Text RevisionID="1">body </Text>
      <Text RevisionID="2">lies</Text>
      <Text RevisionID="1"> in the Dodge. Lit by headlights.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">Now, if I had the chance to drive away from here, get a hot shower...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="315">
      <SceneProperties Length="1/8" Page="93" Title=""/>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...fresh set of clothes. It's all over. Done. Else you taking a risk.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned waits for a response to his gambit. Finally...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text Style="Italic">No... that ain't the risk.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="316">
      <SceneProperties Length="2/8" Page="93" Title=""/>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray sits in darkness. Engine and lights off. The hunter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="3">Risk is letting you keep breathing.</Text>
      <Text RevisionID="5"> </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">The way I see it, long as I get you into the trunk of the Mustang, and the Mustang to the wrecker's yard</Text>
      <Text RevisionID="5">...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="317">
      <SceneProperties Length="1/8" Page="93" Title=""/>
      <Text>EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The upside down Dodge stirs, </Text>
      <Text RevisionID="3">and begins to rock. G</Text>
      <Text>lass re-assembling, roof </Text>
      <Text RevisionID="4">un-crumpling</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RAY (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Italic">...then t</Text>
      <Text RevisionID="5" Style="Italic">his whole thing is gonna be like a bad dream that never happened.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="318">
      <SceneProperties Length="1/8" Page="93" Title=""/>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned listening... sweating.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5" Style="Italic">You were right, Ned. Once we collided, only one of us was gonna be around after...</Text>
      <Text Style="Italic"> </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="321">
      <SceneProperties Length="1/8" Page="93" Title=""/>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray is resolved. Zen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text RevisionID="5">RAY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text RevisionID="5">... and that's gonna be me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">He lets down his handbrake.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text RevisionID="7">EXT. FLOOD CHANNEL -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">The Dodge rises into the air, rotating sideways towards the torn chain-link fence on the access road.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="322">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned hears a trundling sound on the phone call. A rumble. Another sound to his right through the window. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">A shadowy hulk</Text>
      <Text> </Text>
      <Text RevisionID="3">rolls</Text>
      <Text> downhill towards him</Text>
      <Text RevisionID="5">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="323">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text>INT. MUSTANG -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray turns on his engine and headlights.</Text>
      <Text RevisionID="2"> </Text>
      <Text RevisionID="2" Style="Underline">Accelerates</Text>
      <Text RevisionID="2">.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="324">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text>INT. DODGE -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ned flood-lit by </Text>
      <Text RevisionID="5">headlights</Text>
      <Text>. Too late to start the engine.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NED</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Always said you was a killer Ray...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text RevisionID="7">EXT. ACCESS ROAD -- REVERSED</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">The chain-link fence wraps itself around the sideways Dodge, skidding sideways onto the access road...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="325">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text>EXT. ACCESS ROAD -- PRESENT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The Mustang </Text>
      <Text RevisionID="7">SLAMS</Text>
      <Text> SIDEWAYS </Text>
      <Text RevisionID="2">into</Text>
      <Text> the Dodge and</Text>
      <Text RevisionID="3">-</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>SMASH CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="326">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text>EXT. RACE TRACK -- DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>RAY'S WHITE INDYCAR barrels past a competitor at </Text>
      <Text RevisionID="3">20</Text>
      <Text>0mph.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="327">
      <SceneProperties Length="1/8" Page="94" Title=""/>
      <Text>INT. COCKPIT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray behind visor in the driver's seat.
White gloves gripping the steering wheel. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="328">
      <SceneProperties Length="1/8" Page="95" Title=""/>
      <Text>EXT. GRANDSTAND</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>An ANNOUNCER go</Text>
      <Text RevisionID="7">es</Text>
      <Text> wild over the </Text>
      <Text RevisionID="7">PA system</Text>
      <Text>. LORY jumps to her feet at the grandstand. Ray staging an incredible comeback.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="329">
      <SceneProperties Length="1/8" Page="95" Title=""/>
      <Text>EXT. RACE TRACK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray moving up to top gear, flooring the pedal. 
Rearview; a </Text>
      <Text Style="Underline">BLACK INDYCAR</Text>
      <Text> coming fast. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="330">
      <SceneProperties Length="1/8" Page="95" Title=""/>
      <Text>EXT. GRANDSTAND -- ON CROWD</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Spectators going wild -- the final straight.
Tight on Lory, screaming - he's GONNA WIN.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="331">
      <SceneProperties Length="3/8" Page="95" Title=""/>
      <Text>INT. COCKPIT -- ON RAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Staring at the </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="5">REARVIEW: </Text>
      <Text>Black Indycar accelerat</Text>
      <Text RevisionID="5">ing</Text>
      <Text> </Text>
      <Text RevisionID="5">past</Text>
      <Text> him. </Text>
      <Text RevisionID="5">
</Text>
      <Text>RADIO CONTROLLERS barking frantic orders.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Ray's Indy</Text>
      <Text RevisionID="3">c</Text>
      <Text>ar and Black Indycar </Text>
      <Text Style="Underline">about to touch</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>
CUT TO BLACK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="7">THE SONG</Text>
      <Text RevisionID="5"> reprises... and the credits roll.
</Text>
    </Paragraph>
    <Paragraph Type="Action"/>
    <Paragraph Type="General" Alignment="Center">
      <Text Style="Bold+Underline">THE END</Text>
    </Paragraph>
  </Content>
